\ ──────────────────────────────────────────────────────────────────────────────
\ src/node_disk.fam — virtio-blk read/write path, poll-based (no interrupts).
\
\ The node has no zicsr, so there are no interrupts: every device is driven by
\ polling.  This module replaces the old blocking `dw_one` (submit + spin-wait)
\ with a non-blocking submit (`dsk_sub`) and a single idempotent step (`dsk_poll`)
\ that the caller invokes repeatedly -- standalone in a tight loop for now, and
\ later once per pass of the unified serve/event loop so disk writes overlap with
\ serving.  `dsk_rd` is the read counterpart: a synchronous single-sector read
\ (page-ins block the operation that needs the data); an async read mirroring
\ dsk_sub/dsk_poll can come later when the unified loop wants overlapped reads.
\
\ Disk-write state block `dst` (caller-allocated):
\   dst+0x00 dev        virtio-blk MMIO base
\   dst+0x04 qb         queue base (page-aligned, >= 0x5000 bytes, zeroed)
\   dst+0x08 remaining  bytes left to write (multiple of 512)
\   dst+0x0C sector     next disk sector
\   dst+0x10 src        next source byte (DMA'd to disk)
\   dst+0x14 aidx       completed-request count (== avail/used idx when idle)
\   dst+0x18 inflight   1 while a request is posted but not yet completed
\ Queue layout in qb: desc@+0, avail@+0x100, used@+0x1000, req hdr@+0x2000, status@+0x2010.
\ ──────────────────────────────────────────────────────────────────────────────

:M fence_io 0F00500F , ;           \ fence iorw,ow   (MMIO ordering before QueueNotify)
:M fence_r  0F002002 , ;           \ fence r,r       (read ordering after device DMA)

\ ── Find virtio-blk device (device_id = 2): ( -- mmio_base ) ──
: find_blk
10008000 lit
begin dup 8 lit + @ 2 lit <> while
1000 lit -
dup 10001000 lit u< if "no blk\n" puts bye then
repeat
;

\ ── Virtio-blk handshake + queue config: ( dst -- dst )  (dst[0]=dev, dst[4]=qb) ──
\ Negotiates VIRTIO_BLK_F_FLUSH (feature bit 9 = 0x200) IF the device offers it:
\ that selects writeback caching, where writes complete into a volatile cache and
\ `dsk_flsh` is needed to make them durable.  If the device doesn't offer it we
\ negotiate nothing and run writethrough (every write durable on completion).
: vblkinit
dup @ dup 70 lit + 0 lit swap !
dup 70 lit + 1 lit swap !
dup dup 70 lit + @ 2 lit or swap 70 lit + !
dup 10 lit + @ 200 lit and over 20 lit + !   \ DriverFeatures = offered & FLUSH(bit 9)
dup dup 70 lit + @ 8 lit or swap 70 lit + !
dup 28 lit + 1000 lit swap !
dup 30 lit + 0 lit swap !
dup 3C lit + 1000 lit swap !
dup 38 lit + 10 lit swap !
drop
dup 4 lit + @ C lit rshift
over @ 40 lit + !
dup @ dup 70 lit + @ 4 lit or swap 70 lit + !
;

\ ── Zero 16 KiB (4096 words) at qb: ( qb -- ) ──
: qzero
1000 lit
begin
dup 0 lit > while
swap
dup 0 lit swap !
4 lit +
swap 1 lit -
repeat
drop drop
;

\ ── dsk_sub ( dst -- dst )  post a 1-sector write and kick; returns immediately ──
: dsk_sub
dup 4 lit + @                  \ ( dst qb )
\ req header: type=1(write), reserved=0, sector from dst[0x0C]
dup 2000 lit + 1 lit swap !
dup 2004 lit + 0 lit swap !
over C lit + @ over 2008 lit + !
dup 200C lit + 0 lit swap !
\ status byte = FF (pending; device clears it on completion)
dup 2010 lit + FF lit swap c!
\ desc[0]: req header (16B, device reads)
dup dup 2000 lit + swap !
dup 4 lit + 0 lit swap !
dup 8 lit + 10 lit swap !
dup C lit + 1 lit swap h!
dup E lit + 1 lit swap h!
\ desc[1]: data buffer (512B from dst[0x10], device reads)
over 10 lit + @ over 10 lit + !
dup 14 lit + 0 lit swap !
dup 18 lit + 200 lit swap !
dup 1C lit + 1 lit swap h!
dup 1E lit + 2 lit swap h!
\ desc[2]: status byte (1B, device writes)
dup dup 2010 lit + swap 20 lit + !
dup 24 lit + 0 lit swap !
dup 28 lit + 1 lit swap !
dup 2C lit + 2 lit swap h!
dup 2E lit + 0 lit swap h!
\ avail ring: flags=0, idx=aidx+1, ring[0]=0
dup 100 lit + 0 lit swap h!
over 14 lit + @ 1 lit + over 102 lit + h!
dup 104 lit + 0 lit swap h!
drop                           \ ( dst )
fence_io
dup @ 50 lit + 0 lit swap !    \ QueueNotify queue 0
1 lit over 18 lit + !          \ inflight = 1
;

\ ── dsk_poll ( dst -- dst )  one non-blocking step of the background write ──
\ Idempotent: a no-op once the write is done (remaining == 0, nothing in flight).
\ In flight  -> check the used-ring; on completion advance the state machine.
\ Idle + work -> submit the next sector.
: dsk_poll
dup 18 lit + @ if              \ in flight?
  fence_r
  dup 4 lit + @ 1000 lit + 2 lit + h@   \ used.idx  (qb+0x1002)
  over 14 lit + @ 1 lit + FFFF lit and  \ (aidx+1) & 0xFFFF  = expected on completion
  = if                                  \ completed?
    dup dup 10 lit + @ 200 lit + swap 10 lit + !   \ src += 512
    dup dup C lit + @ 1 lit + swap C lit + !        \ sector += 1
    dup dup 8 lit + @ 200 lit - swap 8 lit + !      \ remaining -= 512
    dup dup 14 lit + @ 1 lit + swap 14 lit + !      \ aidx += 1
    0 lit over 18 lit + !                           \ inflight = 0
  then
else
  dup 8 lit + @ 0 lit > if     \ remaining > 0 ?
    dsk_sub
  then
then
;

\ ── dsk_rd ( dst -- dst )  read one sector (dst[0x0C]) into buf (dst[0x10]); blocks ──
\ Synchronous read on queue 0: build the request, kick, then spin-wait for the
\ device to complete it (a page-in blocks whatever needs the data).  Reuses the
\ same sector (0x0C) and src/buf (0x10) and aidx (0x14) fields as dsk_sub, so reads
\ and writes share one dst + queue and stay in sync on the avail/used index.  The
\ ONLY differences from a write submit: header type = 0 (read), and desc[1] is
\ device-WRITES (flags NEXT|WRITE) so the sector's bytes land in buf.
: dsk_rd
dup 4 lit + @                  \ ( dst qb )
\ req header: type=0(read), reserved=0, sector from dst[0x0C]
dup 2000 lit + 0 lit swap !
dup 2004 lit + 0 lit swap !
over C lit + @ over 2008 lit + !
dup 200C lit + 0 lit swap !
\ status byte = FF (device clears it on completion)
dup 2010 lit + FF lit swap c!
\ desc[0]: req header (16B, device reads)
dup dup 2000 lit + swap !
dup 4 lit + 0 lit swap !
dup 8 lit + 10 lit swap !
dup C lit + 1 lit swap h!
dup E lit + 1 lit swap h!
\ desc[1]: data buffer (512B into dst[0x10], device WRITES)
over 10 lit + @ over 10 lit + !
dup 14 lit + 0 lit swap !
dup 18 lit + 200 lit swap !
dup 1C lit + 3 lit swap h!     \ flags = NEXT | WRITE  (device writes the data in)
dup 1E lit + 2 lit swap h!
\ desc[2]: status byte (1B, device writes)
dup dup 2010 lit + swap 20 lit + !
dup 24 lit + 0 lit swap !
dup 28 lit + 1 lit swap !
dup 2C lit + 2 lit swap h!
dup 2E lit + 0 lit swap h!
\ avail ring: flags=0, idx=aidx+1, ring[0]=0
dup 100 lit + 0 lit swap h!
over 14 lit + @ 1 lit + over 102 lit + h!
dup 104 lit + 0 lit swap h!
drop                           \ ( dst )
fence_io
dup @ 50 lit + 0 lit swap !    \ QueueNotify queue 0
\ spin-wait: used.idx == (aidx+1) & 0xFFFF
begin
  fence_r
  dup 4 lit + @ 1000 lit + 2 lit + h@   \ used.idx (qb+0x1002)
  over 14 lit + @ 1 lit + FFFF lit and  \ expected (aidx+1)
  =
until
fence_r                        \ order the device's DMA before the caller reads buf
dup dup 14 lit + @ 1 lit + swap 14 lit + !   \ aidx += 1
;

\ ── dsk_flsh ( dst -- dst )  make all completed writes durable (virtio FLUSH) ──
\ The virtio-blk equivalent of fsync: a whole-device barrier (no data buffer, the
\ sector field is ignored) that forces every acknowledged write out to the backing
\ store.  No-op in writethrough mode (writes are already durable), so we only issue
\ it when the device offered FLUSH -- which is exactly when vblkinit negotiated
\ writeback and writes are NOT yet durable.  Synchronous, like dsk_rd.
: dsk_flsh
dup @ 10 lit + @ 200 lit and if   \ device offers VIRTIO_BLK_F_FLUSH? (writeback)
  dup 4 lit + @                 \ ( dst qb )
  \ req header: type=4 (flush), reserved=0, sector ignored (0)
  dup 2000 lit + 4 lit swap !
  dup 2004 lit + 0 lit swap !
  dup 2008 lit + 0 lit swap !
  dup 200C lit + 0 lit swap !
  \ status byte = FF (device clears it on completion)
  dup 2010 lit + FF lit swap c!
  \ desc[0]: req header (16B, device reads), chains to the status descriptor
  dup dup 2000 lit + swap !
  dup 4 lit + 0 lit swap !
  dup 8 lit + 10 lit swap !
  dup C lit + 1 lit swap h!     \ flags = NEXT
  dup E lit + 1 lit swap h!     \ next = 1
  \ desc[1]: status byte (1B, device writes); no data buffer for a flush
  dup dup 2010 lit + swap 10 lit + !
  dup 14 lit + 0 lit swap !
  dup 18 lit + 1 lit swap !
  dup 1C lit + 2 lit swap h!    \ flags = WRITE
  dup 1E lit + 0 lit swap h!    \ next = 0 (end of chain)
  \ avail ring: flags=0, idx=aidx+1, ring[0]=0
  dup 100 lit + 0 lit swap h!
  over 14 lit + @ 1 lit + over 102 lit + h!
  dup 104 lit + 0 lit swap h!
  drop                          \ ( dst )
  fence_io
  dup @ 50 lit + 0 lit swap !   \ QueueNotify queue 0
  begin
    fence_r
    dup 4 lit + @ 1000 lit + 2 lit + h@
    over 14 lit + @ 1 lit + FFFF lit and
    =
  until
  dup dup 14 lit + @ 1 lit + swap 14 lit + !   \ aidx += 1
then
;

\ ──────────────────────────────────────────────────────────────────────────────
\ Tests (run only under `./tools/fam --test src/node_disk.fam`; the default build
\ skips the whole Test block, so nothing here ships in the sealed binary).
\
\ There is no real virtio-blk device in the test, so we exercise the *logic* on a
\ fake state block: a heap-allocated `dst`, a fake `qb` (just memory we read/write
\ as if it were the queue), and a fake `dev` (writable scratch absorbing the
\ QueueNotify).  qzero / dsk_sub / dsk_poll all reduce to memory manipulation, so
\ we drive each state-machine edge by hand-setting the used-ring index and asserting
\ the resulting `dst` / `qb` state.
\ ──────────────────────────────────────────────────────────────────────────────
Test {
\ qzero clears the full 16 KiB (4096 words) and nothing past byte 0.
qzero16k {
5000 lit alloc                       \ ( qb )
DEADBEEF lit over !                  \ poison qb[0]
DEADBEEF lit over 3FFC lit + !       \ poison the last word qzero should touch
dup qzero
dup @ 0 lit asrt_eq                  \ first word cleared
3FFC lit + @ 0 lit asrt_eq           \ last word cleared  ( consumes qb )
}
\ dsk_sub builds the write request: header (type=write, sector), status=FF, the
\ data descriptor (src addr + 512 len), the avail index, and marks inflight.
sub_desc {
1C lit alloc                         \ ( dst )
5000 lit alloc over 4 lit + !        \ dst[4]  = qb
100 lit alloc over !                 \ dst[0]  = dev (scratch for QueueNotify)
7 lit over C lit + !                 \ dst[C]  = sector 7
40000000 lit over 10 lit + !         \ dst[10] = src
2 lit over 14 lit + !                \ dst[14] = aidx 2
0 lit over 18 lit + !                \ dst[18] = inflight 0
dsk_sub
dup 4 lit + @ 2000 lit + @ 1 lit asrt_eq        \ req type = write(1)
dup 4 lit + @ 2008 lit + @ 7 lit asrt_eq        \ req sector = 7
dup 4 lit + @ 2010 lit + c@ FF lit asrt_eq      \ status byte armed = FF
dup 4 lit + @ 10 lit + @ 40000000 lit asrt_eq   \ desc[1].addr = src
dup 4 lit + @ 18 lit + @ 200 lit asrt_eq        \ desc[1].len  = 512
dup 4 lit + @ 102 lit + h@ 3 lit asrt_eq        \ avail.idx = aidx+1 = 3
18 lit + @ 1 lit asrt_eq                         \ inflight set  ( consumes dst )
}
\ dsk_poll, request completed (used.idx == aidx+1): advance the state machine.
poll_adv {
1C lit alloc
5000 lit alloc over 4 lit + !
1000 lit over 8 lit + !              \ remaining 0x1000
5 lit over C lit + !                 \ sector 5
40000000 lit over 10 lit + !         \ src
3 lit over 14 lit + !                \ aidx 3
1 lit over 18 lit + !                \ inflight 1
4 lit over 4 lit + @ 1002 lit + h!   \ used.idx = aidx+1 = 4  -> completed
dsk_poll
dup 8 lit + @ E00 lit asrt_eq        \ remaining -= 512
dup C lit + @ 6 lit asrt_eq          \ sector += 1
dup 10 lit + @ 40000200 lit asrt_eq  \ src += 512
dup 14 lit + @ 4 lit asrt_eq         \ aidx += 1
18 lit + @ 0 lit asrt_eq             \ inflight cleared  ( consumes dst )
}
\ dsk_poll, request NOT yet completed (used.idx != aidx+1): leave state untouched.
poll_wait {
1C lit alloc
5000 lit alloc over 4 lit + !
1000 lit over 8 lit + !              \ remaining 0x1000
3 lit over 14 lit + !                \ aidx 3
1 lit over 18 lit + !                \ inflight 1
3 lit over 4 lit + @ 1002 lit + h!   \ used.idx = 3  != aidx+1 = 4  -> still pending
dsk_poll
dup 8 lit + @ 1000 lit asrt_eq       \ remaining unchanged
18 lit + @ 1 lit asrt_eq             \ still in flight  ( consumes dst )
}
\ dsk_poll, idle with no work (remaining 0): a no-op -- must NOT spuriously submit.
poll_done {
1C lit alloc
0 lit over 8 lit + !                 \ remaining 0
0 lit over 18 lit + !                \ inflight 0
dsk_poll
18 lit + @ 0 lit asrt_eq             \ stays idle (no submit)  ( consumes dst )
}
\ dsk_poll, idle with work pending (remaining > 0): submits the next sector.
poll_emit {
1C lit alloc
5000 lit alloc over 4 lit + !
100 lit alloc over !
1000 lit over 8 lit + !              \ remaining 0x1000
9 lit over C lit + !                 \ sector 9
40000000 lit over 10 lit + !         \ src
0 lit over 14 lit + !                \ aidx 0
0 lit over 18 lit + !                \ inflight 0
dsk_poll
dup 18 lit + @ 1 lit asrt_eq         \ now in flight
dup 4 lit + @ 2008 lit + @ 9 lit asrt_eq   \ submitted our sector (9)
4 lit + @ 102 lit + h@ 1 lit asrt_eq        \ avail.idx = aidx+1 = 1  ( consumes dst )
}
\ dsk_rd builds a READ request (header type 0, desc[1] device-WRITES) and, with the
\ used ring pre-marked complete, finishes its spin-wait and advances aidx.  (We
\ pre-set used.idx = aidx+1 so the synchronous wait returns instead of hanging --
\ there's no real device in this suite.  The full read path is covered against a
\ real device by the round-trip test in tests/node_disk_dev.fam.)
rd_desc {
1C lit alloc                         \ ( dst )
5000 lit alloc over 4 lit + !        \ dst[4]  = qb
100 lit alloc over !                 \ dst[0]  = dev (scratch for QueueNotify)
40000000 lit over 10 lit + !         \ dst[10] = buf (just an address; not read here)
B lit over C lit + !                 \ dst[C]  = sector 11
0 lit over 14 lit + !                \ dst[14] = aidx 0
1 lit over 4 lit + @ 1002 lit + h!   \ used.idx = aidx+1 = 1  -> wait completes at once
dsk_rd
dup 4 lit + @ 2000 lit + @ 0 lit asrt_eq        \ req type = read(0)
dup 4 lit + @ 2008 lit + @ B lit asrt_eq        \ req sector = 11
dup 4 lit + @ 10 lit + @ 40000000 lit asrt_eq   \ desc[1].addr = buf
dup 4 lit + @ 1C lit + h@ 3 lit asrt_eq         \ desc[1].flags = NEXT|WRITE (device writes)
14 lit + @ 1 lit asrt_eq                          \ aidx advanced to 1  ( consumes dst )
}
\ dsk_flsh, writeback mode (device offers FLUSH): builds a no-data flush request
\ (header type 4 -> status, a 2-descriptor chain) and advances aidx.  We fake the
\ device offering FLUSH by setting its DeviceFeatures word, and pre-mark the used
\ ring so the synchronous wait returns.
flush_rq {
1C lit alloc                         \ ( dst )
5000 lit alloc over 4 lit + !        \ dst[4] = qb
100 lit alloc over !                 \ dst[0] = dev (scratch)
200 lit over @ 10 lit + !            \ dev DeviceFeatures = FLUSH offered (writeback)
0 lit over 14 lit + !                \ aidx 0
1 lit over 4 lit + @ 1002 lit + h!   \ used.idx = 1 -> wait completes at once
dsk_flsh
dup 4 lit + @ 2000 lit + @ 4 lit asrt_eq        \ req type = flush(4)
dup 4 lit + @ 8 lit + @ 10 lit asrt_eq          \ desc[0].len  = 16 (header)
dup 4 lit + @ E lit + h@ 1 lit asrt_eq          \ desc[0].next = 1 -> status
dup 4 lit + @ 18 lit + @ 1 lit asrt_eq          \ desc[1].len   = 1 (status byte)
dup 4 lit + @ 1C lit + h@ 2 lit asrt_eq         \ desc[1].flags = WRITE (no NEXT)
14 lit + @ 1 lit asrt_eq                          \ aidx advanced  ( consumes dst )
}
\ dsk_flsh, writethrough mode (device does NOT offer FLUSH): a no-op -- writes are
\ already durable, so it must issue nothing and leave aidx untouched.
flush_skip {
1C lit alloc                         \ ( dst )
100 lit alloc over !                 \ dst[0] = dev
0 lit over @ 10 lit + !              \ dev DeviceFeatures = 0 (no FLUSH -> writethrough)
5 lit over 14 lit + !                \ aidx 5
dsk_flsh
14 lit + @ 5 lit asrt_eq             \ aidx unchanged: flush issued nothing  ( consumes dst )
}

}
