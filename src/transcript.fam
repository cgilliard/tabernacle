\ ──────────────────────────────────────────────────────────────────────────────
\ src/transcript.fam — FRI transcript / Fiat-Shamir: incremental duplex sponge
\ over Poseidon2-BabyBear-16 (Stage 3 of the FRI verifier). SAME convention as
\ p2hash (additive absorb, rate-8, squeeze s[0..8]); reuses permh + zero16 from
\ poseidon2.fam (compile AFTER it). Context layout matches p2hash's so permh works
\ directly: ctx +00 squeeze-idx | +14 s[16] (state) | +54 w[16] (perm scratch).
\ ctx >= 0x94 B. DEFINED here (no prover yet); a prover matches this channel.
\   tr_init  ( ctx -- )       zero state, idx = 8 (exhausted)
\   tr_abs8  ( ctx d -- )     s[0..8] += d[0..8]; permute; idx = 0   (d = 8-word digest)
\   tr_sqz   ( ctx -- x )     forward squeeze one base word (re-permute when idx hits 8)
\   tr_sqbb4 ( ctx out -- )   squeeze a BB4 challenge (4 words) into out
\   tr_sqidx ( ctx mask -- pos )  squeeze one word, mask to a query position
\ Python ref + vectors: tmp/pos2/trref.py.
\ ──────────────────────────────────────────────────────────────────────────────

: tr_init ( ctx -- )
  dup 14 lit + zero16
  8 lit swap ! ;

: tr_abs8 ( ctx d -- )
  8 lit 0 lit do
    over 14 lit + i 4 lit * +  dup @
    2 lit pick i 4 lit * + @  fadd  swap !
  loop
  drop  permh  0 lit swap ! ;

: tr_sqz ( ctx -- x )
  dup @ 8 lit = 1 lit and if  dup permh drop  0 lit over !  then
  dup @
  over 14 lit + over 4 lit * + @
  swap 1 lit +  2 lit pick !  nip ;

: tr_sqbb4 ( ctx out -- )
  4 lit 0 lit do  over tr_sqz  over i 4 lit * + !  loop  2drop ;

: tr_sqidx ( ctx mask -- pos )
  swap tr_sqz and ;

Test {
tr0 {
  A0 lit alloc dup tr_init
  20 lit alloc  11111111 lit over !  11111112 lit over 4 lit + !  11111113 lit over 8 lit + !  11111114 lit over C lit + !  11111115 lit over 10 lit + !  11111116 lit over 14 lit + !  11111117 lit over 18 lit + !  11111118 lit over 1C lit + !
  1 lit pick 1 lit pick tr_abs8  drop
  10 lit alloc  1 lit pick over tr_sqbb4
  10 lit alloc  614E2225 lit over !  4AE96F19 lit over 4 lit + !  24CC4563 lit over 8 lit + !  0F6FBF35 lit over C lit + !
  1 lit pick over cmp4 1 lit asrt_eq  2drop
  20 lit alloc  22220000 lit over !  22220001 lit over 4 lit + !  22220002 lit over 8 lit + !  22220003 lit over C lit + !  22220004 lit over 10 lit + !  22220005 lit over 14 lit + !  22220006 lit over 18 lit + !  22220007 lit over 1C lit + !
  1 lit pick 1 lit pick tr_abs8  drop
  dup 003FFFFF lit tr_sqidx  0005C40D lit asrt_eq
  dup 003FFFFF lit tr_sqidx  0024E02C lit asrt_eq
  drop
}
}
