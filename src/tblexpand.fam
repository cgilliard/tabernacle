\ ──────────────────────────────────────────────────────────────────────────────
\ src/tblexpand.fam — PoW lookup-table expansion (off-circuit, builds the 16 MiB
\ table from the bible seed). DATA-DEPENDENT (Argon2d-style) single-block BLAKE2s:
\   block[p] = blake2s( table[p-8..p]  ||  table[ref..ref+8] )
\   ref = high32( (p-8) * table[p-8] )   -- a uniform pseudo-random EARLIER word index
\ The random long-range reference makes a missing block require a random tree of
\ earlier blocks to recompute, so a miner can't store a fraction + cheaply recompute
\ (TMTO-resistant); honest gen is still ~1 hash/block (~30 s in QEMU). NOT consensus-
\ trusted — the table is anchored by its committed checksum; blake2s is a fast
\ deterministic expander. Built on src/blake2s.fam + umul64_i (src/babybear.fam).
\   texpand ( table seedw tblw scr -- )   table[0..seedw) preloaded with seed; fills
\     words [seedw..tblw). scr >= 0x100; layout below. Production: seedw=419968,
\     tblw=0x400000 (16 MiB). Refs: tmp/pos2/tblref.py (small) + tmp/pos2/tblgen.py.
\ ──────────────────────────────────────────────────────────────────────────────

: cpw8  ( src dst -- )  8 lit 0 lit do  over i 4 lit * + @  over i 4 lit * + !  loop  2drop ;

: texpand ( table seedw tblw scr -- )
  \ scr layout: 0x00 blake2s v/m | 0x80 asm[16w] | 0xC0 temp[8w]
  \   | 0xE0 op | 0xE4 p | 0xE8 preva | 0xEC J1 | 0xF0 ref | 0xF4 refa | 0xF8 out | 0xFC rem
  2 lit pick over E4 lit + !                                 \ p  = seedw
  3 lit pick 3 lit pick 2 lit lshift +  over E0 lit + !      \ op = table + seedw*4
  begin  dup E4 lit + @  2 lit pick u<  while
    dup E0 lit + @ 20 lit -  over E8 lit + !                 \ preva = op - 0x20
    dup E8 lit + @ @  over EC lit + !                        \ J1 = @preva
    dup E4 lit + @ 8 lit -  over EC lit + @  umul64_i nip  over F0 lit + !  \ ref = hi((p-8)*J1)
    3 lit pick  over F0 lit + @ 2 lit lshift +  over F4 lit + !   \ refa = table + ref*4
    dup E8 lit + @  over 80 lit +  cpw8                      \ asm[0..8]  = prev block
    dup F4 lit + @  over A0 lit +  cpw8                      \ asm[8..16] = ref block
    1 lit pick  over E4 lit + @ -  over FC lit + !           \ rem = tblw - p
    dup FC lit + @ 8 lit u< if  dup C0 lit +  over F8 lit + !
                          else  dup E0 lit + @  over F8 lit + !  then   \ out = temp | op
    dup 80 lit +  40 lit  2 lit pick F8 lit + @  3 lit pick  blake2s     \ block = blake2s(asm)
    dup FC lit + @ 8 lit u< if                               \ partial last block: copy rem words
      dup FC lit + @ 0 lit do
        dup C0 lit + i 4 lit * + @  over E0 lit + @ i 4 lit * + !
      loop
    then
    dup E0 lit + dup @ 20 lit + swap !                       \ op += 0x20
    dup E4 lit + dup @ 8 lit + swap !                        \ p  += 8
  repeat
  2drop 2drop ;

\ tbl_chk ( table tblw scr expect -- flag )  flag = -1 (match) / 0 (mismatch).
\ Full-table integrity check: a fast position-sensitive Fletcher checksum over all
\ tblw words (s1+=w; s2+=s1, wrapping; ck = s1^s2) compared to `expect`. Adds-only ->
\ one cheap pass, OK every boot; catches disk corruption / wrong table. Consensus
\ integrity is the committed root. Uses scr[0]=s1, scr[4]=s2. Production `expect` is
\ a constant computed once from the canonical 16 MiB table. Ref: tmp/pos2/tblgen.py.
: tbl_chk ( table tblw scr expect -- flag )
  1 lit pick 0 lit over !  0 lit over 4 lit + !  drop     \ s1=0 ; s2=0
  2 lit pick 0 lit do
    3 lit pick i 4 lit * + @          \ w = table[i]
    2 lit pick @ +                    \ s1 + w
    dup 3 lit pick !                  \ store s1', keep it
    2 lit pick 4 lit + @ over +       \ s2 + s1'
    3 lit pick 4 lit + !  drop        \ store s2'; drop s1'
  loop
  1 lit pick @  2 lit pick 4 lit + @  xor   \ ck = s1 ^ s2  (scr@1 then @2 after s1 pushed)
  over =                                     \ flag = (ck == expect)
  nip nip nip nip ;

Test {
tx0 {
  110 lit alloc
  01010101 lit over !
  02020202 lit over 4 lit + !
  03030303 lit over 8 lit + !
  04040404 lit over C lit + !
  05050505 lit over 10 lit + !
  06060606 lit over 14 lit + !
  07070707 lit over 18 lit + !
  08080808 lit over 1C lit + !
  09090909 lit over 20 lit + !
  0A0A0A0A lit over 24 lit + !
  0B0B0B0B lit over 28 lit + !
  0C0C0C0C lit over 2C lit + !
  0D0D0D0D lit over 30 lit + !
  0E0E0E0E lit over 34 lit + !
  0F0F0F0F lit over 38 lit + !
  10101010 lit over 3C lit + !
  100 lit alloc
  \ stack: table scr ; texpand(table, 16, 67, scr)
  1 lit pick 10 lit 43 lit 3 lit pick texpand
  \ representative checks vs tmp/pos2/tblref.py (first block / boundaries / partial)
  1 lit pick 40 lit + @  80B8BE91 lit asrt_eq
  1 lit pick 44 lit + @  9C54D1CA lit asrt_eq
  1 lit pick 5C lit + @  5E1C33F5 lit asrt_eq
  1 lit pick 60 lit + @  AAC338DE lit asrt_eq
  1 lit pick E0 lit + @  E5563091 lit asrt_eq
  1 lit pick FC lit + @  4B9439E8 lit asrt_eq
  1 lit pick 100 lit + @ 7C43FA25 lit asrt_eq
  1 lit pick 104 lit + @ 40F00B1B lit asrt_eq
  1 lit pick 108 lit + @ 46A4A234 lit asrt_eq
  \ full-table checksum over all 67 words == reference (tbl_chk returns -1 on match)
  1 lit pick 43 lit 2 lit pick 6BC5C40E lit tbl_chk  FFFFFFFF lit asrt_eq
  2drop
}
}
