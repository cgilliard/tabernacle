\ ──────────────────────────────────────────────────────────────────────────────
\ src/frivfy.fam — radix-8 FRI verify loop (Stage 5, the capstone). Built on
\ bb4.fam (fpow/finv/cp4/cmp4), frifold.fam (frifold), transcript.fam (tr_*),
\ merkle.fam (mrkroot), poseidon2.fam (p2hash). Compile AFTER all of those.
\ Python prover+verifier reference (the spec): tmp/pos2/frivfyref.py.
\
\ frivfy ( proof params st -- flag )  flag=1 accept / 0 reject.
\   proof  = flat word array: roots[R*8] | final[Nfinal*4] | per (qi,r): evals[8 BB4=32w] path[depth_r*8w]
\   params = K(log2_n) | R(nrounds) | NQ(nqueries) | Nfinal | wNr[R]
\   st     = scratch >= 0x400, state struct:
\     +00 proof +04 params +08 cursor +0C idx +10 K +14 R +18 NQ +1C Nfinal
\     +20 flag  +24 r(loop) +28 qi(loop)
\     +30 v(16) +40 digest(32) +60 rootc(32) +80 vnew(16) +90 sinv
\     +A0 betas(R*16) +120 trctx(0xA0) +1C0 p2scr(0xA0) +260 mkscr(0x80) +2E0 ffscr(0xF0)
\     +3D0 idxr +3D4 L +3D8 m +3DC depth
\ ──────────────────────────────────────────────────────────────────────────────

: bitrev ( x nbits -- r )
  0 lit swap 0 lit do
    over 1 lit and  swap 1 lit lshift +  swap 1 lit rshift swap
  loop  nip ;

: frsinv ( wNr L nbits -- s_inv )  bitrev fpow finv ;

: fv_setup ( proof params st -- st )
  2 lit pick 1 lit pick !
  1 lit pick 1 lit pick 4 lit + !
  1 lit pick @           1 lit pick 10 lit + !
  1 lit pick 4 lit + @   1 lit pick 14 lit + !
  1 lit pick 8 lit + @   1 lit pick 18 lit + !
  1 lit pick C lit + @   1 lit pick 1C lit + !
  1 lit 1 lit pick 20 lit + !
  dup 120 lit + tr_init
  nip nip ;

: fv_comm ( st -- )
  0 lit over 24 lit + !
  begin dup 24 lit + @ over 14 lit + @ u< while
    dup @  over 24 lit + @ 5 lit lshift +  over 120 lit + swap tr_abs8
    dup 120 lit +  over A0 lit + 2 lit pick 24 lit + @ 4 lit lshift +  tr_sqbb4
    dup 24 lit + dup @ 1 lit + swap !
  repeat
  0 lit over 24 lit + !
  begin dup 24 lit + @ over 1C lit + @ 1 lit rshift u< while
    dup @  over 14 lit + @ 5 lit lshift +  over 24 lit + @ 5 lit lshift +
    over 120 lit + swap tr_abs8
    dup 24 lit + dup @ 1 lit + swap !
  repeat
  drop ;

: fv_round ( st -- )
  dup C lit + @  over 24 lit + @ 3 lit * rshift  over 3D0 lit + !
  dup 3D0 lit + @ 3 lit rshift  over 3D4 lit + !
  dup 3D0 lit + @ 7 lit and     over 3D8 lit + !
  dup 10 lit + @ 3 lit -  over 24 lit + @ 3 lit * -  over 3DC lit + !
  dup 8 lit + @  20 lit  2 lit pick 40 lit +  3 lit pick 1C0 lit +  p2hash
  dup 40 lit +  1 lit pick 8 lit + @ 80 lit +  2 lit pick 3D4 lit + @  3 lit pick 3DC lit + @  4 lit pick 60 lit +  5 lit pick 260 lit +  mrkroot
  dup 60 lit +  1 lit pick @ 2 lit pick 24 lit + @ 5 lit lshift +  cmp8  over 20 lit + @ and over 20 lit + !
  dup 24 lit + @ if
    dup 30 lit +  1 lit pick 8 lit + @ 2 lit pick 3D8 lit + @ 4 lit lshift +  cmp4  over 20 lit + @ and over 20 lit + !
  then
  dup 4 lit + @  over 24 lit + @ 4 lit * + 10 lit + @  over 3D4 lit + @  2 lit pick 3DC lit + @  frsinv  over 90 lit + !
  dup 8 lit + @  1 lit pick 90 lit + @  2 lit pick A0 lit + 3 lit pick 24 lit + @ 4 lit lshift +  3 lit pick 80 lit +  4 lit pick 2E0 lit +  frifold
  dup 80 lit + over 30 lit + cp4
  dup 8 lit + dup @  2 lit pick 3DC lit + @ 5 lit lshift 80 lit + +  swap !
  drop ;

: fv_final ( st -- )
  dup C lit + @  over 14 lit + @ 3 lit * rshift  over 3D0 lit + !
  dup 30 lit +
  1 lit pick @  2 lit pick 14 lit + @ 5 lit lshift +  2 lit pick 3D0 lit + @ 4 lit lshift +
  cmp4  over 20 lit + @ and over 20 lit + !
  drop ;

: fv_query ( st -- )
  0 lit over 24 lit + !
  begin dup 24 lit + @ over 14 lit + @ u< while
    dup fv_round
    dup 24 lit + dup @ 1 lit + swap !
  repeat
  dup fv_final
  drop ;

: fv_qall ( st -- )
  dup @  over 14 lit + @ 5 lit lshift +  over 1C lit + @ 4 lit lshift +  over 8 lit + !
  0 lit over 28 lit + !
  begin dup 28 lit + @ over 18 lit + @ u< while
    dup 120 lit +  over 10 lit + @ 1 lit swap lshift 1 lit -  tr_sqidx  over C lit + !
    dup fv_query
    dup 28 lit + dup @ 1 lit + swap !
  repeat
  drop ;

: frivfy ( proof params st -- flag )
  fv_setup
  dup fv_comm
  dup fv_qall
  20 lit + @ ;



