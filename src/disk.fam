\ ──────────────────────────────────────────────────────────────────────────────
\ src/disk.fam — virtio-blk read/write/flush, MULTI-SLOT non-blocking primitives.
\
\ Non-blocking; the caller owns the poll loop:
\   vreq   ( ds type sector buf -- ds id )  build + kick a request; return its slot
\                                           id and return now.  type 1=write 0=read.
\   vflush ( ds -- ds id )                  durable barrier (VIRTIO_BLK_F_FLUSH);
\                                           id = -1 if the device runs writethrough.
\   vpoll  ( ds -- ds )                     reap finished requests into done[]; now.
\   vstat  ( ds id -- ds st )               pure read of done[id]:
\                                           0 = pending, 1 = ok, n>1 = device error
\                                           (n-1 = virtio status: 1 IOERR, 2 UNSUPP).
\   vqread ( ds sector buf nsec -- ds id )  stage a read — NO doorbell.
\   vqwrite( ds sector buf nsec -- ds id )  stage a write — NO doorbell.
\   vkick  ( ds -- ds )                     publish + doorbell everything staged.
\ Batch pattern: N x vqread/vqwrite then ONE vkick = one VM exit for the whole
\ batch (each vread/vwrite/vreadn/vwriten/vreq is exactly vq* + vkick).
\
\ QueueNum is negotiated at init: qnum = min(1024, QueueNumMax).  nslots = qnum/3
\ requests in flight (each = 3 descriptors).  id = slot.  Slot i: descriptors
\ i*3..i*3+2 at qb + i*0x30 ; header+status at hdr_base + i*0x20.  Ring layout (desc
\ table / avail / used base addresses) is computed from qnum once by qlayout and cached
\ in the handle, so the hot path never recomputes it.  Caller must alloc qb >= 0xC000.
\
\ State block `ds` (caller-allocated, >= 0x48 bytes; qb zeroed via qzero):
\   ds+0x00 dev        virtio-blk MMIO base
\   ds+0x04 qb         queue buffer base (page-aligned, >= 0xC000 bytes, zeroed)
\   ds+0x08 subd       total requests submitted   (drives avail.idx)
\   ds+0x0C usd        total completions reaped    (used-ring cursor)
\   ds+0x10 next       next slot id to hand out (rotates 0..nslots-1)
\   ds+0x14 nslots     cached: qnum/3
\   ds+0x18 qmask      cached: qnum-1 (ring index mask)
\   ds+0x1C avail_base cached: qb + qnum*16
\   ds+0x20 used_base  cached: qb + align(qnum*18+6, 4096)
\   ds+0x24 hdr_base   cached: per-slot header/status region base
\   ds+0x28 r_type  ┐ transient: the request currently being built.
\   ds+0x2C r_sector│ single-threaded, so one build scratch is reused per slot;
\   ds+0x30 r_buf   │ the built request then lives in its slot's qb regions,
\   ds+0x34 r_id    │ independent of this scratch, so many can be in flight.
\   ds+0x38 r_d     │ desc base = qb + r_id*0x30
\   ds+0x3C r_h     ┘ hdr  base = hdr_base + r_id*0x20
\   ds+0x40 donep      ptr to done[nslots] array (1 = completed)
\   ds+0x44 r_nsec     transient: sectors in the request being built (multi-sector)
\ ──────────────────────────────────────────────────────────────────────────────

\ fence_io / fence_r come from src/fence.fam, compiled before this file.

\ ── find_blk ( -- dev )  scan the MMIO bus for a virtio device with DeviceID 2 ──
: find_blk
	10008000 lit
	begin dup 8 lit + @ 2 lit <> while
		1000 lit -
		dup 10001000 lit u< if "no blk\n" puts bye then
	repeat
;

\ ── qlayout ( ds qnum -- ds )  cache the split-ring layout for this QueueNum into the
\ handle, so the hot path never recomputes it.  Legacy vring layout (must match what
\ the device computes from QueueNum + QueueAlign=4096):
\   desc table  @ qb + 0                         (qnum * 16 bytes)
\   avail ring  @ qb + qnum*16                   (flags+idx+ring[qnum]+used_event)
\   used  ring  @ qb + align(qnum*18 + 6, 4096)  (page-aligned)
\ Our per-slot header/status scratch (NOT part of the vring) is placed after the used
\ ring, page-aligned: hdr @ qb + align(used_off + qnum*8 + 6, 4096), slot i at +i*0x20.
\ done[] (nslots words) is allocated separately; ptr cached at ds+0x40.
\ Sanity at qnum=16: nslots=5 qmask=15 avail=qb+0x100 used=qb+0x1000 hdr=qb+0x2000.
: qlayout   \ ( ds qnum -- ds )
	over over 3 lit / swap 14 lit + !                  \ ds.nslots = qnum/3
	over over 1 lit - swap 18 lit + !                  \ ds.qmask  = qnum-1
	over 4 lit + @ over 4 lit lshift +                 \ avail_base = qb + qnum*16   ( ds qnum avail )
	2 lit pick 1C lit + !                              \ ds.avail_base
	dup dup 4 lit lshift swap 1 lit lshift + 6 lit +   \ qnum*16 + qnum*2 + 6 ( ds qnum t )
	FFF lit + FFFFF000 lit and                         \ used_off = align(...,4096)   ( ds qnum used_off )
	dup 3 lit pick 4 lit + @ +                         \ used_base = qb + used_off    ( ds qnum used_off ub )
	3 lit pick 20 lit + !                              \ ds.used_base                 ( ds qnum used_off )
	1 lit pick 3 lit lshift + 6 lit +                  \ used_off + qnum*8 + 6        ( ds qnum t )
	FFF lit + FFFFF000 lit and                         \ hdr_off = align(...,4096)    ( ds qnum hdr_off )
	2 lit pick 4 lit + @ +                             \ hdr_base = qb + hdr_off      ( ds qnum hdr_base )
	2 lit pick 24 lit + !                              \ ds.hdr_base                  ( ds qnum )
	over 14 lit + @ 2 lit lshift alloc                 \ done[] = alloc(nslots*4)     ( ds qnum donep )
	2 lit pick 40 lit + !                              \ ds.donep
	drop                                               \ ( ds )
;

\ ── vblkinit ( ds -- ds )  virtio handshake + queue-0 config (ds[0]=dev, ds[4]=qb) ──
\ Negotiates VIRTIO_BLK_F_FLUSH (bit 9 = 0x200) IF the device offers it: that selects
\ writeback caching (writes complete into a volatile cache, vflush makes them durable).
\ If the device doesn't offer it we negotiate nothing and run writethrough.
: vblkinit
	dup @ dup 70 lit + 0 lit swap !
	dup 70 lit + 1 lit swap !
	dup dup 70 lit + @ 2 lit or swap 70 lit + !
	dup 10 lit + @ 200 lit and over 20 lit + !   \ DriverFeatures = offered & FLUSH(bit 9)
	dup dup 70 lit + @ 8 lit or swap 70 lit + !
	dup 28 lit + 1000 lit swap !
	dup 30 lit + 0 lit swap !
	dup 3C lit + 1000 lit swap !
	\ negotiate queue size: qnum = min(1024, QueueNumMax@0x34) ; ( ds dev )
	dup 34 lit + @                                 \ QueueNumMax            ( ds dev max )
	dup 400 lit u< if else drop 400 lit then       \ qnum = min(max, 1024)  ( ds dev qnum )
	2dup swap 38 lit + !                           \ dev.QueueNum = qnum    ( ds dev qnum )
	2 lit pick 4 lit + @ C lit rshift              \ pfn = ds.qb >> 12      ( ds dev qnum pfn )
	2 lit pick 40 lit + !                          \ dev.QueuePFN = pfn     ( ds dev qnum )
	over dup 70 lit + @ 4 lit or swap 70 lit + !   \ dev.Status |= DRIVER_OK(4)  ( ds dev qnum )
	swap drop                                      \ ( ds qnum )
	qlayout                                        \ cache ring layout for qnum
;

\ ── qzero ( qb -- )  zero 32 KiB (0x2000 words) at qb — covers the QueueNum=1024 vring
\ (desc 16K + avail + used ends ~0x7006).  The per-slot header region above that is
\ written per-request, not pre-zeroed.  Callers must allocate qb >= 0xC000 bytes. ──
: qzero
	2000 lit
	begin
		dup 0 lit > while
		swap
		dup 0 lit swap !
		4 lit +
		swap 1 lit -
	repeat
	drop drop
;

\ ===== slot allocator + per-request build helpers (all ( ds -- ds )) =====

\ nslot ( ds -- ds id )  claim the next slot id and advance the rotating allocator.
: nslot
	dup 10 lit + @                                                     \ id = next
	dup 1 lit + dup 3 lit pick 14 lit + @ u< if else drop 0 lit then   \ next' = (id+1)<nslots ? id+1 : 0
	2 lit pick 10 lit + !                                              \ ds.next = next'
;

\ rbase ( ds -- ds )  recompute r_d / r_h from qb + r_id (call after r_id is set).
: rbase
	dup 4 lit + @ over 34 lit + @                                \ ( ds qb id )
	2dup 30 lit * + 3 lit pick 38 lit + !                        \ r_d = qb + id*0x30
	dup 20 lit * 3 lit pick 24 lit + @ + 3 lit pick 3C lit + !   \ r_h = hdr_base + id*0x20
	drop drop
;

\ clrd ( ds -- ds )  mark the current slot pending: done[r_id] = 0.
: clrd
	dup 34 lit + @ 4 lit * over 40 lit + @ + 0 lit swap !   \ done[r_id] = 0 (donep + id*4)
;

\ whdr ( ds -- ds )  write the 16-B request header + arm the status byte at r_h.
: whdr
	dup 3C lit + @                   \ ( ds h )
	over 28 lit + @ over !           \ r_type   @ h+0
	0 lit over 4 lit + !             \ reserved
	over 2C lit + @ over 8 lit + !   \ r_sector @ h+8
	0 lit over C lit + !             \ sector hi
	FF lit over 10 lit + c!          \ status   @ h+0x10  (device clears it)
	drop
;

\ wd0 ( ds -- ds )  descriptor 0: the header (16B, device-reads), chains to desc 1.
: wd0
	dup 38 lit + @                                    \ ( ds d )
	over 3C lit + @ over !                            \ addr = r_h
	0 lit over 4 lit + !
	10 lit over 8 lit + !                             \ len 16
	1 lit over C lit + h!                             \ flags NEXT
	over 34 lit + @ 3 lit * 1 lit + over E lit + h!   \ next = id*3+1
	drop
;

\ wd1 ( ds -- ds )  descriptor 1: the 512-B data buffer.  Write request => device
\ reads it (flags NEXT); read request (type 0) => device WRITES it (flags NEXT|WRITE).
: wd1
	dup 38 lit + @ 10 lit +                                            \ ( ds d1 )  = r_d + 0x10
	over 30 lit + @ over !                                             \ addr = r_buf
	0 lit over 4 lit + !
	over 44 lit + @ 9 lit lshift over 8 lit + !                        \ len = r_nsec * 512
	over 28 lit + @ 0 lit = if 3 lit else 1 lit then over C lit + h!   \ read?NEXT|WRITE:NEXT
	over 34 lit + @ 3 lit * 2 lit + over E lit + h!                    \ next = id*3+2
	drop
;

\ wd2 ( ds -- ds )  descriptor 2: the 1-B status (device-writes), end of chain.
: wd2
	dup 38 lit + @ 20 lit +           \ ( ds d2 )  = r_d + 0x20
	over 3C lit + @ 10 lit + over !   \ addr = r_h + 0x10 (status byte)
	0 lit over 4 lit + !
	1 lit over 8 lit + !              \ len 1
	2 lit over C lit + h!             \ flags WRITE
	0 lit over E lit + h!             \ next 0
	drop
;

\ subq ( ds -- ds )  STAGE the current slot's chain in the avail ring.  Does NOT
\ publish avail.idx or ring the doorbell — vkick does that, so any number of
\ staged requests cost one notify.
: subq
	dup 34 lit + @ 3 lit *                                  \ head = r_id*3   ( ds head )
	over 8 lit + @ 2 lit pick 18 lit + @ and 1 lit lshift   \ (subd & qmask) * 2
	2 lit pick 1C lit + @ 4 lit + +                         \ &avail.ring[i] = avail_base + 4 + off
	h!                                                      \ ring[i] = head
	dup 8 lit + @ 1 lit + over 8 lit + !                    \ subd += 1
;

\ vkick ( ds -- ds )  publish every staged request (avail.idx = subd) + doorbell.
: vkick
	dup 8 lit + @ over 1C lit + @ 2 lit + h!   \ avail.idx = subd (low 16, avail_base+2)
	fence_io
	dup @ 50 lit + 0 lit swap !                \ QueueNotify queue 0
;

\ ══════════════════════════════════════════════════════════════════════════════
\ PUBLIC NON-BLOCKING INTERFACE
\ ══════════════════════════════════════════════════════════════════════════════

\ vreq ( ds type sector buf -- ds id )  SUBMIT a 1-sector request; return slot id.
: vreq
	1 lit 4 lit pick 44 lit + !   \ ds.r_nsec   = 1 (single sector)
	3 lit pick 30 lit + !         \ ds.r_buf    = buf
	2 lit pick 2C lit + !         \ ds.r_sector = sector
	over 28 lit + !               \ ds.r_type   = type
	nslot                         \ ( ds id )
	over 34 lit + !               \ ds.r_id     = id
	rbase clrd whdr wd0 wd1 wd2 subq vkick
	dup 34 lit + @                \ ( ds id )
;

\ vflush ( ds -- ds id )  durable barrier; id = -1 (FFFFFFFF) in writethrough mode.
\ Builds a no-data 2-descriptor chain (header type 4 -> status) in a fresh slot.
: vflush
	dup @ 10 lit + @ 200 lit and if   \ device offers VIRTIO_BLK_F_FLUSH? (writeback)
		nslot over 34 lit + !   \ claim slot -> r_id
		rbase clrd
		\ header: type 4 (flush), sector ignored, status armed
		dup 3C lit + @   \ ( ds h )
		4 lit over !
		0 lit over 4 lit + !
		0 lit over 8 lit + !
		0 lit over C lit + !
		FF lit over 10 lit + c!
		drop
		\ desc0: header (16B, device-reads), NEXT -> status
		dup 38 lit + @                                    \ ( ds d )
		over 3C lit + @ over !                            \ addr = r_h
		0 lit over 4 lit + !
		10 lit over 8 lit + !
		1 lit over C lit + h!                             \ flags NEXT
		over 34 lit + @ 3 lit * 1 lit + over E lit + h!   \ next = id*3+1
		drop
		\ desc1: status byte (1B, device-writes), end of chain (no data buffer)
		dup 38 lit + @ 10 lit +           \ ( ds d1 )
		over 3C lit + @ 10 lit + over !   \ addr = r_h + 0x10
		0 lit over 4 lit + !
		1 lit over 8 lit + !
		2 lit over C lit + h!             \ flags WRITE
		0 lit over E lit + h!             \ next 0
		drop
		subq vkick
		dup 34 lit + @                    \ ( ds id )
	else
		FFFFFFFF lit   \ writethrough: nothing to flush
	then
;

\ vpoll ( ds -- ds )  reap every finished request into done[]; never waits.
\ done[slot] records the device's verdict as status+1: the status byte the device
\ DMA'd to hdr+0x10 (0 OK, 1 IOERR, 2 UNSUPP) so 1 = ok, >1 = error, 0 = pending.
: vpoll
	begin
		dup 20 lit + @ 2 lit + h@     \ device's used.idx (used_base+2, 16-bit)
		over C lit + @ FFFF lit and   \ our cursor (16-bit)
		<>
	while
		fence_r                                                \ order used-ring + DMA reads after seeing idx
		dup C lit + @ 1 lit pick 18 lit + @ and 3 lit lshift   \ (usd & qmask) * 8 (ds at depth1)
		over 20 lit + @ 4 lit + + @                            \ used.ring[i].id = head descriptor (used_base+4+off)
		3 lit /                                                \ slot = head / 3     ( ds slot )
		dup 20 lit * 2 lit pick 24 lit + @ +                   \ hdr = hdr_base + slot*0x20 ( ds slot hdr )
		10 lit + c@ 1 lit +                                    \ code = status + 1   ( ds slot code )
		swap 4 lit * 2 lit pick 40 lit + @ + !                 \ done[slot] = code (donep + slot*4)
		dup C lit + @ 1 lit + over C lit + !                   \ usd += 1
	repeat
;

\ vstat ( ds id -- ds st )  pure read of done[id]:
\ 0 = pending, 1 = completed ok, n>1 = completed with device error (n-1 = virtio
\ status: 1 IOERR, 2 UNSUPP).  Nonzero always means "slot reaped / reusable".
: vstat
	4 lit * over 40 lit + @ + @   \ done[id] = donep + id*4
;

\ vqwrite ( ds sector buf nsec -- ds id )  STAGE a WRITE of nsec contiguous sectors;
\ no doorbell.  Batch: N x vqwrite/vqread then ONE vkick (one VM exit for all N).
: vqwrite
	3 lit pick 44 lit + !   \ ds.r_nsec   = nsec   ( ds sector buf )
	2 lit pick 30 lit + !   \ ds.r_buf    = buf
	over 2C lit + !         \ ds.r_sector = sector
	1 lit over 28 lit + !   \ ds.r_type   = 1 (write)
	nslot over 34 lit + !
	rbase clrd whdr wd0 wd1 wd2 subq
	dup 34 lit + @
;

\ vqread ( ds sector buf nsec -- ds id )  STAGE a READ of nsec contiguous sectors
\ into a buffer of nsec*512 bytes; no doorbell — finish the batch with vkick.
: vqread
	3 lit pick 44 lit + !   \ ds.r_nsec   = nsec   ( ds sector buf )
	2 lit pick 30 lit + !   \ ds.r_buf    = buf
	over 2C lit + !         \ ds.r_sector = sector
	0 lit over 28 lit + !   \ ds.r_type   = 0 (read)
	nslot over 34 lit + !
	rbase clrd whdr wd0 wd1 wd2 subq
	dup 34 lit + @
;

\ vwrite ( ds sector buf -- ds id )  submit a WRITE (type 1) of one sector + kick.
\ Convenience over vreq: takes args in a node-friendly order (no type), so the
\ sequential image-save loop need not juggle the stack.
: vwrite 1 lit vqwrite swap vkick swap ;

\ vwriten ( ds sector buf nsec -- ds id )  multi-sector WRITE + kick.
: vwriten vqwrite swap vkick swap ;

\ vread ( ds sector buf -- ds id )  submit a READ (type 0) of one sector + kick.
: vread 1 lit vqread swap vkick swap ;

\ vreadn ( ds sector buf nsec -- ds id )  multi-sector READ + kick.
: vreadn vqread swap vkick swap ;

\ vwait ( ds id -- ds id )  BLOCKING: pump vpoll until done[id] == 1.  Built on the
\ non-blocking primitives — the node's standalone disk-save loop uses it; the unified
\ serve/event loop (Stage 2) drives vpoll itself and checks vstat instead.
: vwait
	begin
		swap vpoll swap                    \ vpoll(ds), keep id
		over 40 lit + @ over 4 lit * + @   \ done[id] = donep + id*4
	until
;

\ ──────────────────────────────────────────────────────────────────────────────
\ Tests (./tools/fam --test src/disk.fam).  No real device: drive the LOGIC on a
\ fake state block — a heap ds, a fake qb (memory we read/write as if it were the
\ queue), a fake dev (scratch absorbing QueueNotify / supplying DeviceFeatures).
\ tqset gives ds a zeroed qb + the QueueNum=16 layout, which reproduces the legacy
\ offsets these hand-written checks assume (avail@qb+0x100, used@qb+0x1000,
\ hdr@qb+0x2000, nslots=5, qmask=15).  The real-device path (find_blk/vblkinit/
\ batch/flush/readback) is exercised by a Test block run with
\ ./tools/fam --test --disk=IMG, which attaches IMG as a virtio-blk disk.
\ ──────────────────────────────────────────────────────────────────────────────

\ tqset ( ds -- ds )  page-aligned, zeroed qb + QueueNum=16 layout (+ done[] array).
: tqset
	C000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !   \ ds.qb
	10 lit qlayout
;

Test {
	\ nslot hands out 0,1,2,3,4 then wraps back to 0 (nslots = 16/3 = 5).
	slot_rot {
		4C lit alloc tqset                  \ ( ds )
		0 lit over 10 lit + !               \ next = 0
		dup nslot swap drop 0 lit asrt_eq   \ -> 0   (nslot returns ( ds id ); keep id)
	}
	\ nslot wraps: starting at next=4 yields 4 then sets next back to 0.
	slot_wrap {
		4C lit alloc tqset
		4 lit over 10 lit + !      \ next = 4
		dup nslot drop             \ id 4 ; ( ds )
		10 lit + @ 0 lit asrt_eq   \ next wrapped to 0 (nslots=5)
	}
	\ vreq builds slot 0's 3-descriptor chain + header for a WRITE (type 1).
	req_wr {
		4C lit alloc tqset         \ ( ds )
		100 lit alloc over !       \ dev (scratch for QueueNotify)
		0 lit over 8 lit + !       \ subd 0
		0 lit over 10 lit + !      \ next 0
		1 lit 9 lit 40000000 lit   \ ( ds type=1 sector=9 buf )
		vreq                       \ ( ds id )
		0 lit asrt_eq              \ slot id == 0
		\ header at qb+0x2000
		dup 4 lit + @ 2000 lit + @ 1 lit asrt_eq     \ type = write(1)
		dup 4 lit + @ 2008 lit + @ 9 lit asrt_eq     \ sector = 9
		dup 4 lit + @ 2010 lit + c@ FF lit asrt_eq   \ status armed = FF
		\ desc[0] (header) at qb+0, desc[1] (data) at qb+0x10
		dup 4 lit + @ 0 lit + @ over 4 lit + @ 2000 lit + asrt_eq   \ desc0.addr = r_h
		dup 4 lit + @ 8 lit + @ 10 lit asrt_eq                      \ desc0.len  = 16
		dup 4 lit + @ E lit + h@ 1 lit asrt_eq                      \ desc0.next = id*3+1 = 1
		dup 4 lit + @ 10 lit + @ 40000000 lit asrt_eq               \ desc1.addr = buf
		dup 4 lit + @ 18 lit + @ 200 lit asrt_eq                    \ desc1.len  = 512 (nsec=1)
		dup 4 lit + @ 1C lit + h@ 1 lit asrt_eq                     \ desc1.flags = NEXT (write: device reads)
		\ avail ring published head 0, idx 1; subd advanced
		dup 4 lit + @ 104 lit + h@ 0 lit asrt_eq   \ avail.ring[0] = head 0
		dup 4 lit + @ 102 lit + h@ 1 lit asrt_eq   \ avail.idx = 1
		8 lit + @ 1 lit asrt_eq                    \ subd = 1   ( consumes ds )
	}
	\ A READ (type 0) flips desc[1] to device-WRITES (flags NEXT|WRITE = 3).
	req_rd {
		4C lit alloc tqset
		100 lit alloc over !
		0 lit over 8 lit + !
		0 lit over 10 lit + !
		0 lit B lit 40000000 lit                   \ type=0 (read) sector=11 buf
		vreq drop                                  \ ( ds )
		dup 4 lit + @ 2000 lit + @ 0 lit asrt_eq   \ type = read(0)
		4 lit + @ 1C lit + h@ 3 lit asrt_eq        \ desc1.flags = NEXT|WRITE (device writes)
	}
	\ vqwrite stages ring entries + advances subd but does NOT publish avail.idx;
	\ vkick publishes both staged requests with one doorbell.
	batch_q {
		4C lit alloc tqset
		100 lit alloc over !
		0 lit over 8 lit + !
		0 lit over 10 lit + !
		9 lit 40000000 lit 1 lit vqwrite drop      \ stage slot 0 (sector 9)
		A lit 40000200 lit 1 lit vqwrite drop      \ stage slot 1 (sector 10)
		dup 4 lit + @ 102 lit + h@ 0 lit asrt_eq   \ avail.idx NOT published yet
		dup 8 lit + @ 2 lit asrt_eq                \ subd = 2 (both staged)
		dup 4 lit + @ 104 lit + h@ 0 lit asrt_eq   \ avail.ring[0] = head 0 (slot 0)
		dup 4 lit + @ 106 lit + h@ 3 lit asrt_eq   \ avail.ring[1] = head 3 (slot 1)
		vkick
		4 lit + @ 102 lit + h@ 2 lit asrt_eq       \ avail.idx = 2: one kick, both live
	}
	\ vpoll surfaces a device error: status byte 1 (IOERR) -> done[slot] = 2.
	stat_err {
		4C lit alloc tqset
		0 lit over C lit + !                      \ usd 0
		dup 4 lit + @ 1004 lit + 0 lit swap !     \ used.ring[0].id = 0 (slot 0)
		dup 4 lit + @ 1002 lit + 1 lit swap h!    \ used.idx = 1
		dup 4 lit + @ 2010 lit + 1 lit swap c!    \ device wrote status = IOERR(1)
		vpoll
		0 lit vstat 2 lit asrt_eq                 \ vstat = status+1 = 2 (error, reaped)
	}
	\ vpoll reaps a completion the device posted (used.ring[0].id = 0 -> slot 0) into done[].
	poll_reap {
		4C lit alloc tqset
		0 lit over C lit + !   \ usd 0
		\ device side: used.ring[0].id = 0 (head of slot 0), used.idx = 1
		dup 4 lit + @ 1004 lit + 0 lit swap !     \ used.ring[0].id = 0
		dup 4 lit + @ 1002 lit + 1 lit swap h!    \ used.idx = 1
		vpoll
		dup C lit + @ 1 lit asrt_eq               \ usd advanced to 1
		dup 0 lit vstat swap drop 1 lit asrt_eq   \ done[0] = 1
		40 lit + @ @ 1 lit asrt_eq                \ done[0] via donep ( consumes ds )
	}
	\ vpoll on an empty used ring (idx == cursor) is a no-op.
	poll_empty {
		4C lit alloc tqset
		3 lit over C lit + !                     \ usd 3
		dup 4 lit + @ 1002 lit + 3 lit swap h!   \ used.idx = 3 == usd -> nothing
		vpoll
		C lit + @ 3 lit asrt_eq                  \ usd unchanged  ( consumes ds )
	}
	\ vstat is a pure read of done[id].
	stat_rd {
		4C lit alloc tqset
		1 lit over 40 lit + @ 8 lit + !           \ done[2] = 1 (donep + 2*4)
		dup 2 lit vstat swap drop 1 lit asrt_eq   \ done[2] reads 1
		1 lit vstat 0 lit asrt_eq                 \ done[1] reads 0   ( consumes ds )
	}
	\ vflush, writeback (device offers FLUSH): builds a type-4 no-data 2-descriptor chain.
	flush_wb {
		4C lit alloc tqset
		100 lit alloc over !
		200 lit over @ 10 lit + !                  \ dev DeviceFeatures = FLUSH offered (writeback)
		0 lit over 8 lit + !
		0 lit over 10 lit + !
		vflush                                     \ ( ds id )
		0 lit asrt_eq                              \ used slot 0
		dup 4 lit + @ 2000 lit + @ 4 lit asrt_eq   \ header type = flush(4)
		dup 4 lit + @ 8 lit + @ 10 lit asrt_eq     \ desc0.len  = 16 (header)
		dup 4 lit + @ E lit + h@ 1 lit asrt_eq     \ desc0.next = 1 -> status
		dup 4 lit + @ 18 lit + @ 1 lit asrt_eq     \ desc1.len  = 1 (status byte)
		4 lit + @ 1C lit + h@ 2 lit asrt_eq        \ desc1.flags = WRITE (no NEXT)
	}
	\ vwrite is vreq with type implied 1 and a node-friendly arg order.
	req_vw {
		4C lit alloc tqset
		100 lit alloc over !
		0 lit over 8 lit + !
		0 lit over 10 lit + !
		3 lit 40000000 lit                          \ ( ds sector=3 buf )
		vwrite                                      \ ( ds id )
		0 lit asrt_eq                               \ slot 0
		dup 4 lit + @ 2000 lit + @ 1 lit asrt_eq    \ type = write(1)
		dup 4 lit + @ 2008 lit + @ 3 lit asrt_eq    \ sector = 3
		4 lit + @ 10 lit + @ 40000000 lit asrt_eq   \ desc1.addr = buf  ( consumes ds )
	}
	\ vwait returns at once when the slot is already done (must not spin forever).
	wait_done {
		4C lit alloc tqset
		1 lit over 40 lit + @ 8 lit + !   \ done[2] = 1 (donep + 2*4)
		2 lit vwait                       \ ( ds 2 )  must return immediately
		2 lit asrt_eq                     \ id preserved
		40 lit + @ @ 0 lit asrt_eq        \ done[0] untouched (donep[0]) ( consumes ds )
	}
	\ vflush, writethrough (no FLUSH offered): a no-op returning the -1 sentinel (returns
	\ before any slot/submit work, so no layout is needed).
	flush_wt {
		4C lit alloc
		100 lit alloc over !
		0 lit over @ 10 lit + !   \ DeviceFeatures = 0 (no FLUSH)
		0 lit over 8 lit + !
		0 lit over 10 lit + !
		vflush                    \ ( ds id )
		FFFFFFFF lit asrt_eq      \ sentinel: writethrough, nothing to flush
		8 lit + @ 0 lit asrt_eq   \ subd untouched (nothing submitted)  ( consumes ds )
	}
}
