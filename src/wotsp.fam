\ ──────────────────────────────────────────────────────────────────────────────
\ src/wotsp.fam — WOTS+ one-time signatures over Poseidon2-BabyBear-16.
\
\ Chain element = 8 BabyBear words (32 B). 67 chains (64 msg + 3 checksum),
\ Winternitz w=16 (4-bit digits), MAXSTEP=15. Built on pos2_i (mul-free).
\   compress(x)   = pos2_i([x(8), 0(8)])[0..8]      one perm; the chain step
\   compress2(a,b)= pos2_i([a(8), b(8)])[0..8]      2:1 compression
\   pk            = MerkleDamgard(compress2) over 67 chain tops, init 0
\ NO alloc-per-call: caller passes a perm scratch `scr`. Low-level words need
\ scr>=0x80 B (s[16]+w[16]); wkeysk/wverify need scr>=0xA0 B (temp at +0x80).
\ Buffers (caller-allocated, reused): sk/sig/tops = 67*8 words (0x860 B),
\ pk/seed/msg = 8 words (0x20 B), dig = 67 words (0x110 B). fam literals HEX.
\ ──────────────────────────────────────────────────────────────────────────────

: cp8   ( src dst -- )  8 lit 0 lit do  over i 4 lit * + @  over i 4 lit * + !  loop  2drop ;
: zero8 ( buf -- )      8 lit 0 lit do  0 lit over i 4 lit * + !  loop  drop ;
: cmp8  ( a b -- f )    1 lit  8 lit 0 lit do  2 lit pick i 4 lit * + @  2 lit pick i 4 lit * + @  =  and  loop  nip nip ;

: wcompr  ( in out scr -- )   \ out = compress(in)
  2 lit pick over cp8
  dup 20 lit + zero8
  dup dup 40 lit + pos2_i 2drop
  dup 2 lit pick cp8
  2drop drop ;

: wcompr2 ( a b out scr -- )  \ out = compress2(a,b)
  3 lit pick over cp8
  2 lit pick over 20 lit + cp8
  dup dup 40 lit + pos2_i 2drop
  dup 2 lit pick cp8
  2drop 2drop ;

: wchain  ( in out steps scr -- )   \ out = chain(in,steps)
  3 lit pick 3 lit pick cp8
  over 0 lit > if
    over 0 lit do
      2 lit pick dup 2 lit pick wcompr
    loop
  then
  2drop 2drop ;

: wmsgdig ( msg digits -- )   \ 8 words (32 LE bytes) -> 67 digits (64 nibbles + 3 checksum)
  20 lit 0 lit do
    over  i 2 lit rshift 2 lit lshift + @
    i 3 lit and 3 lit lshift rshift  FF lit and
    dup 4 lit rshift  2 lit pick i 8 lit * + !
    F lit and  over i 8 lit * + 4 lit + !
  loop
  0 lit
  40 lit 0 lit do
    over i 4 lit * + @  F lit swap -  +
  loop
  dup 8 lit rshift F lit and  2 lit pick 100 lit + !
  dup 4 lit rshift F lit and  2 lit pick 104 lit + !
  dup F lit and               2 lit pick 108 lit + !
  drop 2drop ;

: wpkhash ( tops out scr -- )
  1 lit pick zero8
  43 lit 0 lit do
    1 lit pick  3 lit pick i 20 lit * +  1 lit pick  3 lit pick  wcompr2
  loop
  2drop drop ;

: wkeysk  ( seed sk scr -- )   \ scr>=0xA0 B (idxblk at +0x80)
  43 lit 0 lit do
    dup 80 lit + zero8
    i over 80 lit + !
    2 lit pick  1 lit pick 80 lit +  3 lit pick i 20 lit * +  3 lit pick  wcompr2
  loop
  2drop drop ;

: wkeypk  ( sk pk scr tops -- )
  43 lit 0 lit do
    3 lit pick i 20 lit * +  1 lit pick i 20 lit * +  F lit  4 lit pick  wchain
  loop
  dup 3 lit pick 3 lit pick wpkhash
  2drop 2drop ;

: wsign   ( msg sk sig scr dig -- )
  4 lit pick 1 lit pick wmsgdig
  43 lit 0 lit do
    3 lit pick i 20 lit * +  3 lit pick i 20 lit * +  2 lit pick i 4 lit * + @  4 lit pick  wchain
  loop
  2drop 2drop drop ;

: wverify ( pk sig msg scr dig tops -- f )   \ scr>=0xA0 B (digest at +0x80)
  3 lit pick 2 lit pick wmsgdig
  43 lit 0 lit do
    4 lit pick i 20 lit * +  1 lit pick i 20 lit * +  3 lit pick i 4 lit * + @ F lit swap -  5 lit pick  wchain
  loop
  dup 3 lit pick 80 lit + 4 lit pick wpkhash
  2 lit pick 80 lit + 6 lit pick cmp8
  nip nip nip nip nip nip ;

