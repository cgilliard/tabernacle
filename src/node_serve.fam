\ ──────────────────────────────────────────────────────────────────────────────
\ src/node_serve.fam — BIN0/UDP chunk server for full_node.
\
\ Replaces tools/server.py INSIDE the node: answers BIN0 REQ_RANGE packets with
\ chunks of the node's own image, so a running node seeds the binary to peers.
\ Self-contained net path (virtio-net + ARP + IP/UDP + BIN0); zero-copy chunk send
\ (TX queue size 2: desc[0]=header, desc[1]=payload by reference — no per-chunk copy).
\
\ Protocol (matches tools/server.py):
\   REQ_RANGE  "BIN0" 02 start(BE16) end(BE16) [bitmap(8)]
\   RSP_CHUNK  "BIN0" 82 seq(BE16)  data(<=1400)
\
\ Handoff:  a2 = bind port (0 -> 3737)   a3 = debug flag   a4 = img_base (0 -> scan)
\ ──────────────────────────────────────────────────────────────────────────────

\ (No fam variables: the variable region overlaps the loaded image — boot args are
\ carried on the stack and stored into the ns block instead.)

\ ── arg capture: push aN onto the data stack (must run before any : word call) ──
:M _a1 1301C1FF , 2320B100 , ;     \ addi sp,sp,-4 ; sw a1,0(sp)   (boot source)
:M _a2 1301C1FF , 2320C100 , ;     \ addi sp,sp,-4 ; sw a2,0(sp)
:M _a3 1301C1FF , 2320D100 , ;     \ addi sp,sp,-4 ; sw a3,0(sp)
:M _a4 1301C1FF , 2320E100 , ;     \ addi sp,sp,-4 ; sw a4,0(sp)
\ (fence_io / fence_r + the virtio-blk words live in src/disk.fam, compiled first;
\ the net primitives live in src/net.fam, compiled just before this file)

\ ===== output / debug =====
: putnib
dup A lit < if 30 lit + else 37 lit + then putc
;

: puthx2
dup 4 lit rshift F lit and putnib
F lit and putnib
;

: puthx8
dup 1C lit rshift F lit and putnib
dup 18 lit rshift F lit and putnib
dup 14 lit rshift F lit and putnib
dup 10 lit rshift F lit and putnib
dup C  lit rshift F lit and putnib
dup 8  lit rshift F lit and putnib
dup 4  lit rshift F lit and putnib
F lit and putnib
;

: putdec
dup 2710 lit u< invert if
dup 2710 lit / 30 lit + putc
2710 lit %
dup 3E8 lit / 30 lit + putc
3E8 lit %
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup 3E8 lit u< invert if
dup 3E8 lit / 30 lit + putc
3E8 lit %
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup 64 lit u< invert if
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup A lit u< invert if
dup A lit / 30 lit + putc
A lit %
then then then then
30 lit + putc
;

\ ===== blocking send wrappers (Stage 1) =====
\ The net device path now lives in src/net.fam as non-blocking primitives
\ (rx_poll / rx_done / tx_post / tx_post2 / tx_busy), compiled just before this
\ file.  node_serve's dispatch still wants a send-and-wait (the BIN0 chunk burst
\ in hnd_famc reuses one TX buffer, so each chunk must drain before the next), so
\ rebuild the old blocking tx_send / tx_send2 from the primitives: post, then spin
\ on tx_busy.  Stage 2 makes the serve loop fully non-blocking and these go away.
: tx_send   tx_post   begin tx_busy 0 lit = until ;
: tx_send2  tx_post2  begin tx_busy 0 lit = until ;

\ ===== BIN0 dispatch =====
: arp_hand
dup 34 lit + @ 16 lit + c@ 8 lit =
over 34 lit + @ 17 lit + c@ 6 lit = and
over 34 lit + @ 1E lit + c@ 0 lit = and
over 34 lit + @ 1F lit + c@ 1 lit = and
if
  dup 10 lit + @
  dup 0 lit swap !
  dup 4 lit + 0 lit swap !
  dup 8 lit + 0 lit swap !
  drop
  dup 34 lit + @ 20 lit +
  over 10 lit + @ A lit +
  6 lit mcopy
  dup 60 lit +
  over 10 lit + @ 10 lit +
  6 lit mcopy
  dup 10 lit + @
  8 lit over 16 lit + c!
  6 lit over 17 lit + c!
  0 lit over 18 lit + c!
  1 lit over 19 lit + c!
  8 lit over 1A lit + c!
  0 lit over 1B lit + c!
  6 lit over 1C lit + c!
  4 lit over 1D lit + c!
  0 lit over 1E lit + c!
  2 lit over 1F lit + c!
  drop
  dup 60 lit +
  over 10 lit + @ 20 lit +
  6 lit mcopy
  dup 34 lit + @ 30 lit +
  over 10 lit + @ 26 lit +
  4 lit mcopy
  dup 34 lit + @ 20 lit +
  over 10 lit + @ 2A lit +
  6 lit mcopy
  dup 34 lit + @ 26 lit +
  over 10 lit + @ 30 lit +
  4 lit mcopy
  34 lit over 24 lit + !
  tx_send
then
;

: bld_tmpl
dup 10 lit + @
dup 0 lit swap !
dup 4 lit + 0 lit swap !
dup 8 lit + 0 lit swap h!
drop
dup 34 lit + @ 10 lit +
over 10 lit + @ A lit +
6 lit mcopy
dup 60 lit +
over 10 lit + @ 10 lit +
6 lit mcopy
dup 10 lit + @
8 lit over 16 lit + c!
0 lit over 17 lit + c!
drop
dup 10 lit + @ 18 lit +
00000045 lit over !
0 lit over 4 lit + !
00001140 lit over 8 lit + !
over 34 lit + @ 28 lit + @ over C lit + !
drop
dup 34 lit + @ 24 lit + @
over 10 lit + @ 28 lit + !
dup 10 lit + @ 2C lit +
over 68 lit + @ dup FF lit and 8 lit lshift swap 8 lit rshift or over h!
over 34 lit + @ 2C lit + h@
over 2 lit + h!
0 lit over 4 lit + !
drop
;

: snd_chnk
dup 28 lit + @
dup A lit lshift
over 8 lit lshift +
over 7 lit lshift +
swap 3 lit lshift -
over 2C lit + !
dup 2C lit + @ over 18 lit + @ u< if
  dup 18 lit + @ over 2C lit + @ -
  dup 578 lit u< if
  else
    drop 578 lit
  then
  over 30 lit + !
  dup 10 lit + @ 34 lit +
  42 lit over c!
  49 lit over 1 lit + c!
  4E lit over 2 lit + c!
  30 lit over 3 lit + c!
  82 lit over 4 lit + c!
  over 28 lit + @ 8 lit rshift FF lit and
  over 5 lit + c!
  over 28 lit + @ FF lit and
  over 6 lit + c!
  drop
  \ Zero-copy: record the chunk's data address (payload_base + file offset) at
  \ ns+3C; tx_send2 hands it to the device as desc[1] -- no memcpy.
  dup 14 lit + @ over 2C lit + @ + over 3C lit + !
  dup 30 lit + @ F lit + over 24 lit + !
  dup 24 lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 30 lit + c!
  dup 24 lit + @ FF lit and
  over 10 lit + @ 31 lit + c!
  dup 24 lit + @ 14 lit + over 2C lit + !
  dup 2C lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 1A lit + c!
  dup 2C lit + @ FF lit and
  over 10 lit + @ 1B lit + c!
  0 lit over 10 lit + @ 22 lit + c!
  0 lit over 10 lit + @ 23 lit + c!
  dup 10 lit + @ 18 lit + ip_csum over 2C lit + !
  dup 2C lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 22 lit + c!
  dup 2C lit + @ FF lit and
  over 10 lit + @ 23 lit + c!
  0 lit over 10 lit + @ 32 lit + c!
  0 lit over 10 lit + @ 33 lit + c!
  tx_send2
then
;

: hnd_famc
dup 34 lit + @ 16 lit + c@ 8 lit =
over 34 lit + @ 17 lit + c@ 0 lit = and
over 34 lit + @ 21 lit + c@ 11 lit = and
if
dup 34 lit + @ 2E lit + c@ 8 lit lshift
over 34 lit + @ 2F lit + c@ or
over 68 lit + @ = if
  dup 34 lit + @ 34 lit + c@ 42 lit =
  over 34 lit + @ 35 lit + c@ 49 lit = and
  over 34 lit + @ 36 lit + c@ 4E lit = and
  over 34 lit + @ 37 lit + c@ 30 lit = and
  over 34 lit + @ 38 lit + c@ 2 lit = and
  if
    dup 34 lit + @ 39 lit + c@ 8 lit lshift
    over 34 lit + @ 3A lit + c@ or
    over 28 lit + !
    dup 28 lit + @ over 48 lit + !

    \ Dedup: skip if same source IP + same start chunk + more queued
    0 lit over 3C lit + !
    dup 34 lit + @ 24 lit + @ over 54 lit + @ = if
      dup 28 lit + @ over 58 lit + @ = if
        dup 4 lit + @ 1002 lit + h@
        over 20 lit + @ 1 lit + FFFF lit and <> if
          1 lit over 3C lit + !
        then
      then
    then
    dup 34 lit + @ 24 lit + @ over 54 lit + !
    dup 28 lit + @ over 58 lit + !

    dup 3C lit + @ if
      dup 5C lit + @ if 2D lit putc then
    else

    dup 34 lit + @ 3B lit + c@ 8 lit lshift
    over 34 lit + @ 3C lit + c@ or
    over 40 lit + !
    dup 28 lit + @ 3F lit + over 2C lit + !
    dup 40 lit + @ over 2C lit + @ u< invert if
      dup 2C lit + @ over 40 lit + !
    then
    dup 34 lit + @ 30 lit + c@ 8 lit lshift
    over 34 lit + @ 31 lit + c@ or
    19 lit u< invert if
      dup 34 lit + @ 3D lit + over 44 lit + !
    else
      0 lit over 44 lit + !
    then
    0 lit over 4C lit + !
    0 lit over 50 lit + !
    bld_tmpl
    begin
      dup 28 lit + @ over 40 lit + @ u> invert
    while
      dup 44 lit + @ if
        dup 28 lit + @ over 48 lit + @ - over 2C lit + !
        dup 2C lit + @ 3 lit rshift over 44 lit + @ + c@
        over 2C lit + @ 7 lit and rshift 1 lit and
        if
          dup 50 lit + dup @ 1 lit + swap !
        else
          snd_chnk
          dup 4C lit + dup @ 1 lit + swap !
        then
      else
        snd_chnk
        dup 4C lit + dup @ 1 lit + swap !
      then
      dup 28 lit + dup @ 1 lit + swap !
    repeat
    dup 5C lit + @ if
      "REQ " puts
      dup 48 lit + @ putdec
      ".." puts
      dup 40 lit + @ putdec
      " sent " puts
      dup 4C lit + @ putdec
      " skip " puts
      dup 50 lit + @ putdec
      A lit putc
    then

    then
  then
then
then
;

\ ── dsk_step ( ns -- ns )  advance the background disk-save by ONE non-blocking
\ step (a no-op when ns+0x6C is 0: disk-booted, or the save already finished).
\ Folding this into the event loop is what lets the image-write OVERLAP serving:
\ the old code drained the entire save before serving started.  Single request in
\ flight (state machine over the multi-slot primitives): when no write is
\ outstanding, submit the next sector (sector = ds.subd, which vwrite advances)
\ until ds.nsec sectors are done, then issue one vflush and wait for it.
\ Disk state ds (pointer in ns+0x6C):  +0x40 nsec  +0x44 phase(0 write/1 flush/2 done)
\ +0x48 flush slot id.  (5-slot pipelining is possible but unneeded for a one-time
\ background save; it would need per-slot free tracking against completion order.)
: dsk_step
dup 6C lit + @                       \ ( ns ds )   ds = ns.disk
dup if
  vpoll                              \ reap any completions ( ns ds )
  dup 44 lit + @ 0 lit = if          \ phase WRITING
    dup C lit + @ over 8 lit + @ = if          \ usd == subd  (no write outstanding)
      dup 8 lit + @ over 40 lit + @ u< if      \ subd < nsec  (more to write)
        dup 8 lit + @                                  \ sec = subd
        2 lit pick 14 lit + @ over 9 lit lshift +      \ src = img_base + sec*512
        vwrite drop                                    \ submit next sector ( ns ds )
      else                                             \ all sectors written -> flush
        vflush                                         \ ( ns ds fid )
        dup FFFFFFFF lit <> if
          over 48 lit + !                              \ ds.fid = flush slot
          dup 44 lit + 1 lit swap !                    \ phase = FLUSHING
        else                                           \ writethrough: nothing to flush
          drop
          dup 44 lit + 2 lit swap !                    \ phase = DONE
          over 6C lit + 0 lit swap !                   \ ns.disk = 0 (inert hereafter)
          "disk_save done\n" puts
        then
      then
    then
  else
    dup 44 lit + @ 1 lit = if         \ phase FLUSHING
      dup 48 lit + @ vstat if         \ flush completed?
        dup 44 lit + 2 lit swap !     \ phase = DONE
        over 6C lit + 0 lit swap !    \ ns.disk = 0
        "disk_save done\n" puts
      then
    then
  then
  drop                               \ drop ds -> ( ns )
else
  drop                               \ no disk task -> ( ns )
then
;

\ ── serve1 ( ns -- ns )  service AT MOST one received packet (one pass of the loop) ──
: serve1
rx_poll dup if
  drop                                 \ frame acquired; it lives at ns+0x34
  \ Queue depth check: skip non-ARP packets when backlog > 8
  dup 4 lit + @ 1002 lit + h@
  over 20 lit + @ - FFFF lit and
  8 lit > if
    dup 34 lit + @ 17 lit + c@ 6 lit <> if
      dup 5C lit + @ if 2E lit putc then
    else
      dup 5C lit + @ if
        52 lit putc
        dup 34 lit + @ 16 lit + c@ puthx2
        dup 34 lit + @ 17 lit + c@ puthx2
        20 lit putc
      then
      arp_hand
    then
  else
    dup 5C lit + @ if
      52 lit putc
      dup 34 lit + @ 16 lit + c@ puthx2
      dup 34 lit + @ 17 lit + c@ puthx2
      20 lit putc
    then
    arp_hand
    hnd_famc
  then
  rx_done                              \ recycle the RX buffer + advance rx_last
else
  drop                                 \ no packet this pass
then
;

\ ── evloop ( ns -- )  the unified event loop: each pass advances the background disk
\ save one step AND services one packet, so the two OVERLAP instead of running as two
\ sequential phases (old: drain the whole save, then serve forever).
: evloop
begin
  dsk_step
  serve1
0 lit until
;


\ ══════════════════════════════════════════════════════════════════════════════
\ ── runsrv ( bootsrc port dbg img_base -- )  disk-save (net boot) + serve ──
\ ══════════════════════════════════════════════════════════════════════════════
\ PoW table: build/cache the 16 MiB table in the region reserved by full_node.fam's
\ gp bump (just past the bible).  Off-circuit; the table is anchored by its committed
\ root, so blake2s/checksum here are a fast deterministic expander + cache guard.
\ ──────────────────────────────────────────────────────────────────────────────

\ tbl_load ( ds sectbase mem nsec -- )  blocking: read nsec 512B sectors disk[sectbase..]
\ into mem[..].  tbl_save: same, writing.  One request at a time (vwrite/vread+vwait).
: tbl_load ( ds sectbase mem nsec -- )
  0 lit do
    2 lit pick  2 lit pick i +  2 lit pick i 200 lit * +  vread  vwait  2drop
  loop  2drop drop ;
: tbl_save ( ds sectbase mem nsec -- )
  0 lit do
    2 lit pick  2 lit pick i +  2 lit pick i 200 lit * +  vwrite  vwait  2drop
  loop  2drop                          \ ( ds )
  vflush                               \ FLUSH device cache to backing store (durable
  dup FFFFFFFF lit = if 2drop          \ before we return) -- else a kill loses writes.
  else vwait 2drop then ;              \ 0xFFFFFFFF = writethrough (nothing to wait on)

\ powtbl ( img_base -- )  ensure the PoW table is present in [bible_start..+16MiB).
\ Geometry: img_size=@(img_base-36); table_base=img_base+img_size-BIBLE_SIZE; the
\ seed (bible) is already there; expansion mem = table_base+seedw*4; disk sector base
\ = ceil(img_size/512); expansion = 29487 sectors.  Try disk -> checksum -> on miss,
\ regenerate (texpand, ~min) + save.  ctx: +0 table_base +4 mem +8 nsec +C ds +10 scr.
: powtbl ( img_base -- )
  18 lit alloc swap                    \ ( ctx img_base )
  dup 24 lit - @                       \ ( ctx img_base img_size )
  2dup + 19A373 lit -  3 lit pick !            \ ctx+0 = table_base = ib+is-BIBLE_SIZE
  2 lit pick @ 19A200 lit +  3 lit pick 4 lit + !   \ ctx+4 = mem = table_base + seedw*4
  dup 1FF lit + 9 lit rshift  3 lit pick 8 lit + !  \ ctx+8 = nsec = ceil(img_size/512)
  2drop                                \ ( ctx )
  4C lit alloc                         \ ds ( ctx ds )
  0 lit over 8 lit + !  0 lit over C lit + !  0 lit over 10 lit + !  0 lit over 44 lit + !
  C000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !
  find_blk over !  vblkinit
  over C lit + !                       \ ctx+C = ds ( ctx )
  100 lit alloc over 10 lit + !        \ ctx+10 = scr (>=0x100 for texpand layout)
  \ load expansion from disk, then checksum the whole table
  dup C lit + @  over 8 lit + @  2 lit pick 4 lit + @  732F lit  tbl_load
  dup @  400000 lit  2 lit pick 10 lit + @  9A27A028 lit  tbl_chk
  invert if                            \ checksum miss -> (re)generate + persist
    "powtbl gen\n" puts
    dup @  66880 lit  400000 lit  3 lit pick 10 lit + @  texpand
    dup C lit + @  over 8 lit + @  2 lit pick 4 lit + @  732F lit  tbl_save
  else
    "powtbl ok\n" puts
  then
  drop ;

\ ══════════════════════════════════════════════════════════════════════════════
\ Public entry of the server module.  full_node.fam captures a2/a3/a4 at top level
\ (before any : word call can clobber them) and calls this with ( port dbg img_base ).
: runsrv
\ ( bootsrc port dbg img_base )  -- serve the image IN PLACE.  full_node.fam relocated
\ the fam runtime (RID stack, vars, heap, data stack) above the image, so it stays
\ pristine; the TX descriptors point straight at it (no snapshot copy).
100 lit alloc                  \ net state block ( bootsrc port dbg img_base ns )
tuck 14 lit + !                \ ns+0x14 = img_base (serve directly from the image)
dup 14 lit + @ 24 lit - @ over 18 lit + !   \ ns+0x18 = img_size (bin_size at img_base-36)
swap over 5C lit + !           \ ns+0x5C dbg_flag (a3); ( bootsrc port ns )
swap dup if else drop E99 lit then over 68 lit + !   \ ns+0x68 eff_port (a2, 0 -> 3737)
\ ( bootsrc ns )
0 lit over 1C lit + !          \ ns+0x1C tx_aidx
0 lit over 20 lit + !          \ ns+0x20 rx_last
0 lit over 54 lit + !          \ ns+0x54 last_sip
0 lit over 58 lit + !          \ ns+0x58 last_seq
0 lit over 6C lit + !          \ ns+0x6C ns.disk = 0 (no background save by default)
\ ( bootsrc ns )

\ Bring up virtio-net FIRST, so the node can serve peers WHILE the disk-save (if any)
\ runs concurrently in the same event loop.  Discover device, lay out queues +
\ buffers, init device + RX ring.
find_net over !
AFFF lit alloc FFF lit + FFFFF000 lit and over 4 lit + !   \ rx_q (page-aligned)
dup 4 lit + @ 2000 lit + over 8 lit + !                    \ tx_q   = rx_q + 0x2000
dup 4 lit + @ 4000 lit + over C lit + !                    \ rx_bufs= rx_q + 0x4000
dup 8 lit + @ 200 lit + over 10 lit + !                    \ tx_buf = tx_q + 0x200
net_init
dup @ 100 lit + over 60 lit + 6 lit mcopy                  \ our MAC <- device config
rx_setup
fence_io
dup @ 50 lit + 0 lit swap !                                \ kick RX queue
\ ( bootsrc ns )

\ Disk-save: if NET-booted (bootsrc == 1), build the disk state and KICK OFF a
\ background save -- do NOT drain it here.  evloop's dsk_step advances it one step
\ per pass while serve1 services peers, so the image-write overlaps serving.  Next
\ boot is then a fast disk-boot instead of re-downloading.  ( bootsrc ns )
swap 1 lit = if                \ ( ns )
  "disk_save start\n" puts
  4C lit alloc                   \ disk state ds ( ns ds )
  0 lit over 8 lit + !           \ ds.subd  = 0
  0 lit over C lit + !           \ ds.usd   = 0
  0 lit over 10 lit + !          \ ds.next  = 0
  0 lit over 44 lit + !          \ ds.phase = 0 (WRITING)
  C000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !   \ ds.qb (page-aligned, zeroed)
  find_blk over !                \ ds.dev = virtio-blk dev
  vblkinit
  over 18 lit + @ 1FF lit + 9 lit rshift over 40 lit + !   \ ds.nsec = roundup(img_size,512)
  over 6C lit + !                \ ns.disk = ds  (start the background save) ( ns )
then
\ ( ns )

"serve\n" puts
evloop
;

\ ──────────────────────────────────────────────────────────────────────────────
\ Tests (./tools/fam --test src/fence.fam src/disk.fam src/net.fam src/node_serve.fam).
\ dsk_step is the only NEW logic in this file (serve1's body is byte-identical to the
\ old serve loop, the dispatch words are unchanged).  Drive dsk_step through its full
\ state machine on a FAKE device: a heap ns with ns.disk -> a heap ds, a fake qb + dev,
\ nsec = 2.  We hand-set the device-side used ring to complete each request, exactly
\ like disk.fam's poll_reap test, and assert the state machine advances correctly:
\   submit s0 -> reap -> submit s1 -> reap -> all written -> flush -> reap -> DONE.
\ ──────────────────────────────────────────────────────────────────────────────
Test {
ds_machine {
100 lit alloc                        \ ( ns )
40000000 lit over 14 lit + !         \ ns.img_base (arbitrary; vwrite only stores it)
400 lit over 18 lit + !              \ ns.img_size = 0x400 -> nsec = 2 sectors
0 lit over 5C lit + !                \ dbg off
\ build ds
4C lit alloc                         \ ( ns ds )
100 lit alloc over !                 \ ds.dev (scratch)
200 lit over @ 10 lit + !            \ dev DeviceFeatures = FLUSH offered (writeback)
C000 lit alloc FFF lit + FFFFF000 lit and over 4 lit + !   \ ds.qb
0 lit over 8 lit + !                 \ subd 0
0 lit over C lit + !                 \ usd 0
0 lit over 10 lit + !                \ next 0
0 lit over 44 lit + !                \ phase WRITING
2 lit over 40 lit + !                \ nsec 2
dup 2 lit pick 6C lit + !            \ ns.disk = ds  (keep ( ns ds ))
drop                                 \ ( ns )  work via ns.disk from here

\ pass 1: idle + work -> submit sector 0
dsk_step
dup 6C lit + @ 8 lit + @ 1 lit asrt_eq          \ ds.subd == 1
\ complete write 0: used.ring[0].id = slot-0 head (0), used.idx = 1
dup 6C lit + @ 4 lit + @ 1004 lit + 0 lit swap !
dup 6C lit + @ 4 lit + @ 1002 lit + 1 lit swap h!
\ pass 2: reap (usd->1) + submit sector 1
dsk_step
dup 6C lit + @ C lit + @ 1 lit asrt_eq          \ ds.usd  == 1 (write 0 reaped)
dup 6C lit + @ 8 lit + @ 2 lit asrt_eq          \ ds.subd == 2 (sector 1 submitted)
\ complete write 1: used.ring[1].id = slot-1 head (3), used.idx = 2
dup 6C lit + @ 4 lit + @ 1004 lit + 8 lit + 3 lit swap !
dup 6C lit + @ 4 lit + @ 1002 lit + 2 lit swap h!
\ pass 3: reap (usd->2) -> all written -> issue flush (slot 2), phase FLUSHING
dsk_step
dup 6C lit + @ 44 lit + @ 1 lit asrt_eq         \ phase == FLUSHING
\ complete flush: slot-2 head = 6, used.ring[2].id = 6, used.idx = 3
dup 6C lit + @ 4 lit + @ 1004 lit + 10 lit + 6 lit swap !
dup 6C lit + @ 4 lit + @ 1002 lit + 3 lit swap h!
\ pass 4: reap flush -> phase DONE, ns.disk cleared
dsk_step
6C lit + @ 0 lit asrt_eq             \ ns.disk == 0 (save complete)  ( consumes ns )
}
\ A disk-booted node (ns.disk == 0) makes dsk_step a no-op and leaves ns untouched.
ds_idle {
100 lit alloc                        \ ( ns )
0 lit over 6C lit + !                \ ns.disk = 0
dsk_step
6C lit + @ 0 lit asrt_eq             \ still 0, no crash  ( consumes ns )
}
}
