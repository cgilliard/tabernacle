\ ──────────────────────────────────────────────────────────────────────────────
\ src/node_serve.fam — BIN0/UDP chunk server for full_node.
\
\ Replaces tools/server.py INSIDE the node: answers BIN0 REQ_RANGE packets with
\ chunks of the node's own image, so a running node seeds the binary to peers.
\ Self-contained net path (virtio-net + ARP + IP/UDP + BIN0); zero-copy chunk send
\ (TX queue size 2: desc[0]=header, desc[1]=payload by reference — no per-chunk copy).
\
\ Protocol (matches tools/server.py):
\   REQ_RANGE  "BIN0" 02 start(BE16) end(BE16) [bitmap(8)]
\   RSP_CHUNK  "BIN0" 82 seq(BE16)  data(<=1400)
\
\ Handoff:  a2 = bind port (0 -> 3737)   a3 = debug flag   a4 = img_base (0 -> scan)
\ ──────────────────────────────────────────────────────────────────────────────

\ (No fam variables: the variable region overlaps the loaded image — boot args are
\ carried on the stack and stored into the ns block instead.)

\ ── arg capture: push aN onto the data stack (must run before any : word call) ──
:M _a1 1301C1FF , 2320B100 , ;     \ addi sp,sp,-4 ; sw a1,0(sp)   (boot source)
:M _a2 1301C1FF , 2320C100 , ;     \ addi sp,sp,-4 ; sw a2,0(sp)
:M _a3 1301C1FF , 2320D100 , ;     \ addi sp,sp,-4 ; sw a3,0(sp)
:M _a4 1301C1FF , 2320E100 , ;     \ addi sp,sp,-4 ; sw a4,0(sp)
\ (fence_io / fence_r + the virtio-blk words live in src/disk.fam, compiled first;
\ the net primitives live in src/net.fam, compiled just before this file)

\ ===== output / debug =====
: putnib
dup A lit < if 30 lit + else 37 lit + then putc
;

: puthx2
dup 4 lit rshift F lit and putnib
F lit and putnib
;

: puthx8
dup 1C lit rshift F lit and putnib
dup 18 lit rshift F lit and putnib
dup 14 lit rshift F lit and putnib
dup 10 lit rshift F lit and putnib
dup C  lit rshift F lit and putnib
dup 8  lit rshift F lit and putnib
dup 4  lit rshift F lit and putnib
F lit and putnib
;

: putdec
dup 2710 lit u< invert if
dup 2710 lit / 30 lit + putc
2710 lit %
dup 3E8 lit / 30 lit + putc
3E8 lit %
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup 3E8 lit u< invert if
dup 3E8 lit / 30 lit + putc
3E8 lit %
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup 64 lit u< invert if
dup 64 lit / 30 lit + putc
64 lit %
dup A lit / 30 lit + putc
A lit %
else dup A lit u< invert if
dup A lit / 30 lit + putc
A lit %
then then then then
30 lit + putc
;

\ ===== blocking send wrappers (Stage 1) =====
\ The net device path now lives in src/net.fam as non-blocking primitives
\ (rx_poll / rx_done / tx_post / tx_post2 / tx_busy), compiled just before this
\ file.  node_serve's dispatch still wants a send-and-wait (the BIN0 chunk burst
\ in hnd_famc reuses one TX buffer, so each chunk must drain before the next), so
\ rebuild the old blocking tx_send / tx_send2 from the primitives: post, then spin
\ on tx_busy.  Stage 2 makes the serve loop fully non-blocking and these go away.
: tx_send   tx_post   begin tx_busy 0 lit = until ;
: tx_send2  tx_post2  begin tx_busy 0 lit = until ;

\ ===== BIN0 dispatch =====
: arp_hand
dup 34 lit + @ 16 lit + c@ 8 lit =
over 34 lit + @ 17 lit + c@ 6 lit = and
over 34 lit + @ 1E lit + c@ 0 lit = and
over 34 lit + @ 1F lit + c@ 1 lit = and
if
  dup 10 lit + @
  dup 0 lit swap !
  dup 4 lit + 0 lit swap !
  dup 8 lit + 0 lit swap !
  drop
  dup 34 lit + @ 20 lit +
  over 10 lit + @ A lit +
  6 lit mcopy
  dup 60 lit +
  over 10 lit + @ 10 lit +
  6 lit mcopy
  dup 10 lit + @
  8 lit over 16 lit + c!
  6 lit over 17 lit + c!
  0 lit over 18 lit + c!
  1 lit over 19 lit + c!
  8 lit over 1A lit + c!
  0 lit over 1B lit + c!
  6 lit over 1C lit + c!
  4 lit over 1D lit + c!
  0 lit over 1E lit + c!
  2 lit over 1F lit + c!
  drop
  dup 60 lit +
  over 10 lit + @ 20 lit +
  6 lit mcopy
  dup 34 lit + @ 30 lit +
  over 10 lit + @ 26 lit +
  4 lit mcopy
  dup 34 lit + @ 20 lit +
  over 10 lit + @ 2A lit +
  6 lit mcopy
  dup 34 lit + @ 26 lit +
  over 10 lit + @ 30 lit +
  4 lit mcopy
  34 lit over 24 lit + !
  tx_send
then
;

: bld_tmpl
dup 10 lit + @
dup 0 lit swap !
dup 4 lit + 0 lit swap !
dup 8 lit + 0 lit swap h!
drop
dup 34 lit + @ 10 lit +
over 10 lit + @ A lit +
6 lit mcopy
dup 60 lit +
over 10 lit + @ 10 lit +
6 lit mcopy
dup 10 lit + @
8 lit over 16 lit + c!
0 lit over 17 lit + c!
drop
dup 10 lit + @ 18 lit +
00000045 lit over !
0 lit over 4 lit + !
00001140 lit over 8 lit + !
over 34 lit + @ 28 lit + @ over C lit + !
drop
dup 34 lit + @ 24 lit + @
over 10 lit + @ 28 lit + !
dup 10 lit + @ 2C lit +
over 68 lit + @ dup FF lit and 8 lit lshift swap 8 lit rshift or over h!
over 34 lit + @ 2C lit + h@
over 2 lit + h!
0 lit over 4 lit + !
drop
;

: snd_chnk
dup 28 lit + @
dup A lit lshift
over 8 lit lshift +
over 7 lit lshift +
swap 3 lit lshift -
over 2C lit + !
dup 2C lit + @ over 18 lit + @ u< if
  dup 18 lit + @ over 2C lit + @ -
  dup 578 lit u< if
  else
    drop 578 lit
  then
  over 30 lit + !
  dup 10 lit + @ 34 lit +
  42 lit over c!
  49 lit over 1 lit + c!
  4E lit over 2 lit + c!
  30 lit over 3 lit + c!
  82 lit over 4 lit + c!
  over 28 lit + @ 8 lit rshift FF lit and
  over 5 lit + c!
  over 28 lit + @ FF lit and
  over 6 lit + c!
  drop
  \ Zero-copy: record the chunk's data address (payload_base + file offset) at
  \ ns+3C; tx_send2 hands it to the device as desc[1] -- no memcpy.
  dup 14 lit + @ over 2C lit + @ + over 3C lit + !
  dup 30 lit + @ F lit + over 24 lit + !
  dup 24 lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 30 lit + c!
  dup 24 lit + @ FF lit and
  over 10 lit + @ 31 lit + c!
  dup 24 lit + @ 14 lit + over 2C lit + !
  dup 2C lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 1A lit + c!
  dup 2C lit + @ FF lit and
  over 10 lit + @ 1B lit + c!
  0 lit over 10 lit + @ 22 lit + c!
  0 lit over 10 lit + @ 23 lit + c!
  dup 10 lit + @ 18 lit + ip_csum over 2C lit + !
  dup 2C lit + @ 8 lit rshift FF lit and
  over 10 lit + @ 22 lit + c!
  dup 2C lit + @ FF lit and
  over 10 lit + @ 23 lit + c!
  0 lit over 10 lit + @ 32 lit + c!
  0 lit over 10 lit + @ 33 lit + c!
  tx_send2
then
;

: hnd_famc
dup 34 lit + @ 16 lit + c@ 8 lit =
over 34 lit + @ 17 lit + c@ 0 lit = and
over 34 lit + @ 21 lit + c@ 11 lit = and
if
dup 34 lit + @ 2E lit + c@ 8 lit lshift
over 34 lit + @ 2F lit + c@ or
over 68 lit + @ = if
  dup 34 lit + @ 34 lit + c@ 42 lit =
  over 34 lit + @ 35 lit + c@ 49 lit = and
  over 34 lit + @ 36 lit + c@ 4E lit = and
  over 34 lit + @ 37 lit + c@ 30 lit = and
  over 34 lit + @ 38 lit + c@ 2 lit = and
  if
    dup 34 lit + @ 39 lit + c@ 8 lit lshift
    over 34 lit + @ 3A lit + c@ or
    over 28 lit + !
    dup 28 lit + @ over 48 lit + !

    \ Dedup: skip if same source IP + same start chunk + more queued
    0 lit over 3C lit + !
    dup 34 lit + @ 24 lit + @ over 54 lit + @ = if
      dup 28 lit + @ over 58 lit + @ = if
        dup 4 lit + @ 1002 lit + h@
        over 20 lit + @ 1 lit + FFFF lit and <> if
          1 lit over 3C lit + !
        then
      then
    then
    dup 34 lit + @ 24 lit + @ over 54 lit + !
    dup 28 lit + @ over 58 lit + !

    dup 3C lit + @ if
      dup 5C lit + @ if 2D lit putc then
    else

    dup 34 lit + @ 3B lit + c@ 8 lit lshift
    over 34 lit + @ 3C lit + c@ or
    over 40 lit + !
    dup 28 lit + @ 3F lit + over 2C lit + !
    dup 40 lit + @ over 2C lit + @ u< invert if
      dup 2C lit + @ over 40 lit + !
    then
    dup 34 lit + @ 30 lit + c@ 8 lit lshift
    over 34 lit + @ 31 lit + c@ or
    19 lit u< invert if
      dup 34 lit + @ 3D lit + over 44 lit + !
    else
      0 lit over 44 lit + !
    then
    0 lit over 4C lit + !
    0 lit over 50 lit + !
    bld_tmpl
    begin
      dup 28 lit + @ over 40 lit + @ u> invert
    while
      dup 44 lit + @ if
        dup 28 lit + @ over 48 lit + @ - over 2C lit + !
        dup 2C lit + @ 3 lit rshift over 44 lit + @ + c@
        over 2C lit + @ 7 lit and rshift 1 lit and
        if
          dup 50 lit + dup @ 1 lit + swap !
        else
          snd_chnk
          dup 4C lit + dup @ 1 lit + swap !
        then
      else
        snd_chnk
        dup 4C lit + dup @ 1 lit + swap !
      then
      dup 28 lit + dup @ 1 lit + swap !
    repeat
    dup 5C lit + @ if
      "REQ " puts
      dup 48 lit + @ putdec
      ".." puts
      dup 40 lit + @ putdec
      " sent " puts
      dup 4C lit + @ putdec
      " skip " puts
      dup 50 lit + @ putdec
      A lit putc
    then

    then
  then
then
then
;

: serve
begin
  rx_poll dup if
    drop                                 \ frame acquired; it lives at ns+0x34
    \ Queue depth check: skip non-ARP packets when backlog > 8
    dup 4 lit + @ 1002 lit + h@
    over 20 lit + @ - FFFF lit and
    8 lit > if
      dup 34 lit + @ 17 lit + c@ 6 lit <> if
        dup 5C lit + @ if 2E lit putc then
      else
        dup 5C lit + @ if
          52 lit putc
          dup 34 lit + @ 16 lit + c@ puthx2
          dup 34 lit + @ 17 lit + c@ puthx2
          20 lit putc
        then
        arp_hand
      then
    else
      dup 5C lit + @ if
        52 lit putc
        dup 34 lit + @ 16 lit + c@ puthx2
        dup 34 lit + @ 17 lit + c@ puthx2
        20 lit putc
      then
      arp_hand
      hnd_famc
    then
    rx_done                              \ recycle the RX buffer + advance rx_last
  else
    drop                                 \ no packet this pass
  then
0 lit
until
;


\ ══════════════════════════════════════════════════════════════════════════════
\ ── runsrv ( bootsrc port dbg img_base -- )  disk-save (net boot) + serve ──
\ ══════════════════════════════════════════════════════════════════════════════
\ Public entry of the server module.  full_node.fam captures a2/a3/a4 at top level
\ (before any : word call can clobber them) and calls this with ( port dbg img_base ).
: runsrv
\ ( bootsrc port dbg img_base )  -- serve the image IN PLACE.  full_node.fam relocated
\ the fam runtime (RID stack, vars, heap, data stack) above the image, so it stays
\ pristine; the TX descriptors point straight at it (no snapshot copy).
100 lit alloc                  \ net state block ( bootsrc port dbg img_base ns )
tuck 14 lit + !                \ ns+0x14 = img_base (serve directly from the image)
dup 14 lit + @ 24 lit - @ over 18 lit + !   \ ns+0x18 = img_size (bin_size at img_base-36)
swap over 5C lit + !           \ ns+0x5C dbg_flag (a3); ( bootsrc port ns )
swap dup if else drop E99 lit then over 68 lit + !   \ ns+0x68 eff_port (a2, 0 -> 3737)
\ ( bootsrc ns )
0 lit over 1C lit + !          \ ns+0x1C tx_aidx
0 lit over 20 lit + !          \ ns+0x20 rx_last
0 lit over 54 lit + !          \ ns+0x54 last_sip
0 lit over 58 lit + !          \ ns+0x58 last_seq

\ Disk-save: if NET-booted (bootsrc == 1), write the image to disk so the next boot
\ is a fast disk-boot instead of re-downloading.  ( bootsrc ns )
swap 1 lit = if                \ ( ns )
  "disk_write\n" puts
  40 lit alloc                   \ disk state ds ( ns ds )
  0 lit over 8 lit + !           \ ds.subd = 0
  0 lit over C lit + !           \ ds.usd  = 0
  0 lit over 10 lit + !          \ ds.next = 0
  5000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !   \ ds.qb (page-aligned, zeroed)
  find_blk over !                \ ds.dev = virtio-blk dev
  vblkinit
  \ STANDALONE drive loop: write sectors 0..nsec-1, one at a time, where the next
  \ sector to write IS ds.subd (vwrite advances it) and nsec = roundup(img_size,512).
  \ vwrite + vwait keeps a single request in flight; Stage 2 folds vpoll into the
  \ serve loop (and can pipeline up to 5 slots) so the write overlaps with serving.
  begin
    dup 8 lit + @                              \ sec = subd            ( ns ds sec )
    2 lit pick 18 lit + @ 1FF lit + 9 lit rshift  \ nsec                ( ns ds sec nsec )
    u<                                         \ sec < nsec ?          ( ns ds flag )
  while
    dup 8 lit + @                              \ sec                   ( ns ds sec )
    2 lit pick 14 lit + @ over 9 lit lshift +  \ src = img_base+sec*512 ( ns ds sec src )
    vwrite                                     \ ( ns ds id )
    vwait drop                                 \ drive to completion, drop id ( ns ds )
  repeat
  vflush                          \ vblkinit may have negotiated writeback -> force the
  dup FFFFFFFF lit <> if vwait drop else drop then   \ image durable before next boot
  drop                           \ ( ns )  drop ds
  "disk_write done\n" puts
then
\ ( ns )

\ Discover virtio-net, lay out queues + buffers, init device + RX ring.
find_net over !
AFFF lit alloc FFF lit + FFFFF000 lit and over 4 lit + !   \ rx_q (page-aligned)
dup 4 lit + @ 2000 lit + over 8 lit + !                    \ tx_q   = rx_q + 0x2000
dup 4 lit + @ 4000 lit + over C lit + !                    \ rx_bufs= rx_q + 0x4000
dup 8 lit + @ 200 lit + over 10 lit + !                    \ tx_buf = tx_q + 0x200
net_init
dup @ 100 lit + over 60 lit + 6 lit mcopy                  \ our MAC <- device config
rx_setup
fence_io
dup @ 50 lit + 0 lit swap !                                \ kick RX queue
"serve\n" puts
serve
;
