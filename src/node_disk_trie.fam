\ ──────────────────────────────────────────────────────────────────────────────
\ src/node_disk_trie.fam — the COW trie (doc/COW_TRIE.md §10), 32-byte key -> 32-byte
\ value, built on the transactional page store in src/node_disk_store.fam.
\
\ Compiled after src/fence.fam src/disk.fam src/node_disk_store.fam.
\
\ NODE FORMATS (each is one 512-B page):
\   internal node : 128 tagged child pointers, indexed by 7 key bits per level.
\                   pointer: bit31 = leaf flag, bits0..30 = page# (0 = empty slot).
\   leaf bucket   : count(4) then up to CAP entries of key(0x20)+value(0x20)=0x40.
\                   CAP = (0x200-4)/0x40 = 7.
\   trie_root (wmeta+8) is itself such a tagged pointer (0 = empty trie).
\
\ Keys are navigated MSB-first (byte 0 first), 7 bits per level via a 16-bit window
\ so a 7-bit field straddling a byte boundary still reads correctly.  A bucket splits
\ only when it overflows; uniform keys keep it shallow (§10, §15).
\
\ Reads use the BLOCKING bp_get path for now (correctness first); the async fiber
\ re-thread is chunk 5 (§6).  Writes are copy-on-write: each touched page on the
\ descent path is copied to a fresh page and the root re-pointed, so the committed
\ root stays valid until the meta flips (§9, §11).
\ ──────────────────────────────────────────────────────────────────────────────

\ ── tag helpers for child pointers ──
: is_leaf  80000000 lit and ;          \ ( ptr -- flag )  nonzero if leaf
: pg_of    7FFFFFFF lit and ;          \ ( ptr -- page )  strip the tag
: tg_leaf  80000000 lit or ;           \ ( page -- ptr )  tag as a leaf pointer

\ ── cp8 ( src dst -- )  copy 32 bytes (8 words) — used for both keys and values ──
: cp8
8 lit 0 lit do
  over i 4 lit * + @ over i 4 lit * + !
loop
2drop
;

\ ── keq ( ka kb -- flag )  true (0xFFFFFFFF) iff the two 32-byte keys are equal ──
: keq
FFFFFFFF lit                           \ ( ka kb acc )
8 lit 0 lit do
  2 lit pick i 4 lit * + @             \ ka[i]
  2 lit pick i 4 lit * + @             \ kb[i]
  = and
loop
nip nip
;

\ ── kbyte ( keyp idx -- b )  key byte, or 0 past the 32-byte key (guards deep levels) ──
: kbyte
dup 20 lit u< if + c@ else 2drop 0 lit then
;

\ ── tr_slot ( keyp level -- slot )  the 7 key bits at this level (0..127) ──
: tr_slot
7 lit *                                \ bitoff = level*7   ( keyp bitoff )
dup 8 lit / swap 8 lit %               \ ( keyp byte intra )
2 lit pick 2 lit pick kbyte            \ hi = key[byte]      ( keyp byte intra hi )
3 lit pick 3 lit pick 1 lit + kbyte    \ lo = key[byte+1]    ( keyp byte intra hi lo )
swap 8 lit lshift or                   \ w = hi<<8 | lo      ( keyp byte intra w )
over 9 lit swap - rshift               \ w >> (9 - intra)
7F lit and                             \ & 0x7F = slot
nip nip nip
;

\ ── bk_find ( bktp keyp -- valp|0 )  scan a leaf bucket for keyp; return the address
\ of its 32-byte value, or 0 if absent ──
: bk_find
0 lit                                  \ ( bktp keyp res )
2 lit pick @ 0 lit do                  \ for i in 0..count-1
  dup 0= if                            \ not found yet
    2 lit pick 4 lit + i 40 lit * +    \ entry key addr = bktp+4+i*0x40
    2 lit pick keq if                  \ entry key == keyp ?
      2 lit pick 4 lit + i 40 lit * + 20 lit +    \ value addr = key addr + 0x20
      nip                              \ res := value addr
    then
  then
loop
nip nip
;

\ ── tr_get ( eng keyp valp -- found )  look keyp up; on a hit copy its 32-byte value
\ into valp and return true, else return false.  Descends internal nodes, then scans
\ the leaf bucket.  Each page is pinned for the step and unpinned before descending. ──
: tr_get
2 lit pick wroot@                      \ ptr = working trie root   ( eng keyp valp ptr )
dup 0= if
  2drop 2drop 0 lit                    \ empty trie -> not found
else
  0 lit swap                           \ level=0 ; ( eng keyp valp level ptr )
  begin dup is_leaf 0= over 0 lit <> and while   \ internal AND non-empty -> descend
    4 lit pick @ over pg_of bp_get     \ framep = bp_get(eng.bp, pg_of(ptr)) ; ( ... ptr bp framep )
    5 lit pick 4 lit pick tr_slot      \ slot = tr_slot(keyp, level)  ( ... ptr bp framep slot )
    over swap 4 lit * + @              \ child = framep[slot]         ( ... ptr bp framep child )
    swap bp_unpin swap drop            \ unpin framep, drop bp        ( ... ptr child )
    nip                                \ drop old ptr                 ( eng keyp valp level child )
    swap 1 lit + swap                  \ level++
  repeat
  \ ptr is a leaf pointer, or 0 (empty slot).  ( eng keyp valp level ptr )
  dup 0= if
    drop 2drop 2drop 0 lit             \ empty leaf slot -> not found
  else
    pg_of 4 lit pick @ swap bp_get     \ framep = bp_get(eng.bp, pg_of(ptr)) ; ( ... level bp framep )
    dup 5 lit pick bk_find             \ vp = bk_find(framep, keyp), keeping framep ( ... bp framep vp )
    dup if
      4 lit pick cp8                   \ hit: copy the 32-byte value into valp
      FFFFFFFF lit                     \ result = true
    else
      drop 0 lit                       \ miss: result = false
    then
    swap bp_unpin swap drop swap drop nip nip nip   \ unpin frame, drop bp/level/valp/keyp/eng
  then
then
;

\ ══════════════════════════════════════════════════════════════════════════════
\ WRITE PATH (copy-on-write).  A pre-allocated TRIE CONTEXT `tc` carries the state
\ a write needs so the data stack stays shallow (COW descent + ascend is where stack
\ juggling otherwise gets error-prone).  tc is allocated ONCE by tr_init and its
\ pointer lives in the reserved eng+0x10 slot — no per-op alloc, no change to the
\ store layer.
\
\ TRIE CONTEXT `tc` (0x154 bytes):
\   tc+0x00 eng   tc+0x04 bp   tc+0x08 depth   tc+0x0C keyp   tc+0x10 valp
\   tc+0x14 path[]  — per descended level: page(4) + slot(4) = 8 B (40 levels)
\ ══════════════════════════════════════════════════════════════════════════════

: bcap  7 lit ;                        \ leaf bucket capacity = (0x200-4)/0x40
: eng_bp  @ ;                          \ ( eng -- bp )
: eng_tc  10 lit + @ ;                 \ ( eng -- tc )

\ ── tr_init ( eng -- )  allocate the trie context once; stash eng + bp; publish tc
\ in the reserved eng+0x10 slot.  Call after eng_init / mt_boot, before any tr_put. ──
: tr_init
154 lit alloc                          \ ( eng tc )
swap over !                            \ tc.eng = eng ; ( tc )
dup @ eng_bp over 4 lit + !            \ tc.bp = eng.bp
dup @ 10 lit + over swap !             \ eng+0x10 = tc
drop
;

\ ── bk_new ( eng keyp valp -- ptr )  fresh leaf bucket holding the single entry;
\ returns its tagged leaf pointer ──
: bk_new
2 lit pick pg_new                      \ ( eng keyp valp eng page )
swap @ over bp_alloc                   \ ( eng keyp valp page bp framep )
1 lit over !                           \ count = 1
4 lit pick over 4 lit + cp8            \ cp8(keyp, framep+4)
3 lit pick over 24 lit + cp8           \ cp8(valp, framep+0x24)
bp_unpin drop tg_leaf nip nip nip
;

\ ── bk_ins ( bktp keyp valp -- )  insert or update (keyp -> valp) in an in-RAM
\ bucket.  Caller guarantees room (count < CAP) for a NEW key. ──
: bk_ins
2 lit pick 2 lit pick bk_find          \ ( bktp keyp valp vp )
dup if
  cp8 2drop                            \ update value in place; drop keyp, bktp
else
  drop                                 \ ( bktp keyp valp )
  2 lit pick @                         \ count ( bktp keyp valp count )
  3 lit pick 4 lit + over 40 lit * +   \ keydst = bktp+4+count*0x40
  3 lit pick swap cp8                  \ cp8(keyp, keydst)
  3 lit pick 4 lit + over 40 lit * + 20 lit +   \ valdst
  2 lit pick swap cp8                  \ cp8(valp, valdst)
  1 lit + 3 lit pick !                 \ count++ at bktp
  2drop drop
then
;

\ ── in_cow ( tc oldpage slot childptr -- newpage )  copy-on-write one internal node:
\ allocate a fresh page, copy the old 128 pointers in, set slot -> childptr, return
\ the new (untagged) page number. ──
: in_cow
3 lit pick @ pg_new nip                \ newpage ; ( tc oldpage slot childptr newpage )
4 lit pick 4 lit + @ over bp_alloc     \ ( ... newpage bp nf )
over 6 lit pick bp_get                 \ of = bp_get(bp, oldpage) ; ( ... bp nf bp of )
dup 3 lit pick mt_cp                   \ copy old node -> nf (mt_cp consumes copies; keep of)
bp_unpin drop                          \ unpin of, drop bp ; ( ... newpage bp nf )
dup 5 lit pick 4 lit * + 4 lit pick swap !   \ nf[slot] = childptr
bp_unpin drop                          \ unpin nf, drop bp ; ( tc oldpage slot childptr newpage )
nip nip nip nip                        \ ( newpage )
;

\ ── bk_pch ( tc intframe slot keyp valp -- )  place (keyp,valp) into the child bucket
\ at intframe[slot], creating it if the slot is empty (used by bk_split).  Assumes the
\ child won't overflow (cascade splits are a deferred refinement, §10). ──
: bk_pch
3 lit pick 3 lit pick 4 lit * + @      \ cur = intframe[slot] ( tc intframe slot keyp valp cur )
dup 0= if
  drop                                 \ empty slot ; ( tc intframe slot keyp valp )
  4 lit pick @ 2 lit pick 2 lit pick bk_new   \ childptr = bk_new(eng,keyp,valp)
  4 lit pick 4 lit pick 4 lit * + !    \ intframe[slot] = childptr
  2drop 2drop drop                     \ ( )
else
  5 lit pick 4 lit + @ over pg_of bp_get      \ childframe = bp_get(bp, pg_of(cur)) ( ... cur bp cf )
  dup 5 lit pick 5 lit pick bk_ins     \ bk_ins(cf, keyp, valp)
  bp_unpin                             \ unpin cf ( tc intframe slot keyp valp cur bp )
  2drop 2drop 2drop drop               \ ( )
then
;

\ ── bk_split ( tc oldbktp -- intptr )  the full bucket plus the new entry
\ (tc.keyp/tc.valp) overflowed: build an internal node at level tc.depth and scatter
\ all CAP+1 entries into child buckets.  Returns the new (untagged) internal pointer. ──
: bk_split
over @ pg_new nip                      \ intpage ( tc oldbktp intpage )
2 lit pick 4 lit + @ over bp_alloc     \ ( tc oldbktp intpage bp intframe )
dup mt_z                               \ all 128 child slots empty
bcap 0 lit do
  4 lit pick                           \ tc
  1 lit pick                           \ intframe
  5 lit pick 4 lit + i 40 lit * +      \ ekey (for slot)
  2 lit pick 8 lit + @ tr_slot         \ slot = tr_slot(ekey, tc.depth)
  6 lit pick 4 lit + i 40 lit * +      \ keyp = ekey
  dup 20 lit +                         \ valp = ekey+0x20
  bk_pch
loop
4 lit pick 1 lit pick                  \ tc intframe (for the new entry)
1 lit pick dup C lit + @ swap 8 lit + @ tr_slot   \ slot = tr_slot(tc.keyp, tc.depth)
2 lit pick C lit + @                   \ keyp = tc.keyp
3 lit pick 10 lit + @                  \ valp = tc.valp
bk_pch
bp_unpin drop                          \ unpin intframe, drop bp
nip nip                                \ ( intpage )
;

\ ── tr_put ( eng keyp valp -- )  insert or update keyp -> valp, copy-on-write.  The
\ committed root stays valid until the meta flips; this only mutates the WORKING root
\ (call inside a txn, then commit).  Requires tr_init to have run. ──
: tr_put
\ stash keyp/valp/depth into the (pre-allocated) trie context
2 lit pick eng_tc                      \ ( eng keyp valp tc )
swap over 10 lit + !                   \ tc.valp = valp ; ( eng keyp tc )
swap over C lit + !                    \ tc.keyp = keyp ; ( eng tc )
0 lit over 8 lit + !                   \ tc.depth = 0
nip                                    \ ( tc )
\ phase 1: descend, recording the internal path
dup @ wroot@                           \ ptr = working root ( tc ptr )
begin dup is_leaf 0= over 0 lit <> and while
  over 4 lit + @ over pg_of bp_get     \ framep = bp_get(bp, pg_of(ptr)) ( tc ptr bp framep )
  3 lit pick dup C lit + @ swap 8 lit + @ tr_slot   \ slot ( ... framep slot )
  over over 4 lit * + @                \ child = framep[slot] ( ... framep slot child )
  5 lit pick dup 8 lit + @ 8 lit * + 14 lit +       \ pe = tc+0x14+depth*8 ( ... child pe )
  5 lit pick pg_of over !              \ pe.page = pg_of(ptr)
  2 lit pick over 4 lit + !            \ pe.slot = slot
  drop                                 \ ( tc ptr bp framep slot child )
  nip                                  \ drop slot ( tc ptr bp framep child )
  swap bp_unpin swap drop              \ unpin framep, drop bp ( tc ptr child )
  nip                                  \ drop old ptr ( tc child )
  over 8 lit + dup @ 1 lit + swap !    \ tc.depth++
repeat
\ phase 2: build the new child at the target ( tc ptr )
dup 0= if
  drop                                 \ empty target
  dup @ over C lit + @ 2 lit pick 10 lit + @ bk_new   \ ( tc newchild )
else
  over 4 lit + @ over pg_of bp_get     \ oldbktp = bp_get(bp, pg_of(ptr)) ( tc ptr bp oldbktp )
  dup 4 lit pick C lit + @ bk_find     \ vp ( tc ptr bp oldbktp vp )
  over @ bcap u< or                    \ exists OR count<CAP ? ( tc ptr bp oldbktp flag )
  if
    3 lit pick @ pg_new nip            \ newpage ( tc ptr bp oldbktp newpage )
    4 lit pick 4 lit + @ over bp_alloc \ ( ... newpage bp nf )
    3 lit pick over mt_cp              \ copy oldbktp -> nf
    dup 7 lit pick C lit + @ 8 lit pick 10 lit + @ bk_ins   \ bk_ins(nf, keyp, valp)
    bp_unpin drop                      \ unpin nf, drop bp ( tc ptr bp oldbktp newpage )
    tg_leaf                            \ newchild = leaf ptr ( tc ptr bp oldbktp newchild )
  else
    3 lit pick over bk_split           \ newchild = internal ptr ( tc ptr bp oldbktp newchild )
  then
  swap bp_unpin swap drop nip          \ unpin oldbktp, drop bp/ptr ( tc newchild )
then
\ phase 3: ascend, COWing each recorded internal node ( tc newchild )
over 8 lit + @
dup 0 lit > if
  0 lit do
    over 8 lit + @ 1 lit - i -         \ level = depth-1-i ( tc newchild level )
    8 lit * 14 lit + 2 lit pick +      \ pe = tc+0x14+level*8 ( tc newchild pe )
    2 lit pick                         \ tc
    1 lit pick @                       \ page = pe.page
    2 lit pick 4 lit + @               \ slot = pe.slot
    4 lit pick                         \ childptr = current newchild
    in_cow                             \ newpage ( tc newchild pe newpage )
    nip nip                            \ ( tc newpage )
  loop
else
  drop
then
\ phase 4: install the new root
over @ swap wroot! drop
;

\ ══════════════════════════════════════════════════════════════════════════════
\ ASYNC LOOKUP FIBERS (doc/COW_TRIE.md §6) — a non-blocking, resumable form of the
\ read path so a lookup yields to the event loop instead of spinning on a page-in.
\ The trie descent is recast as a state machine over the pool's non-blocking
\ primitives (bp_probe / bp_start / bp_ready):  advance as far as cache hits allow,
\ and when a page must be read from disk, issue the read and RETURN — resume on a
\ later call once the sector lands.  Many independent fibers (one per nonce/peer)
\ overlap to fill the disk's 5 in-flight slots; a single descent stays serial.
\
\ Slot assignment: each fiber owns a FIXED disk slot (lk.slot), set into ds.next
\ before bp_start so its vread uses that slot — the simple realization of the §6
\ 5-slot ownership table for up to 5 concurrent fibers (a dynamic free-list would
\ generalize it).  Assumes a clean pool on the read path (no dirty writeback to
\ block on); the writer/commit path is separate.
\
\ FIBER CONTEXT `lk` (0x28 bytes, caller-allocated):
\   +0x00 keyp   +0x04 valp   +0x08 ptr (current tagged node)   +0x0C level
\   +0x10 framep (pinned current frame)   +0x14 slot (this fiber's disk slot)
\   +0x18 phase (0 DESCEND, 1 WAIT, 2 PROCESS, 3 DONE)   +0x1C result (found?)
\   +0x20 eng
\ ══════════════════════════════════════════════════════════════════════════════

: lk_bp  20 lit + @ @ ;                 \ ( lk -- bp )   lk.eng.bp
: lk_ds  20 lit + @ @ @ ;               \ ( lk -- ds )   lk.eng.bp.ds

\ ── lk_start ( lk eng keyp valp slotid -- )  arm a fiber on a key ──
: lk_start
4 lit pick 14 lit + !                    \ lk.slot = slotid
3 lit pick 4 lit + !                     \ lk.valp = valp
2 lit pick !                             \ lk.keyp = keyp
over 20 lit + !                          \ lk.eng = eng
dup 20 lit + @ wroot@ over 8 lit + !     \ lk.ptr = wroot@(eng)
0 lit over C lit + !                     \ level = 0
0 lit over 18 lit + !                    \ phase = DESCEND
0 lit over 10 lit + !                    \ framep = 0
drop
;

\ ── lk_desc ( lk -- lk )  DESCEND: acquire the page for the current ptr.  Cache hit
\ -> PROCESS now; miss -> issue the read on the fiber's slot and go WAIT; ptr=0 -> DONE ──
: lk_desc
dup 8 lit + @ 0 lit = if
  0 lit over 1C lit + !                  \ result = not found
  3 lit over 18 lit + !                  \ phase = DONE
else
  dup lk_bp over 8 lit + @ pg_of bp_probe       \ ( lk bp framep|0 )
  dup if
    2 lit pick 10 lit + !                \ lk.framep = framep ; ( lk bp )
    drop
    2 lit over 18 lit + !                \ phase = PROCESS
  else
    2drop                                \ ( lk )
    dup 14 lit + @ over lk_ds 10 lit + ! \ ds.next = lk.slot (pin this fiber's slot)
    dup lk_bp over 8 lit + @ pg_of bp_start       \ ( lk bp framep )
    2 lit pick 10 lit + !                \ lk.framep = framep ; ( lk bp )
    drop
    1 lit over 18 lit + !                \ phase = WAIT
  then
then
;

\ ── lk_wait ( lk -- lk )  WAIT: poll the in-flight read; on completion -> PROCESS ──
: lk_wait
dup lk_bp over 10 lit + @ bp_ready       \ ( lk bp framep done? )
if
  2drop
  2 lit over 18 lit + !                  \ phase = PROCESS
else
  2drop
then
;

\ ── lk_proc ( lk -- lk )  PROCESS: the current frame is valid.  Leaf -> scan bucket,
\ copy value, DONE.  Internal -> read child, unpin, descend one level ──
: lk_proc
dup 8 lit + @ is_leaf if
  dup 10 lit + @ over @ bk_find          \ vp = bk_find(framep, keyp) ; ( lk vp )
  dup if
    over 4 lit + @ cp8                    \ copy value into lk.valp
    1 lit over 1C lit + !                 \ result = found
  else
    drop  0 lit over 1C lit + !           \ result = not found
  then
  dup 10 lit + @ bp_unpin                 \ unpin frame
  3 lit over 18 lit + !                   \ phase = DONE
else
  dup @ over C lit + @ tr_slot            \ slot = tr_slot(keyp, level)
  over 10 lit + @ swap 4 lit * + @        \ child = framep[slot]
  over 10 lit + @ bp_unpin                \ unpin frame
  over 8 lit + !                          \ lk.ptr = child
  dup C lit + dup @ 1 lit + swap !        \ level++
  0 lit over 18 lit + !                   \ phase = DESCEND
then
;

\ ── lk_step ( lk -- lk done? )  advance the fiber by ONE non-blocking transition;
\ returns true once the lookup has finished (result in lk.result, value in lk.valp) ──
: lk_step
dup 18 lit + @ 0 lit = if lk_desc else
dup 18 lit + @ 1 lit = if lk_wait else
dup 18 lit + @ 2 lit = if lk_proc else
then then then
dup 18 lit + @ 3 lit =
;

\ ── lk_run ( lk -- )  BLOCKING drive of one fiber to completion (boot/test path; the
\ live node calls lk_step once per fiber per evloop pass instead) ──
: lk_run  begin lk_step until drop ;
