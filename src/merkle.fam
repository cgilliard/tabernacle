\ ──────────────────────────────────────────────────────────────────────────────
\ src/merkle.fam — binary Merkle path verification over Poseidon2-BabyBear-16.
\
\ Node = compress2(left,right) = pos2_i([left(8),right(8)])[0..8] (= wotsp's
\ wcompr2); leaves and digests are 8 BabyBear words (32 B). A path is `n`
\ sibling digests packed contiguously (sibs[i] at sibs+i*0x20) plus an index
\ `idx`: bit i of idx is the dir at level i — 0 = current is LEFT child
\ (sibling on the right): parent = compress2(cur,sib); 1 = current is RIGHT
\ child (sibling on the left): parent = compress2(sib,cur). Matches pmmr.rs
\ membership dir bits, so this verifies both FRI/LMCS openings and PMMR
\ subtree paths. Reuses cp8/cmp8/wcompr2 from wotsp.fam (compile AFTER it).
\ NO alloc-per-call: caller passes perm scratch — mrkroot scr>=0x80,
\ mrkvrfy scr>=0xA0 (uses scr+0x80 as the recomputed-root buffer). fam HEX.
\ Python ref + vectors: tmp/pos2/mref.py.
\ ──────────────────────────────────────────────────────────────────────────────

: mrkroot ( leaf sibs idx n out scr -- )   \ out = root after walking n levels
  5 lit pick 2 lit pick cp8                \ leaf -> out
  2 lit pick 0 lit > if                    \ n > 0
    2 lit pick 0 lit do                    \ i = 0 .. n-1
      3 lit pick i rshift 1 lit and        \ bit = (idx>>i)&1
      if                                   \ right child: compress2(sib,out)->out
        4 lit pick i 5 lit lshift +        \ sib = sibs + i*0x20
        2 lit pick 3 lit pick 3 lit pick wcompr2
      else                                 \ left child: compress2(out,sib)->out
        1 lit pick                         \ out
        5 lit pick i 5 lit lshift +        \ sib
        1 lit pick 3 lit pick wcompr2
      then
    loop
  then
  2drop 2drop 2drop ;

: mrkvrfy ( leaf sibs idx n root scr -- f )   \ f = (recomputed root == root); scr>=0xA0
  dup 80 lit +                                \ out = scr + 0x80
  6 lit pick 6 lit pick 6 lit pick 6 lit pick 4 lit pick 6 lit pick mrkroot
  0 lit pick 3 lit pick cmp8                  \ cmp8(out, root)
  nip nip nip nip nip nip nip ;               \ leave only f

Test {
mrk0 {
  20 lit alloc  00000029 lit over !  0000002A lit over 4 lit + !  0000002B lit over 8 lit + !  0000002C lit over C lit + !  0000002D lit over 10 lit + !  0000002E lit over 14 lit + !  0000002F lit over 18 lit + !  00000030 lit over 1C lit + !
  60 lit alloc  00000021 lit over !  00000022 lit over 4 lit + !  00000023 lit over 8 lit + !  00000024 lit over C lit + !  00000025 lit over 10 lit + !  00000026 lit over 14 lit + !  00000027 lit over 18 lit + !  00000028 lit over 1C lit + !
  608D1F0D lit over 20 lit + !  6D582DC1 lit over 24 lit + !  2224B1CB lit over 28 lit + !  343E9F3F lit over 2C lit + !  533813B4 lit over 30 lit + !  14C74AE1 lit over 34 lit + !  09990528 lit over 38 lit + !  0D6BD8E5 lit over 3C lit + !
  30789209 lit over 40 lit + !  17CBC4EA lit over 44 lit + !  36861CA9 lit over 48 lit + !  420F11A9 lit over 4C lit + !  2575E527 lit over 50 lit + !  55D76841 lit over 54 lit + !  051B5EF2 lit over 58 lit + !  327B2AFF lit over 5C lit + !
  20 lit alloc  0730DE8B lit over !  0806F1BA lit over 4 lit + !  4EE1C983 lit over 8 lit + !  75F9F0FF lit over C lit + !  41A11D86 lit over 10 lit + !  54C12392 lit over 14 lit + !  4B4D9364 lit over 18 lit + !  48944C92 lit over 1C lit + !
  A0 lit alloc
  \ stack: leaf sibs root scr
  \ 1) mrkroot direct: compute into out2, compare to root
  20 lit alloc
  4 lit pick 4 lit pick 5 lit 3 lit 4 lit pick 6 lit pick mrkroot
  0 lit pick 3 lit pick cmp8 1 lit asrt_eq
  drop
  \ 2) mrkvrfy on the good path -> 1
  3 lit pick 3 lit pick 5 lit 3 lit 5 lit pick 5 lit pick mrkvrfy 1 lit asrt_eq
  \ 3) tamper a sibling -> 0
  2 lit pick dup @ 1 lit + swap !
  3 lit pick 3 lit pick 5 lit 3 lit 5 lit pick 5 lit pick mrkvrfy 0 lit asrt_eq
  2drop 2drop
}
}
