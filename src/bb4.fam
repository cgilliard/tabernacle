\ ──────────────────────────────────────────────────────────────────────────────
\ src/bb4.fam — BabyBear quartic extension F_p[x]/(x^4 - 11), W=11 (BB4).
\
\ An EF element is 4 contiguous BabyBear words (16 B): a0 + a1·x + a2·x^2 + a3·x^3.
\ This is the FRI/challenge field (degree-4 over BabyBear, ~124-bit). Built on
\ babybear.fam (fadd/fsub/fneg/fmul_i/fsqr). NO alloc-per-call: pointer args; the
\ multiply/inverse take a caller scratch (>=0x40 B) used as a fixed-offset
\ workspace (a,b copies + result), anchored via dup/over. Python ref + vectors:
\ tmp/pos2/bb4ref.py. Spec is defined here (constraint-first; no prover yet).
\ ──────────────────────────────────────────────────────────────────────────────

: cp4   ( src dst -- )  4 lit 0 lit do  over i 4 lit * + @  over i 4 lit * + !  loop  2drop ;
: cmp4  ( a b -- f )    1 lit  4 lit 0 lit do  2 lit pick i 4 lit * + @  2 lit pick i 4 lit * + @  =  and  loop  nip nip ;

: bb4add ( a b c -- )
  4 lit 0 lit do  2 lit pick i 4 lit * + @  2 lit pick i 4 lit * + @  fadd  1 lit pick i 4 lit * + !  loop  2drop drop ;
: bb4sub ( a b c -- )
  4 lit 0 lit do  2 lit pick i 4 lit * + @  2 lit pick i 4 lit * + @  fsub  1 lit pick i 4 lit * + !  loop  2drop drop ;
: bb4smul ( a s c -- )
  4 lit 0 lit do  2 lit pick i 4 lit * + @  2 lit pick fmul_i  1 lit pick i 4 lit * + !  loop  2drop drop ;

: fpow ( a e -- a^e )   \ square-and-multiply, MSB first, 32-bit e
  1 lit
  20 lit 0 lit do
    fsqr
    1 lit pick  1F lit i -  rshift  1 lit and
    if  2 lit pick fmul_i  then
  loop
  nip nip ;
: finv ( a -- 1/a )  77FFFFFF lit fpow ;

: bb4mul ( a b c scr -- )   \ c = a*b ; scr>=0x40
  3 lit pick over cp4
  2 lit pick over 10 lit + cp4
  dup 0 lit + @  over 10 lit + @  fmul_i  over 20 lit + !
  dup 4 lit + @  over 1C lit + @  fmul_i  B lit fmul_i  over 20 lit + @  fadd  over 20 lit + !
  dup C lit + @  over 14 lit + @  fmul_i  B lit fmul_i  over 20 lit + @  fadd  over 20 lit + !
  dup 8 lit + @  over 18 lit + @  fmul_i  B lit fmul_i  over 20 lit + @  fadd  over 20 lit + !
  dup 0 lit + @  over 14 lit + @  fmul_i  over 24 lit + !
  dup 4 lit + @  over 10 lit + @  fmul_i  over 24 lit + @  fadd  over 24 lit + !
  dup 8 lit + @  over 1C lit + @  fmul_i  B lit fmul_i  over 24 lit + @  fadd  over 24 lit + !
  dup C lit + @  over 18 lit + @  fmul_i  B lit fmul_i  over 24 lit + @  fadd  over 24 lit + !
  dup 0 lit + @  over 18 lit + @  fmul_i  over 28 lit + !
  dup 8 lit + @  over 10 lit + @  fmul_i  over 28 lit + @  fadd  over 28 lit + !
  dup 4 lit + @  over 14 lit + @  fmul_i  over 28 lit + @  fadd  over 28 lit + !
  dup C lit + @  over 1C lit + @  fmul_i  B lit fmul_i  over 28 lit + @  fadd  over 28 lit + !
  dup 0 lit + @  over 1C lit + @  fmul_i  over 2C lit + !
  dup C lit + @  over 10 lit + @  fmul_i  over 2C lit + @  fadd  over 2C lit + !
  dup 4 lit + @  over 18 lit + @  fmul_i  over 2C lit + @  fadd  over 2C lit + !
  dup 8 lit + @  over 14 lit + @  fmul_i  over 2C lit + @  fadd  over 2C lit + !
  dup 20 lit +  2 lit pick cp4
  2drop 2drop ;

: bb4inv ( a c scr -- )     \ c = a^-1 ; scr>=0x40
  2 lit pick over cp4
  dup 0 lit + @  over 0 lit + @  fmul_i  over 10 lit + !
  dup 8 lit + @  over 8 lit + @  fmul_i  B lit fmul_i  over 10 lit + @  fadd  over 10 lit + !
  dup 4 lit + @  over C lit + @  fmul_i  16 lit fmul_i  fneg  over 10 lit + @  fadd  over 10 lit + !
  dup 0 lit + @  over 8 lit + @  fmul_i  2 lit fmul_i  over 14 lit + !
  dup 4 lit + @  over 4 lit + @  fmul_i  fneg  over 14 lit + @  fadd  over 14 lit + !
  dup C lit + @  over C lit + @  fmul_i  B lit fmul_i  fneg  over 14 lit + @  fadd  over 14 lit + !
  dup 10 lit + @  over 10 lit + @  fmul_i  over 18 lit + !
  dup 14 lit + @  over 14 lit + @  fmul_i  B lit fmul_i  fneg  over 18 lit + @  fadd  over 18 lit + !
  dup 18 lit + @  finv  over 1C lit + !
  dup 0 lit + @  over 10 lit + @  fmul_i  over 20 lit + !
  dup 8 lit + @  over 14 lit + @  fmul_i  B lit fmul_i  fneg  over 20 lit + @  fadd  over 20 lit + !
  dup 20 lit + @  over 1C lit + @  fmul_i  over 20 lit + !
  dup C lit + @  over 14 lit + @  fmul_i  B lit fmul_i  over 24 lit + !
  dup 4 lit + @  over 10 lit + @  fmul_i  fneg  over 24 lit + @  fadd  over 24 lit + !
  dup 24 lit + @  over 1C lit + @  fmul_i  over 24 lit + !
  dup 8 lit + @  over 10 lit + @  fmul_i  over 28 lit + !
  dup 0 lit + @  over 14 lit + @  fmul_i  fneg  over 28 lit + @  fadd  over 28 lit + !
  dup 28 lit + @  over 1C lit + @  fmul_i  over 28 lit + !
  dup 4 lit + @  over 14 lit + @  fmul_i  over 2C lit + !
  dup C lit + @  over 10 lit + @  fmul_i  fneg  over 2C lit + @  fadd  over 2C lit + !
  dup 2C lit + @  over 1C lit + @  fmul_i  over 2C lit + !
  dup 20 lit +  2 lit pick cp4
  2drop drop ;

Test {
bb4_0 {
  10 lit alloc  00000001 lit over !  00000002 lit over 4 lit + !  00000003 lit over 8 lit + !  00000004 lit over C lit + !
  10 lit alloc  00000005 lit over !  00000006 lit over 4 lit + !  00000007 lit over 8 lit + !  00000008 lit over C lit + !
  10 lit alloc
  40 lit alloc
  10 lit alloc  00000006 lit over !  00000008 lit over 4 lit + !  0000000A lit over 8 lit + !  0000000C lit over C lit + !
  10 lit alloc  77FFFFFD lit over !  77FFFFFD lit over 4 lit + !  77FFFFFD lit over 8 lit + !  77FFFFFD lit over C lit + !
  10 lit alloc  00000009 lit over !  00000012 lit over 4 lit + !  0000001B lit over 8 lit + !  00000024 lit over C lit + !
  10 lit alloc  000002A4 lit over !  0000024C lit over 4 lit + !  00000182 lit over 8 lit + !  0000003C lit over C lit + !
  10 lit alloc  5E9EDC21 lit over !  36E04196 lit over 4 lit + !  4528814B lit over 8 lit + !  2692C82A lit over C lit + !
  \ stack: A=8 B=7 R=6 scr=5 eADD=4 eSUB=3 eSMUL=2 eMUL=1 eINV=0
  8 lit pick 8 lit pick 8 lit pick bb4add   6 lit pick 5 lit pick cmp4 1 lit asrt_eq
  8 lit pick 8 lit pick 8 lit pick bb4sub   6 lit pick 4 lit pick cmp4 1 lit asrt_eq
  8 lit pick 00000009 lit 8 lit pick bb4smul     6 lit pick 3 lit pick cmp4 1 lit asrt_eq
  8 lit pick 8 lit pick 8 lit pick 8 lit pick bb4mul  6 lit pick 2 lit pick cmp4 1 lit asrt_eq
  8 lit pick 7 lit pick 7 lit pick bb4inv   6 lit pick 1 lit pick cmp4 1 lit asrt_eq
  1AAAAAAB lit  9 lit finv  asrt_eq
  2drop 2drop 2drop 2drop drop
}
}
