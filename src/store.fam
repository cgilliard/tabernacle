\ ──────────────────────────────────────────────────────────────────────────────
\ src/store.fam — the COW storage engine's COMMON layer: buffer pool -> meta
\ sector + page allocator -> transaction.  The trie / PMMR / bitmap layers sit
\ on top of this.
\
\ Compiled after src/fence.fam + src/disk.fam (uses vread/vwrite/vqwrite/vkick/
\ vpoll/vstat/vwait/vflush).  No fam globals — every singleton lives in a
\ caller-allocated block.  alloc is bump-only, so all RAM is allocated ONCE
\ (eng_init) and reused for the node's whole life.
\
\ Page = 512 B = one disk sector = one I/O request.  Page number == sector
\ number.  (512 B is co-designed with the bitmap leaf + prover cost — don't
\ enlarge.)
\
\ I/O errors are FAIL-STOP: every completion checks vstat == 1 (disk.fam
\ reports device errors as status+1 > 1) and halts with exit 1 on failure —
\ a store that kept running on a failed write could commit a meta that points
\ at garbage.
\
\ POOL HANDLE  `bp`  (0x18 bytes, allocated by bp_init):
\   bp+0x00 ds        pointer to the disk-state block (the disk.fam `ds`)
\   bp+0x04 nframes   frame count (bp_init enforces <= 0x40: bp_flush stages
\                     every dirty frame in ONE batch, and total in-flight
\                     requests must stay under disk.fam's nslots)
\   bp+0x08 hand      CLOCK sweep hand (frame index)
\   bp+0x0C base      pointer to frame 0
\   bp+0x10 hbuckets  page->frame hash index (T buckets of one frame ptr)
\   bp+0x14 hmask     T-1  (T = smallest pow2 >= 2*nframes)
\
\ FRAME  (stride 0x214; data + metadata interleaved so one pointer is both
\ the DMA buffer and the frame handle):
\   frame+0x000 data[0x200]   the 512-B page contents (also the DMA buffer)
\   frame+0x200 page          page#/sector this frame holds (FFFFFFFF = empty)
\   frame+0x204 flags         bit0 dirty, bit1 ref (CLOCK), bit2 filling
\   frame+0x208 pin           pin count (non-evictable while > 0)
\   frame+0x20C slot          disk.fam slot id of the in-flight read (while
\                             filling) or of the staged writeback (bp_flush)
\   frame+0x210 hnext         hash-bucket chain link (0 = end)
\
\ Page-in is NON-BLOCKING: bp_start issues a vread and marks the frame
\ "filling"; bp_ready polls it to completion.  bp_get is the BLOCKING
\ convenience (boot path only) layered on top.
\
\ Known gaps (inherited design notes): concurrent bp_start on the SAME page
\ double-reads into two frames (the caller's descent discipline must not);
\ the all-pinned eviction guard fail-stops rather than waits.
\ ──────────────────────────────────────────────────────────────────────────────

\ ── die1 ( -- )  fail-stop: exit 1 via the SiFive finisher (bye exits 0, which
\ would turn a fatal store bug into a green CI run) ──
: die1
	B7021000 ,   \ lui  t0, 0x100           ( SiFive finisher )
	37330100 ,   \ lui  t1, 0x13
	13033333 ,   \ addi t1, t1, 0x333       ( 0x00013333 = FAIL -> exit 1 )
	23A06200 ,   \ sw   t1, 0(t0)
	6F000000 ,   \ jal  x0, .               ( spin )
;

\ ── vchk ( st -- )  completion verdict: 1 = ok; anything else (2 IOERR,
\ 3 UNSUPP) is a device error -> fail-stop ──
: vchk
	1 lit <> if "io!\n" puts die1 then
;

\ ── vdone ( ds id -- ds )  block until the request completes, fail-stop unless
\ it completed OK ──
: vdone
	vwait vstat vchk
;

\ ── frm ( bp i -- framep )  address of frame i (stride 0x214) ──
: frm
	swap C lit + @ swap 214 lit * +
;

\ ── adv_hand ( bp -- )  hand = (hand + 1) mod nframes ──
: adv_hand
	dup 8 lit + @ 1 lit + over 4 lit + @ % over 8 lit + ! drop
;

\ ── bp_init ( ds nframes -- bp )  allocate the handle + frames + page->frame
\ hash index, mark all empty ──
: bp_init
	dup 40 lit u> if "bp:nfrm\n" puts die1 then   \ see nframes cap in the header
	18 lit alloc                          \ ( ds nframes bp )
	swap over 4 lit + !                   \ bp.nframes = nframes ; ( ds bp )
	swap over !                           \ bp.ds = ds ; ( bp )
	0 lit over 8 lit + !                  \ bp.hand = 0
	dup 4 lit + @ 214 lit * alloc         \ ( bp base )  frame stride 0x214
	over C lit + !                        \ bp.base = base
	\ hash table: T = smallest pow2 >= 2*nframes
	1 lit begin dup 2 lit pick 4 lit + @ 1 lit lshift u< while 1 lit lshift repeat   \ ( bp T )
	dup 1 lit - 2 lit pick 14 lit + !     \ bp.hmask = T-1
	dup 2 lit lshift alloc                \ ( bp T hbuckets )
	2 lit pick 10 lit + !                 \ bp.hbuckets = hbuckets ; ( bp T )
	1 lit pick 10 lit + @                 \ reload hbuckets ; ( bp T hbuckets )
	swap 0 lit do                         \ zero T buckets ; ( bp hbuckets )
		dup i 4 lit * + 0 lit swap !
	loop
	drop                                  \ ( bp )
	dup 4 lit + @ 0 lit do                \ ( bp )  init each frame
		dup i frm                         \ ( bp framep )
		FFFFFFFF lit over 200 lit + !     \ page = empty
		0 lit over 204 lit + !            \ flags = 0
		0 lit over 208 lit + !            \ pin = 0
		0 lit over 20C lit + !            \ slot = 0
		0 lit over 210 lit + !            \ hnext = 0 (not chained)
		drop
	loop
;

\ ── bp_wb ( bp framep -- bp framep )  write the frame back IF dirty; clear
\ dirty.  Blocking + verified (single-frame path: eviction).  Bulk writeback
\ goes through the BATCHED bp_flush instead. ──
: bp_wb
	dup 204 lit + @ 1 lit and if          \ dirty?
		1 lit pick @                      \ ds = bp.ds        ( bp framep ds )
		over 200 lit + @                  \ page (= sector)   ( bp framep ds page )
		2 lit pick                        \ buf = framep      ( bp framep ds page framep )
		vwrite                            \ ( bp framep ds id )
		vdone drop                        \ completed OK (or died) ( bp framep )
		dup 204 lit + dup @ FFFFFFFE lit and swap !   \ clear dirty bit0
	then
;

\ ── h_ins ( bp framep -- )  insert framep at the head of its page's hash
\ bucket (framep.page must already be set) ──
: h_ins
	dup 200 lit + @                       \ ( bp framep page )
	2 lit pick 14 lit + @ and 2 lit lshift \ (page & hmask)*4
	2 lit pick 10 lit + @ +               \ baddr ; ( bp framep baddr )
	dup @ 2 lit pick 210 lit + !          \ framep.hnext = *baddr
	over swap !                           \ *baddr = framep
	2drop
;

\ ── h_rem ( bp framep -- )  unlink framep from its page's hash bucket chain
\ (no-op if page is EMPTY).  Head-case O(1), else walk to the predecessor. ──
: h_rem
	dup 200 lit + @ FFFFFFFF lit = if 2drop else
		over 14 lit + @ over 200 lit + @ and 2 lit lshift 2 lit pick 10 lit + @ +   \ ( bp framep baddr )
		dup @ 2 lit pick = if
			over 210 lit + @ swap !       \ head == framep -> *baddr = framep.hnext
		else
			@                             \ cur = *baddr ; ( bp framep cur )
			begin dup if dup 210 lit + @ 2 lit pick <> else 0 lit then while
				210 lit + @
			repeat
			dup if
				2 lit pick 210 lit + @ swap 210 lit + !   \ cur.hnext = framep.hnext
			else drop then                \ framep not in chain -> no-op (robust)
		then
		2drop
	then
;

\ ── bp_evict ( bp -- bp framep )  CLOCK second-chance: pick an unpinned
\ victim, writing it back if dirty.  Fail-stops if every frame is pinned (a
\ guard the trie's pin discipline must keep from firing). ──
: bp_evict
	0 lit 0 lit                           \ ( bp cnt result )
	begin dup 0= while                    \ loop while no victim chosen yet
		1 lit pick 3 lit pick 4 lit + @ 4 lit * u< invert if "bp:allpin\n" puts die1 then
		2 lit pick dup 8 lit + @ frm      \ ( bp cnt result framep )
		dup 208 lit + @ 0 lit = if        \ pin == 0 ?
			dup 204 lit + @ 2 lit and if  \ ref set -> second chance
				dup 204 lit + dup @ FFFFFFFD lit and swap !   \ clear ref bit1
				drop                      \ ( bp cnt result )
				2 lit pick adv_hand
				swap 1 lit + swap         \ cnt++
			else                          \ pin 0, ref 0 -> SELECT
				nip                       \ result := framep ; ( bp cnt framep )
				2 lit pick adv_hand
			then
		else                              \ pinned -> skip
			drop
			2 lit pick adv_hand
			swap 1 lit + swap             \ cnt++
		then
	repeat                                \ ( bp cnt framep )
	swap drop                             \ ( bp framep )
	bp_wb                                 \ write back if dirty (verified)
	2dup h_rem                            \ unlink victim from its (old) hash bucket
	FFFFFFFF lit over 200 lit + !         \ page = EMPTY (caller sets the new page + h_ins)
;

\ ── bp_probe ( bp page -- bp framep|0 )  O(1) pool hit via the hash index.
\ Walks the page's bucket chain; on a VALID (non-filling) hit, pin it + set
\ ref, return it; else 0. ──
: bp_probe
	over 14 lit + @ over and 2 lit lshift 2 lit pick 10 lit + @ + @   \ cur = *bucket ( bp page cur )
	begin
		dup if                            \ cur != 0 ?
			dup 200 lit + @ 2 lit pick = over 204 lit + @ 4 lit and 0= and 0=   \ NOT a valid hit?
		else 0 lit then                   \ cur == 0 -> stop
	while
		210 lit + @                       \ cur = cur.hnext
	repeat                                \ ( bp page cur )  cur = hit frame or 0
	dup if
		dup 208 lit + dup @ 1 lit + swap !   \ pin++
		dup 204 lit + dup @ 2 lit or swap !  \ ref = 1
	then
	nip                                   \ ( bp framep|0 )  drop page
;

\ ── bp_start ( bp page -- bp framep )  MISS path: evict a frame, point it at
\ page, issue a non-blocking vread into it, mark it filling + pinned.  The
\ frame is NOT valid until bp_ready reports done. ──
: bp_start
	swap bp_evict                         \ ( page bp framep )
	2 lit pick over 200 lit + !           \ frame.page = page
	6 lit over 204 lit + !                \ flags = filling(4)|ref(2)
	1 lit over 208 lit + !                \ pin = 1
	over over h_ins                       \ insert into the page->frame hash index
	1 lit pick @                          \ ds                 ( page bp framep ds )
	3 lit pick                            \ page (= sector)    ( page bp framep ds page )
	2 lit pick                            \ buf = framep       ( ... ds page framep )
	vread                                 \ ( page bp framep ds id )
	2 lit pick 20C lit + !                \ frame.slot = id    ( page bp framep ds )
	drop                                  \ ( page bp framep )
	rot drop                              \ ( bp framep )
;

\ ── bp_ready ( bp framep -- bp framep done? )  pump completions; if this
\ frame's read finished OK, clear filling and report done (a failed read
\ fail-stops).  Already-valid frames report done. ──
: bp_ready
	over @ vpoll drop                     \ vpoll(bp.ds)
	dup 204 lit + @ 4 lit and 0= if       \ not filling -> already valid
		1 lit
	else
		over @ over 20C lit + @ vstat     \ ( bp framep ds st )
		swap drop                         \ ( bp framep st )
		dup 1 lit u> if "io!\n" puts die1 then   \ device error -> fail-stop
		dup if                            \ st == 1: just completed -> clear filling
			over 204 lit + dup @ FFFFFFFB lit and swap !
		then
	then
;

\ ── bp_get ( bp page -- bp framep )  BLOCKING page access (boot path only):
\ hit, or page-in and spin to completion.  Returns a pinned, valid frame. ──
: bp_get
	over over bp_probe                    \ ( bp page bp framep|0 )
	dup if
		nip nip                           \ hit -> ( bp framep )
	else
		drop drop                         \ ( bp page )
		bp_start                          \ ( bp framep )
		begin bp_ready until              \ spin until valid
	then
;

\ ── bp_alloc ( bp page -- bp framep )  fresh page, NO read: evict a frame,
\ claim it for page, mark dirty + pinned + valid.  For COW writes to
\ brand-new pages. ──
: bp_alloc
	swap bp_evict                         \ ( page bp framep )
	2 lit pick over 200 lit + !           \ frame.page = page
	3 lit over 204 lit + !                \ flags = dirty(1)|ref(2)
	1 lit over 208 lit + !                \ pin = 1
	over over h_ins                       \ insert into the page->frame hash index
	rot drop                              \ ( bp framep )
;

\ ── bp_dirty ( framep -- )  mark dirty ──
: bp_dirty
	dup 204 lit + dup @ 1 lit or swap ! drop
;

\ ── bp_unpin ( framep -- )  release one pin ──
: bp_unpin
	dup 208 lit + dup @ 1 lit - swap ! drop
;

\ ── bp_flush ( bp -- bp )  BATCHED writeback: stage every dirty frame with
\ vqwrite (no doorbell), publish the whole batch with ONE vkick, drain, then
\ verify each completion and clear its dirty bit.  One VM exit per commit
\ instead of one per page (the sync path costs ~35 us/page; batched ~2 us).
\ nframes <= 0x40 (bp_init) keeps the batch under disk.fam's nslots.
\ Durability is the caller's vflush (see commit). ──
: bp_flush
	0 lit                                 \ staged count ( bp n )
	over 4 lit + @ 0 lit do
		1 lit pick i frm                  \ ( bp n framep )
		dup 204 lit + @ 1 lit and if      \ dirty?
			2 lit pick @                  \ ds              ( bp n framep ds )
			over 200 lit + @              \ page (= sector) ( bp n framep ds page )
			2 lit pick 1 lit              \ buf, nsec=1     ( .. framep ds page framep 1 )
			vqwrite                       \ stage, NO kick  ( bp n framep ds id )
			2 lit pick 20C lit + !        \ frame.slot = id ( bp n framep ds )
			drop drop                     \ ( bp n )
			1 lit +                       \ n++
		else drop then
	loop
	dup if                                \ anything staged?
		over @ vkick                      \ ONE doorbell for the whole batch ( bp n ds )
		begin                             \ drain: all submitted == all reaped
			vpoll
			dup 8 lit + @ over C lit + @ =
		until
		drop                              \ ( bp n )
		over 4 lit + @ 0 lit do           \ verify + clear each staged frame
			1 lit pick i frm              \ ( bp n framep )
			dup 204 lit + @ 1 lit and if
				2 lit pick @ over 20C lit + @ vstat   \ ( bp n framep ds st )
				vchk drop                 \ st == 1 or die; drop ds ( bp n framep )
				dup 204 lit + dup @ FFFFFFFE lit and swap !   \ clear dirty
			then
			drop
		loop
	then
	drop                                  \ ( bp )
;

\ ── bp_drop ( bp -- bp )  discard every DIRTY (uncommitted COW) frame: mark
\ it empty + unpinned so it is never written back.  Used by rollback — the
\ COW copies a rolled-back txn made are unreferenced garbage the moment we
\ keep the old root. ──
: bp_drop
	dup 4 lit + @ 0 lit do
		dup i frm                         \ ( bp framep )
		dup 204 lit + @ 1 lit and if      \ dirty?
			over over h_rem               \ unlink from hash (uses current page)
			FFFFFFFF lit over 200 lit + ! \ page = empty
			0 lit over 204 lit + !        \ flags = 0
			0 lit over 208 lit + !        \ pin = 0
		then
		drop
	loop
;

\ ══════════════════════════════════════════════════════════════════════════════
\ META SECTOR + ALLOCATOR + the single ENGINE HANDLE that owns all RAM.
\
\ ENGINE HANDLE  `eng`  (0x14 bytes, allocated ONCE by eng_init):
\   eng+0x00 bp       pointer to the buffer pool
\   eng+0x04 wmeta    pointer to the 512-B WORKING meta buffer
\   eng+0x08 cmeta    pointer to the 512-B COMMITTED meta buffer
\   eng+0x0C slot     disk page (0 or 1) holding the currently-committed meta
\   eng+0x10 (reserved: trie descent-path array)
\
\ META SECTOR (512 B, double-buffered across disk pages 0 and 1):
\   +0x000 magic=0x54524945("TRIE")  +0x004 counter  +0x008 trie_root(page#,0=empty)
\   +0x00C next_page(bump hi-water)  +0x010 free_head(GC, later)  +0x1FC checksum
\
\ ALL RAM is allocated by eng_init; mt_boot / mt_save / pg_new touch only those
\ pre-allocated buffers — no per-operation alloc, so nothing leaks.
\ ══════════════════════════════════════════════════════════════════════════════

\ ── mt_z ( buf -- )  zero a 512-B sector buffer ──
: mt_z
	80 lit 0 lit do
		dup i 4 lit * + 0 lit swap !
	loop
	drop
;

\ ── mt_csum ( buf -- sum )  additive sum of the first 127 words (excludes the
\ checksum word at +0x1FC).  HOT-ish (once per commit + boot validation): flat
\ asm, 4 words per iteration; buffer must be word-aligned.  Clobbers
\ t0-t3/a0-a2. ──
: mt_csum
	03250100 ,   \ lw a0,0(sp)
	93050000 ,   \ li a1,0
	1306051F ,   \ addi a2,a0,496
	83220500 ,   \ lw t0,0(a0)
	03234500 ,   \ lw t1,4(a0)
	83238500 ,   \ lw t2,8(a0)
	032EC500 ,   \ lw t3,12(a0)
	B3855500 ,   \ add a1,a1,t0
	B3856500 ,   \ add a1,a1,t1
	B3857500 ,   \ add a1,a1,t2
	B385C501 ,   \ add a1,a1,t3
	13050501 ,   \ addi a0,a0,16
	E36EC5FC ,   \ bltu a0,a2,c
	83220500 ,   \ lw t0,0(a0)
	B3855500 ,   \ add a1,a1,t0
	83224500 ,   \ lw t0,4(a0)
	B3855500 ,   \ add a1,a1,t0
	83228500 ,   \ lw t0,8(a0)
	B3855500 ,   \ add a1,a1,t0
	2320B100 ,   \ sw a1,0(sp)
;

\ ── mt_setck ( buf -- )  store the checksum word ──
: mt_setck
	dup mt_csum over 1FC lit + ! drop
;

\ ── mt_valid ( buf -- flag )  magic correct AND checksum matches ──
: mt_valid
	dup @ 54524945 lit <> if drop 0 lit else
		dup mt_csum swap 1FC lit + @ =
	then
;

\ ── mt_cp ( src dst -- )  copy a whole 512-B sector.  HOT PATH: one call per
\ trie level per COW insert — the fam word-loop cost 27.7 us/copy, 10x the
\ page's batched write; this flat asm (4 words/iteration) is ~1 us.  Both
\ buffers must be word-aligned (alloc'd buffers + pool frames are).
\ Clobbers t0-t3/a0-a2. ──
: mt_cp
	03254100 ,   \ lw a0,4(sp)
	83250100 ,   \ lw a1,0(sp)
	13018100 ,   \ addi sp,sp,8
	13060520 ,   \ addi a2,a0,512
	83220500 ,   \ lw t0,0(a0)
	03234500 ,   \ lw t1,4(a0)
	83238500 ,   \ lw t2,8(a0)
	032EC500 ,   \ lw t3,12(a0)
	23A05500 ,   \ sw t0,0(a1)
	23A26500 ,   \ sw t1,4(a1)
	23A47500 ,   \ sw t2,8(a1)
	23A6C501 ,   \ sw t3,12(a1)
	13050501 ,   \ addi a0,a0,16
	93850501 ,   \ addi a1,a1,16
	E36CC5FC ,   \ bltu a0,a2,10
;

\ ── mt_gen ( buf -- )  fill a buffer with the genesis meta (next_page=2:
\ pages 0,1 are the meta itself) ──
: mt_gen
	dup mt_z
	54524945 lit over !                   \ magic
	0 lit over 4 lit + !                  \ counter = 0
	0 lit over 8 lit + !                  \ trie_root = 0 (empty)
	2 lit over C lit + !                  \ next_page = 2
	0 lit over 10 lit + !                 \ free_head = 0
	mt_setck
;

\ ── mt_rd ( ds page buf -- ) / mt_wr ( ds page buf -- )  blocking, VERIFIED
\ single-sector I/O for the meta (separate from the pool: meta is read before
\ the pool is useful and written as the commit point) ──
: mt_rd  vread  vdone drop ;
: mt_wr  vwrite vdone drop ;

\ ── mt_flush ( ds -- )  durability barrier; no-op (-1) in writethrough mode ──
: mt_flush
	vflush dup FFFFFFFF lit = if 2drop else vdone drop then
;

\ ── eng_init ( ds nframes -- eng )  THE single allocation point: pool (handle
\ + frames + index), the engine handle, and the two meta buffers.  Called once
\ for the node's whole life; everything afterward reuses these. ──
: eng_init
	bp_init                               \ ( bp )  pool handle + frames
	14 lit alloc                          \ ( bp eng )
	swap over !                           \ eng.bp = bp
	200 lit alloc over 4 lit + !          \ eng.wmeta
	200 lit alloc over 8 lit + !          \ eng.cmeta
	0 lit over C lit + !                  \ eng.slot = 0
	0 lit over 10 lit + !                 \ reserved
;

\ ── eng_ds ( eng -- ds )  the disk-state block (eng.bp.ds) ──
: eng_ds  @ @ ;

\ ── wroot@ ( eng -- page ) / wroot! ( eng page -- )  working trie root ──
: wroot@  4 lit + @ 8 lit + @ ;
: wroot!  swap 4 lit + @ 8 lit + ! ;

\ ── mt_boot ( eng -- )  load committed state: read both meta pages, take the
\ valid one with the higher counter; on a fresh disk (neither valid) write
\ genesis.  Then the working meta starts as a copy of the committed meta. ──
: mt_boot
	dup eng_ds 0 lit  2 lit pick 8 lit + @  mt_rd     \ cmeta <- page 0
	dup eng_ds 1 lit  2 lit pick 4 lit + @  mt_rd     \ wmeta <- page 1
	dup 8 lit + @ mt_valid                            \ v0 (cmeta)
	over 4 lit + @ mt_valid                           \ v1 (wmeta)
	swap                                              \ ( eng v1 v0 )
	if                                                \ page 0 valid
		if                                            \ both valid -> higher counter wins
			dup 8 lit + @ 4 lit + @                   \ cmeta.counter
			over 4 lit + @ 4 lit + @                  \ wmeta.counter
			u< if                                     \ cmeta < wmeta -> page 1 wins
				dup 4 lit + @ over 8 lit + @ mt_cp    \ wmeta -> cmeta
				1 lit over C lit + !
			else
				0 lit over C lit + !
			then
		else                                          \ page 0 only
			0 lit over C lit + !
		then
	else                                              \ page 0 invalid ; ( eng v1 )
		if                                            \ page 1 only
			dup 4 lit + @ over 8 lit + @ mt_cp        \ wmeta -> cmeta
			1 lit over C lit + !
		else                                          \ neither -> genesis
			dup 8 lit + @ mt_gen                      \ genesis into cmeta
			dup eng_ds 0 lit  2 lit pick 8 lit + @  mt_wr   \ persist to page 0
			dup eng_ds mt_flush
			0 lit over C lit + !
		then
	then
	dup 8 lit + @ over 4 lit + @ mt_cp                \ cmeta -> wmeta (working = committed)
	drop
;

\ ── mt_save ( eng -- )  commit the working meta: bump counter, checksum,
\ write the OFF slot, flush durable, flip the live slot, and adopt working as
\ committed.  This single sector write + flush is the atomic commit point. ──
: mt_save
	dup 8 lit + @ 4 lit + @ 1 lit +       \ committed counter + 1
	over 4 lit + @ 4 lit + !              \ wmeta.counter = that
	dup 4 lit + @ mt_setck                \ checksum the working meta
	dup C lit + @ 1 lit swap -            \ off = 1 - slot
	over eng_ds swap                      \ ( eng ds off )
	2 lit pick 4 lit + @                  \ wmeta
	mt_wr                                 \ write wmeta to the off page (verified)
	dup eng_ds mt_flush                   \ durable before the flip
	dup C lit + @ 1 lit swap - over C lit + !   \ slot = off (atomic flip)
	dup 4 lit + @ over 8 lit + @ mt_cp    \ wmeta -> cmeta
	drop
;

\ ── pg_new ( eng -- eng page )  bump allocator: hand out the next free page
\ and advance the working hi-water (rollback resets it by restoring the
\ committed meta).  Free-list reuse is a later GC concern. ──
: pg_new
	dup 4 lit + @ C lit + @               \ page = wmeta.next_page
	over 4 lit + @ C lit + @ 1 lit +      \ next + 1
	2 lit pick 4 lit + @ C lit + !        \ wmeta.next_page = next + 1
;

\ ══════════════════════════════════════════════════════════════════════════════
\ TRANSACTION — thin, because the pool and meta do the work.  Single writer,
\ one txn at a time; readers ride the committed snapshot.
\ ══════════════════════════════════════════════════════════════════════════════

\ ── tx_begin ( eng -- )  start a txn: working meta := committed meta ──
: tx_begin
	dup 8 lit + @ over 4 lit + @ mt_cp    \ cmeta -> wmeta
	drop
;

\ ── commit ( eng -- )  flush dirty data pages (ONE batched kick), make them
\ durable, THEN write + flush + flip the meta.  The data-before-meta ordering
\ is the barrier: the meta never points at a page that is not already durable. ──
: commit
	dup @ bp_flush drop                   \ dirty data pages -> disk (batched, verified)
	dup eng_ds mt_flush                   \ data durable
	mt_save                               \ meta off-slot -> flush -> flip
;

\ ── rollback ( eng -- )  abandon the txn: drop the dirty COW frames and
\ restore the working meta (trie_root + next_page) from the committed copy.
\ Touches no disk. ──
: rollback
	dup @ bp_drop drop                    \ discard uncommitted COW frames
	dup 8 lit + @ over 4 lit + @ mt_cp    \ cmeta -> wmeta
	drop
;

\ ──────────────────────────────────────────────────────────────────────────────
\ Tests.  The first group is NO-DEVICE logic (frame mgmt, CLOCK eviction,
\ probe, alloc, meta math): ds=0 and only CLEAN frames are evicted/alloc'd, so
\ vwrite/vread are never reached.  store_rt at the end is the REAL-DEVICE
\ round trip (engine boot -> COW txn -> batched commit -> reboot -> verify);
\ it self-skips via bfind when q32 runs without --disk.
\ ──────────────────────────────────────────────────────────────────────────────
Test {
	\ bp_init lays out the handle + frames, all empty.
	pool_ini {
		0 lit 4 lit bp_init
		dup 4 lit + @ 4 lit asrt_eq                    \ nframes
		dup 8 lit + @ 0 lit asrt_eq                    \ hand
		dup 0 lit frm 200 lit + @ FFFFFFFF lit asrt_eq \ frame0 page empty
		dup 0 lit frm 208 lit + @ 0 lit asrt_eq        \ frame0 pin 0
		0 lit frm 204 lit + @ 0 lit asrt_eq            \ frame0 flags 0
	}
	\ frm computes base + i*0x214.
	frm_mth {
		0 lit 4 lit bp_init
		dup C lit + @ swap 2 lit frm swap 428 lit + asrt_eq   \ frame2 == base + 0x428
	}
	\ probe miss on an empty pool -> 0.
	probe_ms {
		0 lit 4 lit bp_init
		55 lit bp_probe swap drop 0 lit asrt_eq
	}
	\ probe hit: pin++ and the matching frame is returned.
	probe_ht {
		0 lit 4 lit bp_init                            \ ( bp )
		dup 1 lit frm                                  \ ( bp framep )
		55 lit over 200 lit + !                        \ frame1.page = 0x55
		2dup h_ins                                     \ register in the hash index
		drop                                           \ ( bp )
		55 lit bp_probe                                \ ( bp framep )
		over 1 lit frm asrt_eq                         \ returned frame1
		1 lit frm 208 lit + @ 1 lit asrt_eq            \ pin bumped to 1
	}
	\ CLOCK: fresh pool picks frame0 (hand->1); a ref-set frame gets a second chance.
	evict_c {
		0 lit 4 lit bp_init
		bp_evict over 0 lit frm asrt_eq                \ first victim = frame0
		dup 8 lit + @ 1 lit asrt_eq                    \ hand advanced to 1
		dup 1 lit frm 2 lit swap 204 lit + !           \ frame1.flags = ref
		bp_evict over 2 lit frm asrt_eq                \ frame1 skipped -> frame2 chosen
		dup 1 lit frm 204 lit + @ 0 lit asrt_eq        \ frame1 ref cleared
		8 lit + @ 3 lit asrt_eq                        \ hand advanced past both -> 3
	}
	\ bp_alloc claims a fresh page (no read): page set, dirty+ref, pinned.
	alloc_t {
		0 lit 4 lit bp_init
		77 lit bp_alloc over 0 lit frm asrt_eq         \ used frame0
		dup 0 lit frm 200 lit + @ 77 lit asrt_eq       \ page set
		dup 0 lit frm 204 lit + @ 3 lit asrt_eq        \ flags dirty|ref
		0 lit frm 208 lit + @ 1 lit asrt_eq            \ pin 1
	}
	\ bp_dirty sets the dirty bit; bp_unpin drops one pin.
	dirty_t {
		0 lit 4 lit bp_init
		dup 0 lit frm bp_dirty
		dup 0 lit frm 204 lit + @ 1 lit asrt_eq        \ dirty set
		dup 0 lit frm 2 lit swap 208 lit + !           \ pin = 2
		dup 0 lit frm bp_unpin
		0 lit frm 208 lit + @ 1 lit asrt_eq            \ pin 2 -> 1
	}
	\ mt_gen produces a valid genesis meta (magic + next_page=2 + good checksum).
	meta_gen {
		200 lit alloc dup mt_gen
		dup @ 54524945 lit asrt_eq                     \ magic
		dup C lit + @ 2 lit asrt_eq                    \ next_page == 2
		mt_valid assert                                \ checksum valid
	}
	\ tampering any covered word breaks the checksum.
	meta_ck {
		200 lit alloc dup mt_gen
		dup 8 lit + 99 lit swap !                      \ tamper trie_root word
		mt_valid 0 lit asrt_eq                         \ no longer valid
	}
	\ mt_cp copies the full 512-B sector (validity + a field carry over).
	meta_cp {
		200 lit alloc dup mt_gen                       \ ( src )
		200 lit alloc                                  \ ( src dst )
		over over mt_cp
		dup mt_valid assert                            \ ( src dst )  copy is valid
		C lit + @ 2 lit asrt_eq                        \ dst.next_page copied  ( src )
		drop
	}
	\ pg_new hands out the hi-water then bumps it; no allocation per call.
	pgnew_t {
		0 lit 2 lit eng_init                           \ ds=0, no device touched
		dup 4 lit + @ mt_gen                           \ genesis-fill the working meta
		pg_new 2 lit asrt_eq                           \ first page = 2
		pg_new 3 lit asrt_eq                           \ second page = 3
		4 lit + @ C lit + @ 4 lit asrt_eq              \ next_page now 4  (consumes eng)
	}
	\ REAL DEVICE (self-skips without --disk): the full engine round trip.
	\ Boot a fresh disk (genesis persisted), run a COW txn — two new pages
	\ with patterns + root update — commit (exercises the BATCHED bp_flush +
	\ meta flip), then boot a second engine on the same disk and verify the
	\ committed meta AND the page data both survived the trip.
	store_rt {
		bfind ?dup if
			48 lit alloc swap over !                                   \ ( ds )
			D000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !
			vblkinit                                                   \ ( ds )
			8 lit eng_init                                             \ ( eng )
			dup mt_boot                                                \ fresh -> genesis
			dup 8 lit + @ 4 lit + @ 0 lit asrt_eq                      \ committed counter 0
			dup tx_begin
			\ page A: pg_new (=2), fresh COW page, pattern, unpin
			pg_new 2 lit asrt_eq                                       \ ( eng )  page A = 2
			dup @ 2 lit bp_alloc                                       \ ( eng bp framep )
			ABCD1234 lit over !                                        \ data[0] = pattern A
			bp_unpin drop                                              \ ( eng )
			\ page B: pg_new (=3), pattern, unpin
			pg_new 3 lit asrt_eq
			dup @ 3 lit bp_alloc
			5EED5EED lit over !                                        \ data[0] = pattern B
			bp_unpin drop
			dup 2 lit wroot!                                           \ working root = page A
			dup commit                                                 \ batched flush + flip
			dup 8 lit + @ 4 lit + @ 1 lit asrt_eq                      \ committed counter 1
			dup 8 lit + @ 8 lit + @ 2 lit asrt_eq                      \ committed root = 2
			dup C lit + @ 1 lit asrt_eq                                \ live slot flipped to 1
			\ "reboot": second engine on the same disk sees committed state
			dup eng_ds 8 lit eng_init                                  \ ( eng eng2 )
			dup mt_boot
			dup wroot@ 2 lit asrt_eq                                   \ root recovered
			dup 4 lit + @ 4 lit + @ 1 lit asrt_eq                      \ counter recovered
			\ page data survived: read both pages back through the new pool
			dup @ 2 lit bp_get @ ABCD1234 lit asrt_eq drop             \ ( eng eng2 )
			dup @ 3 lit bp_get @ 5EED5EED lit asrt_eq drop
			drop drop
		then
	}
}

\ ──────────────────────────────────────────────────────────────────────────────
\ Benches (scripts/bench.sh runs them with --disk; without one the device
\ benches self-skip via bfind).  sprobe/scopy/scsum are the engine's CPU
\ primitives — scopy and scsum are the flagged asm candidates, benched so the
\ decision stays measured.  scommit is THE number for the DB: a full COW
\ transaction (32 fresh pages, batched flush, two durability barriers, meta
\ flip) per op.  sread1k is the cold page-in path (bp_get miss = one real
\ read per op).
\ ──────────────────────────────────────────────────────────────────────────────

Bench {
	\ hash-index probe HIT: the hot path of every cached node access.
	sprobe {
		0 lit 20 lit bp_init                \ 32-frame pool, fake ds
		dup 7 lit frm                       \ make page 0x55 resident in frame 7
		55 lit over 200 lit + !
		2dup h_ins drop                     \ ( bp )
		bgo
		0 lit begin dup 2710 lit u< while
			over 55 lit bp_probe drop drop
			1 lit +
		repeat drop drop
		2710 lit bops
	}
	\ mt_cp: the 512-B COW node copy (one per trie level per insert).
	scopy {
		200 lit alloc 200 lit alloc         \ ( src dst )
		bgo
		0 lit begin dup 2710 lit u< while
			2 lit pick 2 lit pick mt_cp
			1 lit +
		repeat drop drop drop
		2710 lit bops
	}
	\ mt_csum: the commit-path meta checksum (127 words summed).
	scsum {
		200 lit alloc dup mt_gen            \ ( buf )
		bgo
		0 lit begin dup 2710 lit u< while
			over mt_csum drop
			1 lit +
		repeat drop drop
		2710 lit bops
	}
	\ REAL device: full COW commit — 32 fresh dirty pages per txn, then
	\ commit = batched bp_flush (one kick) + data flush + meta write + flush
	\ + flip.  32 txns; ns/op = one whole commit (flush-barrier dominated).
	scommit {
		bfind ?dup if
			48 lit alloc swap over !
			D000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !
			vblkinit
			28 lit eng_init                 \ 40-frame pool ( eng )
			dup mt_boot
			bgo
			0 lit begin dup 20 lit u< while
				over tx_begin
				0 lit begin dup 20 lit u< while
					2 lit pick pg_new       \ ( eng i j eng page )
					swap @ swap bp_alloc    \ ( eng i j bp framep )
					bp_unpin drop           \ ( eng i j )
					1 lit +
				repeat drop
				over commit
				1 lit +
			repeat drop drop
			20 lit bops                     \ per COMMIT (32 pages each)
		else bskip then
	}
	\ REAL device: 1000 COLD page-ins — every bp_get misses the 40-frame pool
	\ (distinct pages 0x400..), so each op is a real blocking read.
	sread1k {
		bfind ?dup if
			48 lit alloc swap over !
			D000 lit alloc FFF lit + FFFFF000 lit and dup qzero over 4 lit + !
			vblkinit
			28 lit bp_init                  \ ( bp )
			bgo
			0 lit begin dup 3E8 lit u< while
				over over 400 lit + bp_get  \ page = 0x400 + i: always a miss
				bp_unpin drop               \ ( bp i )
				1 lit +
			repeat drop drop
			3E8 lit bops
		else bskip then
	}
}
