\ src/tx.fam — Transactions over WOTS+ + Poseidon2-BabyBear-16. MAGIC=0x534E5854 VERSION=1.
\ amount in-mem = 31-bit limbs [lo,hi]; wire = u64. Canonical order = WORD-lex.
\ Lifecycle: create -> txaddin/txaddout -> txfin (sort+body_hash) -> txsign(t,sk) -> txenc -> txdec -> txvalid.
\ Context t: +00 n_in +04 n_out +08 outs +0C ins +10 sigs +14 bh +18 fld +1C h +20 inpkh +24 vdig +28 vtops.

: cpN  ( src dst n -- )  0 lit do  over i 4 lit * + @  over i 4 lit * + !  loop  2drop ;


: ltn  ( a b n scr -- f )   \ 1 if a<b in word-lex over n words (0 otherwise). scr=1 word
  1 lit over !
  1 lit pick 0 lit do
    1 lit pick 1 lit - i -
    4 lit pick over 4 lit * + @
    4 lit pick 2 lit pick 4 lit * + @
    2dup = if 2drop else
      u< if 0 lit else 2 lit then  2 lit pick !
    then drop
  loop
  dup @ 0 lit = 1 lit and nip nip nip nip ;


: swapN ( a b tmp n -- )
  3 lit pick 2 lit pick 2 lit pick cpN  2 lit pick 4 lit pick 2 lit pick cpN
  1 lit pick 3 lit pick 2 lit pick cpN  2drop 2drop ;

: eqN ( a b n -- f )
  1 lit  1 lit pick 0 lit do  3 lit pick i 4 lit * + @  3 lit pick i 4 lit * + @  = and  loop  nip nip nip ;

: wru64  ( lo hi dst -- )
  2 lit pick  2 lit pick 1 lit and 1F lit lshift  or  over !
  1 lit pick 1 lit rshift  over 4 lit + !  2drop drop ;

: rdu64  ( w0 w1 dst -- )
  2 lit pick 7FFFFFFF lit and  over !
  1 lit pick 1 lit lshift  3 lit pick 1F lit rshift  or  over 4 lit + !  2drop drop ;

: txcommit  ( pkh alo ahi out fld h -- )   \ out = p2hash([pkh(8), alo, ahi])
  5 lit pick 2 lit pick 8 lit cpN
  4 lit pick 2 lit pick 20 lit + !
  3 lit pick 2 lit pick 24 lit + !
  1 lit pick A lit 4 lit pick 3 lit pick p2hash
  2drop 2drop 2drop ;



: txinpkh  ( t -- )   \ compute each input's [pkhash(8), amt] opening into inpkh
  dup @ 0 lit > if
    dup @ 0 lit do
      dup C lit + @ i 868 lit * +   over 20 lit + @ i 28 lit * +   2 lit pick 1C lit + @   wpkhash
      dup C lit + @ i 868 lit * + 860 lit + @   over 20 lit + @ i 28 lit * + 20 lit + !
      dup C lit + @ i 868 lit * + 864 lit + @   over 20 lit + @ i 28 lit * + 24 lit + !
    loop
  then drop ;



: txbody  ( t -- )   \ body_hash -> bh  (requires txinpkh first)
  534E5854 lit  over 18 lit + @ !
  1 lit          over 18 lit + @ 4 lit + !
  dup @          over 18 lit + @ 8 lit + !
  dup 4 lit + @  over 18 lit + @ C lit + !
  dup 4 lit + @ 0 lit > if
    dup 4 lit + @ 0 lit do
      dup 8 lit + @ i 28 lit * +
      over 18 lit + @ 10 lit + i 28 lit * +
      A lit cpN
    loop
  then
  dup @ 0 lit > if
    dup @ 0 lit do
      dup 20 lit + @ i 28 lit * +
      over 18 lit + @ 10 lit + 2 lit pick 4 lit + @ 28 lit * + i 28 lit * +
      A lit cpN
    loop
  then
  dup 18 lit + @  1 lit pick @  2 lit pick 4 lit + @ + A lit * 4 lit +  2 lit pick 14 lit + @  3 lit pick 1C lit + @  p2hash
  drop ;



: txaddin  ( t pk lo hi -- )
  3 lit pick C lit + @  4 lit pick @ 868 lit * +
  3 lit pick over 218 lit cpN  2 lit pick over 860 lit + !  1 lit pick over 864 lit + !
  4 lit pick dup @ 1 lit + swap !  2drop 2drop drop ;

: txaddout  ( t pkh lo hi -- )
  3 lit pick 8 lit + @  4 lit pick 4 lit + @ 28 lit * +
  3 lit pick over 8 lit cpN  2 lit pick over 20 lit + !  1 lit pick over 24 lit + !
  4 lit pick 4 lit + dup @ 1 lit + swap !  2drop 2drop drop ;

: txsort ( t -- )
  dup @ 1 lit > if
    dup @ 1 lit do
      dup @ i - 0 lit do
        dup C lit + @ i 868 lit * +  over C lit + @ i 1 lit + 868 lit * +
        dup 2 lit pick 218 lit 5 lit pick 24 lit + @ ltn
        if 1 lit pick 1 lit pick 4 lit pick 28 lit + @ 21A lit swapN then 2drop
      loop
    loop
  then
  dup 4 lit + @ 1 lit > if
    dup 4 lit + @ 1 lit do
      dup 4 lit + @ i - 0 lit do
        dup 8 lit + @ i 28 lit * +  over 8 lit + @ i 1 lit + 28 lit * +
        dup 2 lit pick A lit 5 lit pick 24 lit + @ ltn
        if 1 lit pick 1 lit pick 4 lit pick 28 lit + @ A lit swapN then 2drop
      loop
    loop
  then  drop ;

: txfin ( t -- )  dup txsort  dup txinpkh  dup txbody  drop ;

: txsign ( t sk -- )   \ derive pubkey from sk -> vtops, find matching input, sign body_hash
  43 lit 0 lit do
    dup i 20 lit * +  2 lit pick 28 lit + @ i 20 lit * +  F lit  4 lit pick 1C lit + @  wchain
  loop
  over @ 0 lit > if
    over @ 0 lit do
      1 lit pick C lit + @ i 868 lit * +  2 lit pick 28 lit + @  218 lit  eqN
      if
        1 lit pick 14 lit + @  1 lit pick  3 lit pick 10 lit + @ i 860 lit * +  4 lit pick 1C lit + @  5 lit pick 24 lit + @  wsign
      then
    loop
  then  2drop ;


: ordck  ( t -- f )   \ canonical (word-lex) strict order: inputs by pubkey, outputs by record
  1 lit
  over @ 1 lit > if
    over @ 1 lit do
      1 lit pick C lit + @ i 1 lit - 868 lit * +
      2 lit pick C lit + @ i 868 lit * +
      218 lit  4 lit pick 28 lit + @  ltn and
    loop
  then
  over 4 lit + @ 1 lit > if
    over 4 lit + @ 1 lit do
      1 lit pick 8 lit + @ i 1 lit - 28 lit * +
      2 lit pick 8 lit + @ i 28 lit * +
      A lit  4 lit pick 28 lit + @  ltn and
    loop
  then nip ;



: txvalid  ( t -- f )   \ canonical order + recompute body_hash + verify each input signature
  dup txinpkh
  dup txbody
  dup ordck
  over @ 0 lit > if
    over @ 0 lit do
      1 lit pick 20 lit + @ i 28 lit * +
      2 lit pick 10 lit + @ i 860 lit * +
      3 lit pick 14 lit + @
      4 lit pick 1C lit + @
      5 lit pick 24 lit + @
      6 lit pick 28 lit + @
      wverify and
    loop
  then nip ;



: txenc  ( t buf -- len )
  534E5854 lit over !
  1 lit over 4 lit + !
  1 lit pick @ over 8 lit + !
  1 lit pick 4 lit + @ over C lit + !
  1 lit pick @ 0 lit > if
    1 lit pick @ 0 lit do
      1 lit pick C lit + @ i 868 lit * +   1 lit pick 10 lit + i 868 lit * +   218 lit cpN
      1 lit pick C lit + @ i 868 lit * + 860 lit + @
      2 lit pick C lit + @ i 868 lit * + 864 lit + @
      2 lit pick 10 lit + i 868 lit * + 860 lit +   wru64
    loop
  then
  1 lit pick 4 lit + @ 0 lit > if
    1 lit pick 4 lit + @ 0 lit do
      1 lit pick 8 lit + @ i 28 lit * +
      1 lit pick 10 lit + 3 lit pick @ 868 lit * + i 28 lit * +   8 lit cpN
      1 lit pick 8 lit + @ i 28 lit * + 20 lit + @
      2 lit pick 8 lit + @ i 28 lit * + 24 lit + @
      2 lit pick 10 lit + 4 lit pick @ 868 lit * + i 28 lit * + 20 lit +   wru64
    loop
  then
  1 lit pick @ 0 lit > if
    1 lit pick @ 0 lit do
      1 lit pick 10 lit + @ i 860 lit * +
      1 lit pick 10 lit + 3 lit pick @ 868 lit * + 3 lit pick 4 lit + @ 28 lit * + i 860 lit * +   218 lit cpN
    loop
  then
  1 lit pick @ 868 lit *  2 lit pick 4 lit + @ 28 lit * +  2 lit pick @ 860 lit * +  10 lit +  nip nip ;

: txdec  ( buf t -- f )
  1 lit pick 8 lit + @ over !
  1 lit pick C lit + @ over 4 lit + !
  dup @ 0 lit > if
    dup @ 0 lit do
      1 lit pick 10 lit + i 868 lit * +   1 lit pick C lit + @ i 868 lit * +   218 lit cpN
      1 lit pick 10 lit + i 868 lit * + 860 lit + @
      2 lit pick 10 lit + i 868 lit * + 864 lit + @
      2 lit pick C lit + @ i 868 lit * + 860 lit +   rdu64
    loop
  then
  dup 4 lit + @ 0 lit > if
    dup 4 lit + @ 0 lit do
      1 lit pick 10 lit + 1 lit pick @ 868 lit * + i 28 lit * +   1 lit pick 8 lit + @ i 28 lit * +   8 lit cpN
      1 lit pick 10 lit + 1 lit pick @ 868 lit * + i 28 lit * + 20 lit + @
      2 lit pick 10 lit + 2 lit pick @ 868 lit * + i 28 lit * + 24 lit + @
      2 lit pick 8 lit + @ i 28 lit * + 20 lit +   rdu64
    loop
  then
  dup @ 0 lit > if
    dup @ 0 lit do
      1 lit pick 10 lit + 1 lit pick @ 868 lit * + 1 lit pick 4 lit + @ 28 lit * + i 860 lit * +
      1 lit pick 10 lit + @ i 860 lit * +   218 lit cpN
    loop
  then
  drop
  dup @ 534E5854 lit =  over 4 lit + @ 1 lit =  and  1 lit and  nip ;


