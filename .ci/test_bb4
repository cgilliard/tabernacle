#!/bin/sh
# BabyBear quartic extension F_p[x]/(x^4 - 11), W=11 (src/bb4.fam): the degree-4
# FRI/challenge field. The bb4_0 test checks add/sub/smul/mul/inverse (tower
# decomposition) + base-field finv against the Python reference (tmp/pos2/bb4ref.py).
# Built on fmul_i (mul-free software multiply), so it runs on rv32i (verifier env).
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- bb4 (rv32i, mul-free): add/sub/smul/mul/inv vs reference ---"
out=$(timeout 120 ./tools/fam --test src/babybear.fam src/bb4.fam 2>&1) \
    || { echo "$out"; echo "FAIL: bb4 tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test bb4_0' || { echo "FAIL: bb4 arithmetic test (bb4_0) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "test_bb4: PASS"
