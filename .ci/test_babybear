#!/bin/sh
# BabyBear field layer: validate the rv32i (mul-free) path on an rv32i core, and the
# rv32im path + the fmul_i ≡ fmul_im cross-check on an rv32im core.
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- 1) babybear.fam field tests on rv32i (verifier target, mul-free) ---"
out=$(./tools/fam --test src/babybear.fam 2>&1) \
    || { echo "$out"; echo "FAIL: rv32i field tests exited non-zero"; exit 1; }
echo "$out"
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no rv32i tests ran (silent compile failure?)"; exit 1; }

echo "--- 2) babybear_im.fam on rv32im + fmul_i ≡ fmul_im cross-check ---"
# babybear_im.fam emits mul/mulhu, so it can only EXECUTE on an M-extension core.
# fam --test runs under q32's default rv32i CPU, so build the test binary by hand
# and run it under q32 with m=true.
MCPU='rv32,m=true,a=false,f=false,d=false,c=false,zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,zcd=false,zcf=false,zcmp=false,zcmt=false,zicsr=false,zifencei=false'
BIN=$(mktemp)
( cat lib/stdlib.fam lib/test.fam src/babybear.fam src/babybear_im.fam; printf '\n_tend\nbye\n\004' ) \
    | ./tools/q32 bin/fam > "$BIN" 2>/dev/null
[ "$(head -c4 "$BIN" | xxd -p)" = "13000000" ] \
    || { echo "FAIL: rv32im test binary did not compile"; rm -f "$BIN"; exit 1; }
out=$(timeout 60 ./tools/q32 --cpu="$MCPU" "$BIN" </dev/null 2>&1) \
    || { echo "$out"; echo "FAIL: rv32im tests exited non-zero (or timed out)"; rm -f "$BIN"; exit 1; }
echo "$out"
echo "$out" | grep -q 'xchk' || { echo "FAIL: fmul_i==fmul_im cross-check did not run"; rm -f "$BIN"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: rv32im suite did not pass"; rm -f "$BIN"; exit 1; }
rm -f "$BIN"

echo "test_babybear: PASS"
