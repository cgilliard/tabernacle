#!/bin/sh
# Full 2-input / 2-output transaction lifecycle over WOTS+ + Poseidon2-BabyBear-16:
# create -> add 2 inputs + 2 outputs -> finalize (sort + body_hash) -> sign both
# -> serialize -> deserialize (fresh context) -> validate. Runs tests/tx_lifecycle.fam
# as a standalone program (compiled against the src modules with their Test{} blocks
# stripped, i.e. the same code path as the production build). Passes iff the signed
# tx validates (valid1=1) AND the round-tripped tx validates (valid2=1).
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
# strip Test{} blocks (the standalone program defines no Test framework)
for f in babybear poseidon2 wotsp tx; do
    sed '/^Test {/,$d' "src/$f.fam" > "$WORK/$f.fam"
done

run_one() {
    cpu="$1"; label="$2"
    ./tools/fam -o "$WORK/life.bin" \
        "$WORK/babybear.fam" "$WORK/poseidon2.fam" "$WORK/wotsp.fam" "$WORK/tx.fam" tests/tx_lifecycle.fam \
        2>/dev/null
    [ "$(head -c4 "$WORK/life.bin" | xxd -p)" = "13000000" ] \
        || { echo "FAIL ($label): lifecycle program did not compile"; exit 1; }
    out=$(timeout 90 ./tools/q32 --cpu="$cpu" "$WORK/life.bin" </dev/null 2>&1) \
        || { echo "$out"; echo "FAIL ($label): lifecycle run exited non-zero (or timed out)"; exit 1; }
    echo "[$label] $out"
    echo "$out" | grep -q 'valid1=00000001' \
        || { echo "FAIL ($label): signed tx did not validate (valid1)"; exit 1; }
    echo "$out" | grep -q 'valid2=00000001' \
        || { echo "FAIL ($label): deserialized tx did not validate (valid2)"; exit 1; }
}

ICPU='rv32,m=false,a=false,f=false,d=false,c=false,zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,zcd=false,zcf=false,zcmp=false,zcmt=false,zicsr=false,zifencei=false'
MCPU='rv32,m=true,a=false,f=false,d=false,c=false,zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,zcd=false,zcf=false,zcmp=false,zcmt=false,zicsr=false,zifencei=false'

echo "--- 1) lifecycle on rv32i (mul-free verifier path) ---"
run_one "$ICPU" rv32i
echo "--- 2) lifecycle on rv32im (prover env) ---"
run_one "$MCPU" rv32im

echo "test_tx_lifecycle: PASS"
