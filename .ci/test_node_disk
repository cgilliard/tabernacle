#!/bin/sh

set -e
# q32 runs qemu with `-serial stdio`, so qemu's stdin becomes the guest serial
# line. Run from an interactive terminal, that stdin is a tty and the --disk
# (virtio-blk) test hangs at startup until the 60s timeout fires -- but CI has
# no tty on stdin, so it passes there. Detach stdin so local == CI.
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
build_fam

echo "--- 1) node_disk.fam unit tests (no device, pure logic) ---"
out=$(./tools/fam --test src/node_disk.fam 2>&1) || { echo "$out"; echo "FAIL: unit tests exited non-zero"; exit 1; }
echo "$out"
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no unit tests ran (silent compile failure?)"; exit 1; }

echo "--- 2) node_disk REAL virtio-blk device test (--disk) ---"
DISK=$(mktemp)
dd if=/dev/zero of="$DISK" bs=512 count=8 2>/dev/null   # fresh, zeroed
# timeout guards against a handshake regression that would hang the poll loop.
out=$(timeout 60 ./tools/fam --test --disk="$DISK" src/node_disk.fam tests/node_disk_dev.fam 2>&1) \
    || { echo "$out"; echo "FAIL: device test exited non-zero (or timed out)"; rm -f "$DISK"; exit 1; }
echo "$out"
echo "$out" | grep -q 'realwr' || { echo "FAIL: realwr device test did not run"; rm -f "$DISK"; exit 1; }

echo "--- verify the bytes actually landed on disk (sector 0 == 0..255 ramp) ---"
python3 - "$DISK" <<'PY' || { echo "FAIL: on-disk bytes do not match what the test wrote"; rm -f "$DISK"; exit 1; }
import sys
disk = open(sys.argv[1], "rb").read(512)
exp  = bytes(i & 0xFF for i in range(512))
if disk != exp:
    print("  disk[0:16]  :", disk[:16].hex())
    print("  expect[0:16]:", exp[:16].hex())
    sys.exit(1)
print("  sector 0 matches the written ramp (512 B)")
PY
rm -f "$DISK"

echo "test_node_disk: PASS"
