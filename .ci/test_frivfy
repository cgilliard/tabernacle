#!/bin/sh
# Radix-8 FRI verify loop (src/frivfy.fam): the STARK FRI verifier — per query,
# open each round's coset (p2hash leaf -> mrkroot Merkle check), check fold
# consistency, radix-8 fold (frifold), and a final-codeword check; transcript
# (Fiat-Shamir) derives the betas + query positions. The fv_e2e test runs a full
# proof generated by the Python prover+verifier reference (tmp/pos2/frivfyref.py,
# itself self-consistent), asserting the honest proof is ACCEPTED (flag=1) and a
# tampered eval is REJECTED (flag=0). Built on bb4/frifold/transcript/merkle/
# p2hash (all mul-free), so it runs on rv32i (the verifier env).
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- frivfy (rv32i): full FRI verify accept honest + reject tampered vs reference ---"
out=$(timeout 180 ./tools/fam --test src/babybear.fam src/poseidon2.fam src/wotsp.fam src/bb4.fam src/frifold.fam src/transcript.fam src/merkle.fam src/frivfy.fam 2>&1) \
    || { echo "$out"; echo "FAIL: frivfy tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test fv_e2e' || { echo "FAIL: FRI verify test (fv_e2e) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "test_frivfy: PASS"
