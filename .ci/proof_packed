#!/bin/sh
# Compositional proof of the SHIPPED self-extracting bin/fam. A static CFG-walk
# can't verify a packed binary (its real code is decompressed at runtime), so we
# prove: (1) the decompressor stub is clean RV32I, and (2) the LZ77 payload
# decompresses to an image that passes P1/P2/P3 and is byte-identical to the
# proven bin/fam.uncompressed.
set -e
. "$(dirname "$0")/_common.sh"
setup_qemu
build_fam
python3 tools/verify_packed.py bin/fam --reference bin/fam.uncompressed
