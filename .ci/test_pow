#!/bin/sh
# Memory-hard proof-of-work hash (src/pow.fam): Poseidon2-BabyBear seed + walk.
# powhash recomputes a block header's PoW hash = p2hash(header), then 32x a cheap
# BabyBear field-add walk { j=(r&7); idx=(w[j]+acc)&mask; w[j]+=table[idx];
# acc+=w[j] } over the pre-expanded bible table (single-word entries), threading
# one depth-32 dependent chain. No Poseidon2 in the loop, no finalization hash.
# The pow0 test checks it against the Python reference (tmp/pos2/powref.py). All
# field ops, so it runs on rv32i (the verifier env). (Difficulty/target compare —
# a field-add fold of all 8 words — is a separate header-layer concern.)
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- pow (rv32i): memory-hard hash (Poseidon2, 32 rounds) vs reference ---"
out=$(timeout 120 ./tools/fam --test src/babybear.fam src/poseidon2.fam src/wotsp.fam src/pow.fam 2>&1) \
    || { echo "$out"; echo "FAIL: pow tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test pow0' || { echo "FAIL: PoW hash test (pow0) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "test_pow: PASS"
