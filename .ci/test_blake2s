#!/bin/sh
# BLAKE2s (src/blake2s.fam): RFC 7693, fully unrolled, single-block (inlen <= 64).
# Off-circuit use only — builds the PoW lookup table fast on rv32i (Poseidon2's
# software field-mul is too slow for a multi-Mhash expand). NOT consensus-trusted:
# the table is anchored by its committed root, so blake2s is a fast deterministic
# expander. Generated by tmp/pos2/blake2sgen.py and self-checked vs hashlib.blake2s;
# the b2_* tests pin the fam output to those same KATs (empty / 1 / 8 / 16 words).
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- blake2s (rv32i): RFC 7693 single-block KAT vs hashlib.blake2s ---"
out=$(timeout 120 ./tools/fam --test src/blake2s.fam 2>&1) \
    || { echo "$out"; echo "FAIL: blake2s tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test b2_empty' || { echo "FAIL: blake2s KAT (b2_empty) did not run"; exit 1; }
echo "$out" | grep -q 'test b2_full'  || { echo "FAIL: blake2s KAT (b2_full) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "test_blake2s: PASS"
