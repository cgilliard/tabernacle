#!/bin/sh

set -e
# Same PTY/tty lesson as test_node_disk: never inherit the caller's terminal.
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
build_fam

echo "--- net.fam primitive logic tests (no device, pure logic) ---"
# net.fam uses fence_io (from src/fence.fam), so prepend it.
out=$(./tools/fam --test src/fence.fam src/net.fam 2>&1) || { echo "$out"; echo "FAIL: net tests exited non-zero"; exit 1; }
echo "$out"
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no net tests ran (silent compile failure?)"; exit 1; }

echo "test_net: PASS"
