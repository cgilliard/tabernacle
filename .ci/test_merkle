#!/bin/sh
# Binary Merkle path verification over Poseidon2-BabyBear-16 (src/merkle.fam):
# walk a leaf + n sibling digests + index up to a root via compress2, with the
# pmmr.rs dir-bit convention (0=left child, 1=right child). The mrk0 test checks
# mrkroot against a Python reference (tmp/pos2/mref.py), confirms mrkvrfy accepts
# the good path, and confirms a tampered sibling is rejected. merkle.fam is built
# on pos2_i / wcompr2 (mul-free), so it runs on rv32i (the verifier env).
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- merkle (rv32i, mul-free): mrkroot vs reference + mrkvrfy accept/reject ---"
out=$(timeout 150 ./tools/fam --test src/babybear.fam src/poseidon2.fam src/wotsp.fam src/merkle.fam 2>&1) \
    || { echo "$out"; echo "FAIL: merkle tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test mrk0' || { echo "FAIL: merkle path-verify test (mrk0) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "test_merkle: PASS"
