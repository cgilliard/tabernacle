#!/bin/sh
# WOTS+ one-time signatures over Poseidon2-BabyBear-16: keygen / sign / verify
# round-trip plus tamper rejection, validated against the BabyBear reference
# (tmp/pos2/wref.py). wotsp is built on pos2_i (mul-free), so it runs on the
# rv32i verifier path; step 2 confirms it also runs in the rv32im prover env.
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- 1) wotsp (rv32i, mul-free): compress/chain/digits + keygen + sign/verify + tamper ---"
out=$(./tools/fam --test src/babybear.fam src/poseidon2.fam src/wotsp.fam 2>&1) \
    || { echo "$out"; echo "FAIL: rv32i wotsp tests exited non-zero"; exit 1; }
echo "$out"
echo "$out" | grep -q 'wsg' || { echo "FAIL: sign/verify round-trip (wsg) did not run"; exit 1; }
echo "$out" | grep -q 'wsn' || { echo "FAIL: tamper-rejection (wsn) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "--- 2) wotsp under rv32im (prover env; pos2_i is still mul-free there) ---"
MCPU='rv32,m=true,a=false,f=false,d=false,c=false,zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,zcd=false,zcf=false,zcmp=false,zcmt=false,zicsr=false,zifencei=false'
BIN=$(mktemp)
( cat lib/stdlib.fam lib/test.fam src/babybear.fam src/babybear_im.fam src/poseidon2.fam src/poseidon2_im.fam src/wotsp.fam; printf '\n_tend\nbye\n\004' ) \
    | ./tools/q32 bin/fam > "$BIN" 2>/dev/null
[ "$(head -c4 "$BIN" | xxd -p)" = "13000000" ] \
    || { echo "FAIL: rv32im wotsp binary did not compile"; rm -f "$BIN"; exit 1; }
out=$(timeout 120 ./tools/q32 --cpu="$MCPU" "$BIN" </dev/null 2>&1) \
    || { echo "$out"; echo "FAIL: rv32im wotsp tests exited non-zero (or timed out)"; rm -f "$BIN"; exit 1; }
echo "$out"
echo "$out" | grep -q 'wsg' || { echo "FAIL: rv32im round-trip (wsg) did not run"; rm -f "$BIN"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: rv32im suite did not pass"; rm -f "$BIN"; exit 1; }
rm -f "$BIN"

echo "test_wotsp: PASS"
