#!/bin/sh
# Tabernacle safety, the part that is machine-checked today:
#   P1/P2  (FSM: no jalr / closed CFG, with the declared end_marker handoff exit)
#   P5a    (every handoff to the payload is dominated by a hash gate)
#   P5b    (each such gate is the full 32-byte gimli_hash vs sealed-hash_data
#           compare against [gp-32,gp) -- not a truncated/wrong-buffer check)
#   packed (the SHIPPED bin/tabernacle: clean stub + payload decompresses to the
#           P1/P2/P5a-verified image, byte-identical to bin/tabernacle.uncompressed)
#   L1/L2  (two-anchor region confinement: 219/226 stores confined; 7-store
#           documented residual, regression-gated below)
#   P3     (W^X: 223/226 provably avoid the code image; 3 inspected non-code)
#   P4     (CFI: root provenance + RID-stack discipline; gated at 0)
#   D1     (DMA-target confinement: descriptor addrs -> rxbuf/txframe/diskctl;
#           1 inspected residual = disk read-dest = payload)
#   D2     (quiesce: no device kick between a hash gate and the handoff)
# What remains inspected: the gimli_hash routine itself computes Gimli-Hash of the
# payload and writes its 32-byte digest to [sp,sp+32) (the hash function, not the
# gate placement); see doc/TABERNACLE_SAFETY.md.
set -e
. "$(dirname "$0")/_common.sh"
setup_qemu
build_fam
python3 tools/verify_fsm.py     --handoff bin/tabernacle.uncompressed
python3 tools/verify_handoff.py           bin/tabernacle.uncompressed
python3 tools/verify_packed.py  --handoff bin/tabernacle --reference bin/tabernacle.uncompressed

# bin_size-invariance guard: the proof must not depend on full_node's size (the
# config words at gp-36/gp-40 are unreached data; bin_size is read at runtime).
# Patch bin_size to ~10 MiB and assert every proof result is identical -- a future
# code change that made the loader bin_size-dependent would break this.
python3 - <<'PY'
import subprocess, sys
src = open('bin/tabernacle.uncompressed','rb').read()
data = bytearray(src); data[len(data)-36:len(data)-32] = (0x00A00000).to_bytes(4,'little')
open('/tmp/tab_binsize.bin','wb').write(data)
def run(*a): return subprocess.run(a, capture_output=True, text=True).returncode
base = (run('python3','tools/verify_fsm.py','--handoff','bin/tabernacle.uncompressed'),
        run('python3','tools/verify_handoff.py','bin/tabernacle.uncompressed'))
big  = (run('python3','tools/verify_fsm.py','--handoff','/tmp/tab_binsize.bin'),
        run('python3','tools/verify_handoff.py','/tmp/tab_binsize.bin'))
assert base == big == (0,0), f"bin_size-invariance FAILED: base={base} big={big}"
ndiff = sum(a!=b for a,b in zip(src, bytes(data)))
assert ndiff <= 4, f"patch changed {ndiff} bytes (expected only the config word)"
print(f"bin_size-invariance: OK (proofs identical at 904 B and 10 MiB; {ndiff} config bytes differ)")
PY

# L1/L2 region confinement (regression-gated).  L1 (per-anchor disjoint layout)
# must hold; L2 confines 219/226 stores.  The 7-store residual is documented and
# SOUND (remaining precision limits: the irregular config-parser cursor, a
# runtime-seq bitmap bit, a runtime-offset payload copy, and gimli padding whose
# length lower bound is unknown -- see doc/TABERNACLE_SAFETY.md).  Gate on the
# count not REGRESSING.
python3 - <<'PY'
import sys; sys.path.insert(0, 'tools')
import verify_region as vr
data = open('bin/tabernacle.uncompressed', 'rb').read()
l1_ok, l1_msg = vr.assert_L1(vr.TABERNACLE_MODEL)
assert l1_ok, f"L1 FAILED: {l1_msg}"
r = vr.analyze(data, vr.TABERNACLE_MODEL)
nflag, nconf = len(r["flags"]), r["nstores"] - len(r["flags"])
BUDGET = 7
assert nflag <= BUDGET, f"L2 REGRESSION: {nflag} stores unconfined (budget {BUDGET})"
print(f"region L1/L2: OK (L1 per-anchor disjoint; L2 {nconf}/{r['nstores']} confined, "
      f"{nflag} documented residual <= budget {BUDGET})")

# P3 (W^X): no store writes the code image [code_lo, gp).  Weaker than L2, so
# more stores pass.  The residual (TOP-base computed addresses) is inspected
# non-code in doc/TABERNACLE_SAFETY.md; gate the count against regression.
WX_BUDGET = 3
nwx = len(r["wx_flags"])
assert nwx <= WX_BUDGET, f"W^X REGRESSION: {nwx} stores not provably non-code (budget {WX_BUDGET})"
print(f"P3 W^X: OK ({r['nstores']-nwx}/{r['nstores']} provably avoid code image, "
      f"{nwx} inspected non-code <= budget {WX_BUDGET}; no trampolines)")

# P4 (CFI): root provenance (gp/s7/s9/s10 region-relative, never input) + RID-stack
# discipline (s10 +/-4, every push s10>=s9-guarded, every RID a compile-time const).
# GATING at zero -- this is a clean, closeable result.
c = vr.analyze_cfi(data, vr.TABERNACLE_MODEL)
assert not c["p4a"], f"P4a FAILED: {c['p4a']}"
assert not c["p4b"], f"P4b FAILED: {c['p4b']}"
print(f"P4 CFI: OK (P4a {c['nroot']} root writes region-relative; "
      f"P4b {c['npush']} RID pushes all guarded with constant ids)")

# D1 (DMA-target confinement): every virtqueue descriptor addr field points into
# an allowed DMA target (rxbuf/txframe/diskctl/payload), so the device can DMA
# only there -- never code or tabernacle's state.  The 1 residual is the disk
# read-dest descriptor (a2 = gp+runtime-offset -> TOP, = the payload buffer by
# inspection, non-code).  Gate against regression.
DMA_BUDGET = 1
nd = len(r["dma_flags"])
assert nd <= DMA_BUDGET, f"D1 REGRESSION: {nd} descriptor addrs unconfined (budget {DMA_BUDGET})"
print(f"D1 DMA: OK (descriptor addrs confined to rxbuf/txframe/diskctl; "
      f"{nd} inspected residual <= budget {DMA_BUDGET} = disk read-dest = payload)")

# D2 (quiesce / TOCTOU): no device kick (QueueNotify) lies between a hash gate
# and the payload handoff.  With P5a (gate dominates handoff) and D1 (the device
# can DMA only into rxbuf/txframe/diskctl/payload), this proves nothing the device
# was told to do can modify the payload after it was hashed.  GATING at zero.
q = vr.verify_quiesce(data, vr.TABERNACLE_MODEL)
assert q["ok"], f"D2 FAILED: device kick in a gate->handoff window: {q['bad']}"
print(f"D2 quiesce: OK ({len(q['kicks'])} device kicks, none in either "
      f"gate->handoff window; payload stable from hash to handoff)")
PY
