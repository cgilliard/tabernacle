#!/bin/sh
# Transactions over WOTS+ + Poseidon2-BabyBear-16: build a 1-in/1-out tx,
# compute body_hash + output commitment (checked against the BabyBear reference
# tmp/pos2/tref.py), sign it, validate() it, and confirm a tampered signature is
# rejected. tx.fam is built on pos2_i (mul-free), so it runs on rv32i; step 2
# confirms it also runs in the rv32im prover env.
set -e
exec </dev/null
. "$(dirname "$0")/_common.sh"
setup_qemu
[ -f bin/fam ] || build_fam

echo "--- 1) tx (rv32i, mul-free): body_hash + commitment + sign/validate + tamper ---"
out=$(timeout 150 ./tools/fam --test src/babybear.fam src/poseidon2.fam src/wotsp.fam src/tx.fam 2>&1) \
    || { echo "$out"; echo "FAIL: rv32i tx tests exited non-zero (or timed out)"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test tx1' || { echo "FAIL: tx build/sign/validate test (tx1) did not run"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: no tests ran (silent compile failure?)"; exit 1; }

echo "--- 2) tx under rv32im (prover env; pos2_i is still mul-free there) ---"
MCPU='rv32,m=true,a=false,f=false,d=false,c=false,zawrs=false,zfa=false,zfh=false,zfhmin=false,zcb=false,zcd=false,zcf=false,zcmp=false,zcmt=false,zicsr=false,zifencei=false'
BIN=$(mktemp)
( cat lib/stdlib.fam lib/test.fam src/babybear.fam src/babybear_im.fam src/poseidon2.fam src/poseidon2_im.fam src/wotsp.fam src/tx.fam; printf '\n_tend\nbye\n\004' ) \
    | ./tools/q32 bin/fam > "$BIN" 2>/dev/null
[ "$(head -c4 "$BIN" | xxd -p)" = "13000000" ] \
    || { echo "FAIL: rv32im tx binary did not compile"; rm -f "$BIN"; exit 1; }
out=$(timeout 180 ./tools/q32 --cpu="$MCPU" "$BIN" </dev/null 2>&1) \
    || { echo "$out"; echo "FAIL: rv32im tx tests exited non-zero (or timed out)"; rm -f "$BIN"; exit 1; }
echo "$out"
echo "$out" | grep -q 'test tx1' || { echo "FAIL: rv32im tx1 did not run"; rm -f "$BIN"; exit 1; }
echo "$out" | grep -qE '[1-9][0-9]* passed' || { echo "FAIL: rv32im suite did not pass"; rm -f "$BIN"; exit 1; }
rm -f "$BIN"

echo "test_tx: PASS"
