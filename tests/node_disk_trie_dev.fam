\ ──────────────────────────────────────────────────────────────────────────────
\ tests/node_disk_trie_dev.fam — REAL virtio-blk tests of the COW trie
\ (src/node_disk_trie.fam): single-bucket round trip and a bucket split + multi-level
\ descent, on 32-byte keys / 32-byte values.  Run with a disk attached:
\   ./tools/fam --test --disk=scratch.img src/fence.fam src/disk.fam \
\       src/node_disk_store.fam src/node_disk_trie.fam tests/node_disk_trie_dev.fam
\ Keys/values are 32-byte buffers distinguished only by word 0 (the rest stays the
\ fresh-alloc zero); tput/tget take a small int for brevity.  Uses meta pages 0/1
\ (zeroed first for genesis) and the trie's own pages; safe on the shared disk.
\ ──────────────────────────────────────────────────────────────────────────────

\ dsinit ( ds -- ds )  zero cursors, page-align + zero qb, find + handshake the dev.
: dsinit
0 lit over 8 lit + !
0 lit over C lit + !
0 lit over 10 lit + !
5000 lit alloc FFF lit + FFFFF000 lit and over 4 lit + !
dup 4 lit + @ qzero
find_blk over !
vblkinit
;

\ reusable test buffers + the engine handle under test
: _kbuf variable ;
: _vbuf variable ;
: _obuf variable ;
: _eng  variable ;

: tbuf  20 lit alloc _kbuf !  20 lit alloc _vbuf !  20 lit alloc _obuf ! ;
: tput  ( K V -- )    _vbuf @ !  _kbuf @ !  _eng @ _kbuf @ _vbuf @ tr_put ;
: tget  ( K -- V|0 )  _kbuf @ !  0 lit _obuf @ !
        _eng @ _kbuf @ _obuf @ tr_get if _obuf @ @ else 0 lit then ;

\ zmeta ( ds -- ds )  zero meta pages 0/1 so the engine boots from genesis.
: zmeta
200 lit alloc dup mt_z
over 0 lit 2 lit pick mt_wr
over 1 lit 2 lit pick mt_wr
drop
;

\ async-fiber test plumbing: a fiber context + key/value buffers (two sets so we can
\ run two lookups concurrently).
: _lk  variable ;
: _akb variable ;
: _avb variable ;
: _lkb variable ;
: _kbb variable ;
: _vbb variable ;
: abuf   28 lit alloc _lk !   20 lit alloc _akb !  20 lit alloc _avb ! ;
: abuf2  28 lit alloc _lkb !  20 lit alloc _kbb !  20 lit alloc _vbb ! ;

\ afind ( eng K -- found val )  async lookup of key K, driven to completion through
\ the fiber state machine (real disk reads via lk_step/lk_run).
: afind
_akb @ !  0 lit _avb @ !
_lk @ swap _akb @ _avb @ 0 lit lk_start
_lk @ lk_run
_lk @ 1C lit + @  _avb @ @
;

\ drv2 ( lkA lkB -- )  drive two fibers INTERLEAVED (one step each per pass) until
\ both report done — the concurrent-scheduler pattern in miniature.
: drv2
begin
  over lk_step nip
  over lk_step nip
  and
until
2drop
;

Test {
\ Single bucket: put/update/get within a txn, commit, then a FRESH engine over the
\ same disk reads the committed entries back (proves the COW writes are durable).
trie_rt {
40 lit alloc dsinit zmeta             \ ( ds )
10 lit eng_init                       \ ( eng )  16-frame pool
dup mt_boot dup trie_ini dup _eng !
tbuf
AAAA lit tget 0 lit asrt_eq           \ empty trie -> miss
dup tx_begin
11 lit 111 lit tput
22 lit 222 lit tput
33 lit 333 lit tput
11 lit tget 111 lit asrt_eq
22 lit tget 222 lit asrt_eq
33 lit tget 333 lit asrt_eq
22 lit 999 lit tput                    \ update an existing key
22 lit tget 999 lit asrt_eq
44 lit tget 0 lit asrt_eq             \ missing key
dup commit
\ reboot with a fresh pool over the same disk
eng_ds 10 lit eng_init
dup mt_boot dup trie_ini dup _eng !
11 lit tget 111 lit asrt_eq
22 lit tget 999 lit asrt_eq
33 lit tget 333 lit asrt_eq
44 lit tget 0 lit asrt_eq
drop
}
\ Bucket split + multi-level descent: insert past CAP (7) to split the root bucket
\ into an internal node, confirm every key is findable via descent, update one through
\ the internal node, then reboot.
trie_spl {
40 lit alloc dsinit zmeta
10 lit eng_init
dup mt_boot dup trie_ini dup _eng !
tbuf
dup tx_begin
1 lit 10 lit tput
2 lit 20 lit tput
3 lit 30 lit tput
4 lit 40 lit tput
5 lit 50 lit tput
6 lit 60 lit tput
7 lit 70 lit tput                      \ root bucket now full (CAP=7)
8 lit 80 lit tput                      \ 8th key -> root bucket SPLITS
1 lit tget 10 lit asrt_eq             \ all still findable (now via descent)
4 lit tget 40 lit asrt_eq
8 lit tget 80 lit asrt_eq
2 lit tget 20 lit asrt_eq
3 lit 99 lit tput                      \ update through the internal node (COW the path)
3 lit tget 99 lit asrt_eq
9 lit tget 0 lit asrt_eq              \ never-inserted key -> miss
dup commit
eng_ds 10 lit eng_init
dup mt_boot dup trie_ini dup _eng !
1 lit tget 10 lit asrt_eq
5 lit tget 50 lit asrt_eq
8 lit tget 80 lit asrt_eq
3 lit tget 99 lit asrt_eq
drop
}
\ Async single-fiber round trip: commit keys, reboot to a FRESH pool (so every lookup
\ misses cache and goes through the DESCEND->WAIT->PROCESS state machine, hitting the
\ real disk), then look up via the non-blocking fiber and check results.
async_rt {
40 lit alloc dsinit zmeta
10 lit eng_init dup mt_boot dup trie_ini dup _eng !
tbuf abuf
dup tx_begin
11 lit 111 lit tput  22 lit 222 lit tput  33 lit 333 lit tput
dup commit
eng_ds 10 lit eng_init dup mt_boot dup trie_ini dup _eng !   \ fresh pool
dup 22 lit afind 222 lit asrt_eq assert     \ found 22 -> 222 via the async path
dup 11 lit afind 111 lit asrt_eq assert
dup 33 lit afind 333 lit asrt_eq assert
44 lit afind drop 0 lit asrt_eq             \ miss returns not-found (consumes eng)
}
\ Two fibers driven INTERLEAVED over the same engine, on different disk slots (0 and 1),
\ both reaching the right values -- proves independent lookups overlap correctly.
async_2 {
40 lit alloc dsinit zmeta
10 lit eng_init dup mt_boot dup trie_ini dup _eng !
tbuf abuf abuf2
dup tx_begin
11 lit 111 lit tput  22 lit 222 lit tput  33 lit 333 lit tput
dup commit
eng_ds 10 lit eng_init dup mt_boot dup trie_ini dup _eng !   \ ( eng ) fresh pool
11 lit _akb @ !  0 lit _avb @ !
_lk @ over _akb @ _avb @ 0 lit lk_start     \ fiber A: key 11, slot 0
33 lit _kbb @ !  0 lit _vbb @ !
_lkb @ over _kbb @ _vbb @ 1 lit lk_start    \ fiber B: key 33, slot 1
drop
_lk @ _lkb @ drv2                           \ run both interleaved to completion
_avb @ @ 111 lit asrt_eq                    \ A found 111
_vbb @ @ 333 lit asrt_eq                    \ B found 333
_lk @ 1C lit + @ assert                     \ A reported found
_lkb @ 1C lit + @ assert                    \ B reported found
}
}
