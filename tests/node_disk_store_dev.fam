\ ──────────────────────────────────────────────────────────────────────────────
\ tests/node_disk_store_dev.fam — REAL virtio-blk test of the buffer pool
\ (src/node_disk_store.fam §5): a 1-frame eviction round-trip that exercises the
\ actual disk-touching paths (bp_alloc -> dirty writeback on evict -> bp_get
\ page-in via bp_start/bp_ready).  Run with a disk attached:
\   ./tools/fam --test --disk=scratch.img src/fence.fam src/disk.fam \
\               src/node_disk_store.fam tests/node_disk_store_dev.fam
\ With no --disk, find_blk prints "no blk" and halts.  Uses raw pages 0x20/0x21 and
\ only checks the sentinel it writes itself, so it needs no genesis/meta setup and
\ is safe on the shared scratch disk.
\ ──────────────────────────────────────────────────────────────────────────────

\ dsinit ( ds -- ds )  zero cursors, page-align + zero qb, find + handshake the dev.
: dsinit
0 lit over 8 lit + !                       \ subd = 0
0 lit over C lit + !                       \ usd  = 0
0 lit over 10 lit + !                      \ next = 0
C000 lit alloc FFF lit + FFFFF000 lit and over 4 lit + !   \ qb (page-aligned)
dup 4 lit + @ qzero
find_blk over !                            \ dev
vblkinit
;

Test {
\ One frame, so any new page forces an eviction.  Stamp a sentinel into page 0x20,
\ unpin; fetching 0x21 must write 0x20 back to disk (dirty) before reading 0x21 in;
\ fetching 0x20 again must read it back from disk with the sentinel intact -- proving
\ the writeback + page-in went all the way to the device.
evict_rt {
4C lit alloc dsinit                  \ ( ds )
1 lit bp_init                        \ ( bp )  single-frame pool
20 lit bp_alloc                      \ ( bp framep )  fresh page 0x20 (dirty, pinned)
DEADBEEF lit over !                  \ framep.data[0] = sentinel
bp_unpin                             \ ( bp )
21 lit bp_get                        \ ( bp framep )  MISS: writes 0x20 back, reads 0x21
dup 200 lit + @ 21 lit asrt_eq       \ frame now holds 0x21
bp_unpin                             \ ( bp )
20 lit bp_get                        \ ( bp framep )  MISS: reads 0x20 back from disk
dup 200 lit + @ 20 lit asrt_eq       \ frame holds 0x20
dup @ DEADBEEF lit asrt_eq           \ sentinel survived the disk round trip
bp_unpin                             \ ( bp )
drop
}
\ Meta sector full cycle on the real device: genesis (zeroed meta pages) -> commit
\ (slot flips 0->1, counter 0->1, trie_root + bumped next_page persisted) -> reboot
\ recovers the higher-counter slot from disk -> a 2nd commit flips slot 1->0 ->
\ a torn commit (live slot zeroed) makes boot fall back to the older valid slot.
mt_cycle {
4C lit alloc dsinit                  \ ( ds )
200 lit alloc dup mt_z               \ ( ds zbuf )
over 0 lit 2 lit pick mt_wr          \ zero meta page 0 (force genesis)
over 1 lit 2 lit pick mt_wr          \ zero meta page 1
drop                                 \ ( ds )
4 lit eng_init                       \ ( eng )  ds + 4-frame pool
dup mt_boot                          \ neither slot valid -> genesis
dup 4 lit + @ 4 lit + @ 0 lit asrt_eq      \ counter == 0
dup 4 lit + @ C lit + @ 2 lit asrt_eq      \ next_page == 2
dup C lit + @ 0 lit asrt_eq                \ committed slot == 0
\ --- modify working state and commit ---
pg_new 2 lit asrt_eq                       \ pg_new hands out page 2 (next_page->3)
2A lit over 4 lit + @ 8 lit + !            \ wmeta.trie_root = 0x2A
dup mt_save                                 \ commit
dup C lit + @ 1 lit asrt_eq                \ slot flipped to 1
dup 8 lit + @ 4 lit + @ 1 lit asrt_eq      \ committed counter == 1
\ --- reboot: re-read committed meta from disk ---
dup mt_boot
dup C lit + @ 1 lit asrt_eq                \ recovered the higher-counter slot (1)
dup 4 lit + @ 8 lit + @ 2A lit asrt_eq      \ trie_root persisted
dup 4 lit + @ C lit + @ 3 lit asrt_eq       \ next_page persisted (bumped to 3)
\ --- second commit flips back to slot 0 ---
dup mt_save
dup C lit + @ 0 lit asrt_eq                \ slot flipped back to 0
dup 8 lit + @ 4 lit + @ 2 lit asrt_eq      \ counter == 2
\ --- torn commit: corrupt the live slot (page 0); boot falls back to slot 1 ---
200 lit alloc dup mt_z                     \ ( eng zbuf )
over eng_ds 0 lit 2 lit pick mt_wr         \ zero page 0 -> fails checksum
drop                                        \ ( eng )
dup mt_boot
dup C lit + @ 1 lit asrt_eq                \ fell back to slot 1
4 lit + @ 4 lit + @ 1 lit asrt_eq          \ counter == 1 (older valid slot)
}
\ Transaction commit + persistence: in a txn, allocate a page through the pool, stamp
\ a sentinel, record it as the trie_root, and commit.  A SEPARATE engine with a FRESH
\ pool over the same disk then boots the committed meta and reads that page back from
\ disk -- proving the whole txn (data pages + meta flip) is durable.
tx_rt {
4C lit alloc dsinit
200 lit alloc dup mt_z
over 0 lit 2 lit pick mt_wr
over 1 lit 2 lit pick mt_wr
drop                                 \ ( ds )
4 lit eng_init                       \ ( eng )
dup mt_boot                          \ genesis
dup tx_begin
pg_new                               \ ( eng page )
1 lit pick @ over bp_alloc           \ ( eng page bp framep )  bp_alloc(eng.bp, page)
CAFEF00D lit over !                  \ sentinel into the fresh page
bp_unpin drop                        \ ( eng page )
over swap wroot!                     \ record page as trie_root ; ( eng )
dup commit
\ fresh engine + pool over the same disk reads the committed page back
dup eng_ds 4 lit eng_init            \ ( eng eng2 )
dup mt_boot
dup wroot@                           \ ( eng eng2 page )
over @ swap bp_get                   \ ( eng eng2 bp framep )  bp_get(eng2.bp, page)
dup @ CAFEF00D lit asrt_eq           \ sentinel survived commit + reboot via disk
bp_unpin drop drop drop              \ ( )
}
\ Transaction rollback: a txn bumps next_page and sets a bogus root, then rolls back;
\ the committed working state (root + next_page) must be exactly restored, touching
\ no disk.
tx_rb {
4C lit alloc dsinit
200 lit alloc dup mt_z
over 0 lit 2 lit pick mt_wr
over 1 lit 2 lit pick mt_wr
drop
4 lit eng_init                       \ ( eng )
dup mt_boot                          \ genesis: root=0, next_page=2
dup tx_begin
dup pg_new 2drop                     \ bump working next_page to 3
dup 55 lit wroot!                    \ bogus working root
dup rollback                         \ discard the txn
dup wroot@ 0 lit asrt_eq             \ root restored to committed (0)
4 lit + @ C lit + @ 2 lit asrt_eq    \ next_page restored to 2  (consumes eng)
}
}
