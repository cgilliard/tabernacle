40u lit 2u lit rshift u. NL                    \ 16

\ ---- stack ops ----
5u lit dup + u. SP                             \ dup -> 10
1u lit 2u lit drop u. SP                       \ drop -> 1
1u lit 2u lit swap - u. SP                     \ swap -> 1
