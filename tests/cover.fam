variable                                       \ ( -- a )
dup 7B lit swap !   dup @   u.x SP             \ 0000007B
dup FF lit swap c!  dup c@  u.x SP             \ 000000FF
dup BEEF lit swap h! dup h@ u.x NL             \ 0000BEEF
drop

